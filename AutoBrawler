local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace") 
local LocalPlayer = Players.LocalPlayer
local RemoteFunc = game:GetService("ReplicatedStorage"):WaitForChild("RemoteFunction")

local LATERAL_OFFSET = 3.5
local MAX_SHRINK_STEPS = 3
local LOOP_DELAY = 0.01

local function BrawlerBuildPath()
    local folder = Workspace.Map and Workspace.Map:FindFirstChild("Paths")
    folder = folder and folder:FindFirstChild("1")
    if not folder then return nil end
    local points = {}
    local i = 1
    while true do
        local part = folder:FindFirstChild(tostring(i))
        if not part then break end
        points[i] = part.Position
        i = i + 1
    end
    return points
end

local PATH_POINTS = BrawlerBuildPath()
local ROAD_PARTS = Workspace.Map and Workspace.Map:FindFirstChild("Road") and Workspace.Map.Road:GetChildren() or {}

local SEGMENTS = {}
if PATH_POINTS and #PATH_POINTS >= 2 then
    local cum = 0
    for i = 1, #PATH_POINTS - 1 do
        local a, b = PATH_POINTS[i], PATH_POINTS[i+1]
        local seg = b - a
        local len = seg.Magnitude
        SEGMENTS[i] = {
            start = a,
            dir = seg.Unit,
            len = len,
            cumStart = cum,
            cumEnd = cum + len
        }
        cum = cum + len
    end
end

local function ClosestOnPath(pos)
    if not SEGMENTS or #SEGMENTS == 0 then return nil, nil, 0 end
    local bestPoint, bestDir, bestProgress
    local bestDist = math.huge
    for _, seg in ipairs(SEGMENTS) do
        local rel = pos - seg.start
        local t = math.clamp(rel:Dot(seg.dir), 0, seg.len)
        local point = seg.start + seg.dir * t
        local dist = (point - pos).Magnitude
        if dist < bestDist then
            bestDist = dist
            bestPoint = point
            bestDir = seg.dir
            bestProgress = seg.cumStart + t
        end
    end
    return bestPoint, bestDir, bestProgress
end

local function PathProgress(pos)
    local _, _, progress = ClosestOnPath(pos)
    return progress or 0
end

local function IsOnRoad(point)
    for _, part in ipairs(ROAD_PARTS) do
        local rel = part.CFrame:PointToObjectSpace(point)
        local half = part.Size / 2
        if math.abs(rel.X) <= half.X and math.abs(rel.Z) <= half.Z then
            return true
        end
    end
    return false
end

local function GetLeadEnemy()
    local npcs = Workspace:FindFirstChild("NPCs")
    if not npcs then return nil end
    local bestModel, bestProgress = nil, -math.huge
    for _, npc in ipairs(npcs:GetChildren()) do
        if npc:IsA("Model") then
            local ok, pivot = pcall(npc.GetPivot, npc)
            if ok then
                local pos = pivot.Position
                if pos.Magnitude > 1 then
                    local progress = PathProgress(pos)
                    if progress > bestProgress then
                        bestProgress = progress
                        bestModel = npc
                    end
                end
            end
        end
    end
    return bestModel
end

local running = false
local thread = nil

local function start()
    if running then return end
    running = true
    thread = task.spawn(function()
        print("[AutoBrawler] Started")
        while running do
            if not SEGMENTS or #SEGMENTS == 0 then
                local newPoints = BrawlerBuildPath()
                if newPoints and #newPoints >= 2 then
                    PATH_POINTS = newPoints
                    SEGMENTS = {}
                    local cum = 0
                    for i = 1, #PATH_POINTS - 1 do
                        local a, b = PATH_POINTS[i], PATH_POINTS[i+1]
                        local seg = b - a
                        local len = seg.Magnitude
                        SEGMENTS[i] = {
                            start = a,
                            dir = seg.Unit,
                            len = len,
                            cumStart = cum,
                            cumEnd = cum + len
                        }
                        cum = cum + len
                    end
                    ROAD_PARTS = Workspace.Map and Workspace.Map:FindFirstChild("Road") and Workspace.Map.Road:GetChildren() or {}
                else
                    task.wait(1)
                    continue
                end
            end

            local enemy = GetLeadEnemy()
            if enemy then
                local ok, pivot = pcall(enemy.GetPivot, enemy)
                if ok then
                    local center, dir = ClosestOnPath(pivot.Position)
                    if center then
                        local right = Vector3.new(-dir.Z, 0, dir.X)
                        local enemyOnGround = Vector3.new(pivot.Position.X, center.Y, pivot.Position.Z)

                        local towers = Workspace:FindFirstChild("Towers")
                        if towers then
                            for _, tower in ipairs(towers:GetChildren()) do
                                local replicator = tower:FindFirstChild("TowerReplicator")
                                if replicator then
                                    local name = replicator:GetAttribute("Name")
                                    local ownerId = replicator:GetAttribute("OwnerId")
                                    local upgrade = replicator:GetAttribute("Upgrade") or 0

                                    if name == "Brawler" and ownerId == LocalPlayer.UserId and upgrade >= 4 then
                                        local side = (math.random(0, 1) == 0) and -1 or 1
                                        local offsetDist = LATERAL_OFFSET
                                        local targetPos = enemyOnGround + right * (side * offsetDist)

                                        for _ = 1, MAX_SHRINK_STEPS do
                                            if IsOnRoad(targetPos) then break end
                                            offsetDist = offsetDist * 0.5
                                            targetPos = enemyOnGround + right * (side * offsetDist)
                                        end
                                        if not IsOnRoad(targetPos) then
                                            targetPos = enemyOnGround
                                        end

                                        pcall(function()
                                            RemoteFunc:InvokeServer("Troops", "Abilities", "Activate", {
                                                Troop = tower,
                                                Name = "Reposition",
                                                Data = { position = targetPos },
                                            })
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
            end

            task.wait(LOOP_DELAY)
        end
        running = false
        print("[AutoBrawler] Stopped")
    end)
end

local function stop()
    running = false
    if thread then
        task.cancel(thread)
        thread = nil
    end
end

return {
    Start = start,
    Stop = stop,
    IsRunning = function() return running end
}
