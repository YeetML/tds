------------------------------------------------------------
-- SAFE NETWORK RESOLVE
------------------------------------------------------------
local function waitForChildSafe(parent, name, timeout)
    timeout = timeout or 1e9
    local deadline = os.clock() + timeout
    local child = parent:FindFirstChild(name)
    while not child and os.clock() < deadline do
        task.wait(0.25)
        child = parent:FindFirstChild(name)
    end
    return child
end

local NetworkFolder = waitForChildSafe(ReplicatedStorage, "Network")
if not NetworkFolder then
    warn("[AutoGatlingGun] Network folder never appeared")
    return
end

local Net = waitForChildSafe(NetworkFolder, "GatlingGun")
if not Net then
    warn("[AutoGatlingGun] GatlingGun remote folder never appeared")
    return
end

local RE_Fire   = waitForChildSafe(Net, "RE:Fire")
local RE_Reload = waitForChildSafe(Net, "RE:Reload")
local RE_Hit    = waitForChildSafe(Net, "RE:Hit")

if not (RE_Fire and RE_Reload and RE_Hit) then
    warn("[AutoGatlingGun] One or more GatlingGun remotes missing – aborting")
    return
end

local RemoteFunc = ReplicatedStorage:WaitForChild("RemoteFunction")

