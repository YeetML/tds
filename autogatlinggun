if getgenv().Gatling and getgenv().Gatling.StopWatching then
    pcall(getgenv().Gatling.StopWatching)
end

getgenv().Gatling = Gatling

print("[Gatling] Loaded. Lead-only check (no Shield), 150ms spawn grace, elites supported, FPS pinned, low-quality ESP, idle reload 2s.")
