------------------------------------------------------------
-- FIRE (per-tower)
------------------------------------------------------------
local function fireAt(st, pos, extraTime)
    local sync = workspace:GetAttribute("Sync") or 0
    local now  = workspace:GetServerTimeNow()
    RE_Fire:FireServer(
        pos,
        sync + CFG.SyncOffset,
        now + CFG.TimestampOffset + (extraTime or 0)
    )
    st.ShotCount += 1
    st.LastActualShot = os.clock()
end

------------------------------------------------------------
-- PER-TOWER TICK
------------------------------------------------------------
local FRAME_BUDGET = 1 / CFG.FireRate

local function tickTower(st)
    local tower, rep = st.Tower, st.Rep
    if not (tower and tower.Parent and rep and rep.Parent) then
        return false   -- tower gone, caller removes it
    end

    local ammo      = rep:GetAttribute("Ammo") or 0
    local maxAmmo   = rep:GetAttribute("MaxAmmo") or ammo
    local reloading = rep:GetAttribute("Reloading") == true

    if CFG.AutoReload and ammo == 0 and not reloading then
        RE_Reload:FireServer()
        return true
    end
    if ammo <= 0 then return true end

    local now = os.clock()
    if now - st.LastFireTime < FRAME_BUDGET then return true end

    local targets = pickTargets()
    if #targets == 0 then
        if CFG.AutoReload and not reloading
           and ammo < maxAmmo
           and (now - st.LastActualShot) >= CFG.IdleReloadDelay then
            RE_Reload:FireServer()
        end
        return true
    end

    if st.CurrentIndex > #targets then st.CurrentIndex = 1 end
    local current = targets[st.CurrentIndex]

    if not isAlive(current.Model) or not current.Model.Parent or hasLead(current.Model) then
        st.CurrentIndex += 1
        st.LastFireTime = now
        return true
    end

    if CFG.AutoFire then
        local damage = getEffectiveDamage(rep)

        local budgets, totalRemaining = {}, 0
        for i, t in ipairs(targets) do
            local tRep = getReplicator(t.Model)
            local hp = tRep and tRep:GetAttribute("Health") or 0
            if type(hp) ~= "number" or hp < 0 then hp = 0 end
            local need = math.max(1, math.ceil(hp / damage) + CFG.BudgetSafety)
            budgets[i] = need
            totalRemaining = totalRemaining + need
        end

        local shotsThisTick = 0
        local idx = st.CurrentIndex
        while shotsThisTick < CFG.BatchSize and totalRemaining > 0 do
            local t = targets[idx]
            if not t then break end
            if budgets[idx] > 0
               and isAlive(t.Model)
               and not hasLead(t.Model)
               and t.Model.Parent then
                local stepTime = shotsThisTick * CFG.BatchStep
                fireAt(st, t.Pos, stepTime)
                shotsThisTick += 1
                budgets[idx] -= 1
                totalRemaining -= 1
            end
            idx += 1
            if idx > #targets then idx = 1 end
        end
        st.CurrentIndex = idx
    end

    st.LastFireTime = now
    return true
end

local function heartbeatTick()
    if not S.Running then return end
    for tower, st in pairs(S.Towers) do
        if not tickTower(st) then
            S.Towers[tower] = nil
        end
    end
end

------------------------------------------------------------
-- FPS ENFORCEMENT (per-tower)
------------------------------------------------------------
local FPSLastFire = setmetatable({}, {__mode = "k"})

local function enforceFPS(tower, rep)
    if not CFG.ForceFPS then return end
    if rep:GetAttribute("FPS") == true then return end
    local now = os.clock()
    if now - (FPSLastFire[tower] or 0) < CFG.FPSRecheck then return end
    FPSLastFire[tower] = now
    pcall(function()
        RemoteFunc:InvokeServer("Troops", "Abilities", "Activate", {
            Troop = tower, Name = "FPS", Data = { enabled = true },
        })
    end)
end

------------------------------------------------------------
-- GAME-SIDE HITSOUND SUPPRESSOR (unchanged, idempotent)
------------------------------------------------------------
do
    if not getgenv()._AGG_SoundMute then
        getgenv()._AGG_SoundMute = true

        local banned = tostring(CFG.HitsoundId):match("(%d+)") or "74643671307263"
        local hooked = setmetatable({}, {__mode = "k"})

        local function matchSound(s)
            return s:IsA("Sound")
               and tostring(s.SoundId ~= "" and s.SoundId or ""):find(banned, 1, true)
        end

        local function silence(s)
            if not matchSound(s) then return end
            pcall(function()
                s.Volume  = 0
                s.Playing = false
            end)
        end

        local function watchSound(s)
            if not s:IsA("Sound") then return end
            silence(s)
            if hooked[s] then return end
            hooked[s] = true
            s:GetPropertyChangedSignal("SoundId"):Connect(function() silence(s) end)
            s:GetPropertyChangedSignal("Playing"):Connect(function()
                if s.Playing then silence(s) end
            end)
            s:GetPropertyChangedSignal("Volume"):Connect(function()
                if s.Volume > 0 then silence(s) end
            end)
        end

        local function hookRoot(root)
            if not root then return end
            for _, c in ipairs(root:GetDescendants()) do
                if c:IsA("Sound") then watchSound(c) end
            end
            root.DescendantAdded:Connect(watchSound)
        end

        hookRoot(SoundService)
        hookRoot(workspace)
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then hookRoot(pg) end
        LP.ChildAdded:Connect(function(c)
            if c.Name == "PlayerGui" then hookRoot(c) end
        end)

        RunService.Heartbeat:Connect(function()
            for _, s in ipairs(SoundService:GetChildren()) do
                if s:IsA("Sound") and matchSound(s) and s.Volume > 0 then
                    silence(s)
                end
            end
        end)
    end
end

------------------------------------------------------------
-- STATE MANAGEMENT
------------------------------------------------------------
local function ensureState(tower, rep)
    local st = S.Towers[tower]
    if not st then
        st = {
            Tower          = tower,
            Rep            = rep,
            ShotCount      = 0,
            LastFireTime   = 0,
            LastActualShot = os.clock(),
            CurrentIndex   = 1,
        }
        S.Towers[tower] = st
    else
        st.Rep = rep
    end
    return st
end

------------------------------------------------------------
-- PUBLIC API
------------------------------------------------------------
local AutoGatlingGun = {}
AutoGatlingGun.CFG = CFG

function AutoGatlingGun.Start()
    if S.Running then
        -- pick up any newly-placed towers while running
        for _, t in ipairs(findTowers()) do
            ensureState(t.Tower, t.Rep)
            enforceFPS(t.Tower, t.Rep)
        end
        return false
    end

    S.Towers = {}
    for _, t in ipairs(findTowers()) do
        ensureState(t.Tower, t.Rep)
        enforceFPS(t.Tower, t.Rep)
    end

    if next(S.Towers) == nil then return false end

    S.Running = true
    S.Heartbeat = RunService.Heartbeat:Connect(heartbeatTick)
    log("started", "towers=" .. tostring(#findTowers()))
    return true
end

function AutoGatlingGun.Stop()
    if not S.Running then return false end
    S.Running = false
    if S.Heartbeat then S.Heartbeat:Disconnect() S.Heartbeat = nil end
    for _, conn in pairs(HealthHooks) do conn:Disconnect() end
    HealthHooks = {}
    log("stopped")
    return true
end

function AutoGatlingGun.IsRunning() return S.Running end
function AutoGatlingGun.GetShots()
    local total = 0
    for _, st in pairs(S.Towers) do total += st.ShotCount end
    return total
end

function AutoGatlingGun.StopWatching()
    if S.Running then AutoGatlingGun.Stop() end
end

function AutoGatlingGun._cleanup()
    if S._watchConn then S._watchConn:Disconnect() S._watchConn = nil end
    if S.Heartbeat then S.Heartbeat:Disconnect() S.Heartbeat = nil end
    S.Running = false
    S.Towers = {}
    for _, conn in pairs(HealthHooks) do conn:Disconnect() end
    HealthHooks = {}
end

------------------------------------------------------------
-- WATCHER — always keeps all owned Gatling Guns tracked
------------------------------------------------------------
S._watchConn = RunService.Heartbeat:Connect(function()
    local userWants = true
    local settings = _G and _G.AutoProgSettings
    if settings and settings.AutoGatlingGun ~= nil then
        userWants = settings.AutoGatlingGun == true
    end

    if not userWants then
        if S.Running then AutoGatlingGun.Stop() end
        return
    end

    local live = findTowers()
    if #live == 0 then
        if S.Running then AutoGatlingGun.Stop() end
        return
    end

    -- register every owned Gatling Gun and keep FPS forced on each
    for _, t in ipairs(live) do
        local st = ensureState(t.Tower, t.Rep)
        enforceFPS(t.Tower, t.Rep)
        if st.LastFireTime == 0 then st.LastActualShot = os.clock() end
    end

    -- drop state for towers that got sold/destroyed
    for tower in pairs(S.Towers) do
        if not tower.Parent then S.Towers[tower] = nil end
    end

    if not S.Running then
        AutoGatlingGun.Start()
    end
end)

------------------------------------------------------------
-- BOOTSTRAP
------------------------------------------------------------
do
    local old = getgenv().AutoGatlingGun
    if old then
        if old._watchConn then pcall(function() old._watchConn:Disconnect() end) end
        if old._cleanup   then pcall(old._cleanup) end
    end
end

AutoGatlingGun._watchConn = S._watchConn
getgenv().AutoGatlingGun = AutoGatlingGun

print("[AutoGatlingGun] Loaded. Multi-tower, watcher toggle-aware, game-side hitsound suppressed.")
