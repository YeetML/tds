----------------------------------------------------------------
-- TowerReplicator DJ finder (any skin)
----------------------------------------------------------------
local function isDJRep(rep)
    if not rep then return false end
    local name = rep:GetAttribute("Name")
    if type(name) ~= "string" then return false end
    name = string.lower(name)
    return name == "dj booth" or name == "djbooth"
end

local function getOwnerId(rep)
    local id = rep:GetAttribute("OwnerId")
    return tonumber(id) or id
end

local function forEachDJ(callback)
    local folder = Workspace:FindFirstChild("Towers")
    if not folder then return end
    for _, tower in ipairs(folder:GetChildren()) do
        local rep = tower:FindFirstChild("TowerReplicator")
        if isDJRep(rep) then
            callback(tower, rep)
        end
    end
end

local function FindOwnDJ()
    local found = nil
    forEachDJ(function(tower, rep)
        if getOwnerId(rep) == PlayerUserId then
            found = tower
        end
    end)
    return found
end

local function getDJAudioPlayer(tower)
    local hrp = tower:FindFirstChild("HumanoidRootPart")
    local ap = hrp and hrp:FindFirstChild("AudioPlayer")
    if ap then return ap end
    for _, d in ipairs(tower:GetDescendants()) do
        if d:IsA("AudioPlayer") or d.ClassName == "AudioPlayer" then
            return d
        end
    end
    return nil
end

local function muteAudioIn(tower)
    for _, d in ipairs(tower:GetDescendants()) do
        if d:IsA("AudioPlayer") or d.ClassName == "AudioPlayer" then
            pcall(function()
                d:Stop()
                d.Volume = 0
                d:Destroy()
            end)
        elseif d:IsA("Sound") then
            pcall(function()
                d:Stop()
                d.Volume = 0
                d:Destroy()
            end)
        end
    end
end

local function MuteOtherDJsOnce()
    forEachDJ(function(tower, rep)
        if getOwnerId(rep) == PlayerUserId then return end
        muteAudioIn(tower)
    end)
end

----------------------------------------------------------------
-- Songs (your DJ only)
----------------------------------------------------------------
local function pickSongId()
    local custom = Globals and Globals.DJCustomSongID
    if custom ~= nil then
        local cleaned = tostring(custom):gsub("%D", "")
        if cleaned ~= "" then
            return cleaned
        end
    end
    return tostring(RandomSongIDs[math.random(1, #RandomSongIDs)])
end

local function SetSong(tower, songId)
    local audioPlayer = getDJAudioPlayer(tower)
    if not audioPlayer then return false end
    local fullId = "rbxassetid://" .. tostring(songId)
    local success = pcall(function()
        audioPlayer.AssetId = fullId
        audioPlayer:Play()
    end)
    if success then
        print("[AutoDJ] Now playing: " .. tostring(songId))
    end
    return success
end

local function PlayNext()
    if AutoDJ._stopFlag then return end

    local tower = FindOwnDJ()
    if not tower then
        task.wait(1)
        PlayNext()
        return
    end

    local songId = pickSongId()
    if not SetSong(tower, songId) then
        task.wait(1)
        PlayNext()
        return
    end

    local audioPlayer = getDJAudioPlayer(tower)
    if audioPlayer then
        local endedConn
        endedConn = audioPlayer.Ended:Connect(function()
            if endedConn then endedConn:Disconnect() end
            if not AutoDJ._stopFlag then
                PlayNext()
            end
        end)

        task.wait(180)
        if endedConn and endedConn.Connected then
            endedConn:Disconnect()
            if not AutoDJ._stopFlag then
                PlayNext()
            end
        end
    end
end

local function RunLoop()
    AutoDJ._running = true
    AutoDJ._stopFlag = false
    while AutoDJ._running and not AutoDJ._stopFlag do
        PlayNext()
        while AutoDJ._running and not AutoDJ._stopFlag do
            task.wait(1)
        end
    end
    AutoDJ._running = false
end

----------------------------------------------------------------
-- Public API
----------------------------------------------------------------
function AutoDJ.Start()
    if AutoDJ._running then
        print("[AutoDJ] Already running.")
        return
    end
    AutoDJ._stopFlag = false
    if AutoDJ._thread then
        pcall(task.cancel, AutoDJ._thread)
        AutoDJ._thread = nil
    end
    AutoDJ._thread = task.spawn(RunLoop)
    print("[AutoDJ] Started.")
end

function AutoDJ.Stop()
    if not AutoDJ._running then
        print("[AutoDJ] Not running.")
        return
    end
    AutoDJ._stopFlag = true
    AutoDJ._running = false
    if AutoDJ._thread then
        pcall(task.cancel, AutoDJ._thread)
        AutoDJ._thread = nil
    end
    print("[AutoDJ] Stopped.")
end

function AutoDJ.Toggle()
    if AutoDJ._running then
        AutoDJ.Stop()
    else
        AutoDJ.Start()
    end
end

function AutoDJ.IsRunning()
    return AutoDJ._running
end

function AutoDJ.StartMuteOthers()
    if AutoDJ._muteThread then return end
    AutoDJ._muteThread = task.spawn(function()
        while true do
            if Globals.MuteOtherDJs then
                MuteOtherDJsOnce()
            end
            task.wait(0.25)
        end
    end)
    print("[AutoDJ] Mute others loop started.")
end

function AutoDJ.MuteOthersOnce()
    MuteOtherDJsOnce()
end

return AutoDJ
