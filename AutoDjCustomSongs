local AutoDJ = {
    _running = false,
    _thread = nil,
    _stopFlag = false,
}

-- Internal: find the player's own DJ Booth tower
local function FindOwnDJ()
    local towersFolder = Workspace:FindFirstChild("Towers")
    if not towersFolder then return nil end

    local towerNames = {
        "Default", "Neon Rave", "Neko", "Ghost", "Plushie",
        "Masquerade", "Mako", "Garage Band", "Ducky", "Seal",
        "Gingerbread"
    }

    for _, name in ipairs(towerNames) do
        local tower = towersFolder:FindFirstChild(name)
        if tower then
            local owner = tower:FindFirstChild("Owner")
            if owner and owner.Value == PlayerUserId then
                return tower
            end
        end
    end
    return nil
end

-- Internal: set a random song on a given tower
local function SetRandomSong(tower)
    local hrp = tower:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local audioPlayer = hrp:FindFirstChild("AudioPlayer")
    if not audioPlayer then return false end

    local randomId = RandomSongIDs[math.random(#RandomSongIDs)]
    local fullId = "rbxassetid://" .. randomId

    local success = pcall(function()
        audioPlayer.AssetId = fullId
        audioPlayer:Play()
    end)

    if success then
        print("[AutoDJ] Now playing: " .. randomId)
        return true
    end
    return false
end

-- Internal: play the next song and wait for it to finish
local function PlayNext()
    if AutoDJ._stopFlag then return end

    local tower = FindOwnDJ()
    if not tower then
        -- No DJ tower, wait and retry
        task.wait(1)
        PlayNext()
        return
    end

    if not SetRandomSong(tower) then
        task.wait(1)
        PlayNext()
        return
    end

    local hrp = tower:FindFirstChild("HumanoidRootPart")
    local audioPlayer = hrp and hrp:FindFirstChild("AudioPlayer")
    if audioPlayer then
        local endedConn
        endedConn = audioPlayer.Ended:Connect(function()
            endedConn:Disconnect()
            if not AutoDJ._stopFlag then
                PlayNext()
            end
        end)

        -- Safety timer in case Ended never fires (max 180 seconds)
        task.wait(180)
        if endedConn and endedConn.Connected then
            endedConn:Disconnect()
            if not AutoDJ._stopFlag then
                PlayNext()
            end
        end
    end
end

-- Main loop
local function RunLoop()
    AutoDJ._running = true
    AutoDJ._stopFlag = false

    while AutoDJ._running and not AutoDJ._stopFlag do
        PlayNext()
        -- Wait until either stopped or the next song is triggered via Ended
        while AutoDJ._running and not AutoDJ._stopFlag do
            task.wait(1)
        end
    end

    AutoDJ._running = false
end

-- Public API
function AutoDJ.Start()
    if AutoDJ._running then
        print("[AutoDJ] Already running.")
        return
    end
    AutoDJ._stopFlag = false
    if AutoDJ._thread then
        task.cancel(AutoDJ._thread)
        AutoDJ._thread = nil
    end
    AutoDJ._thread = task.spawn(RunLoop)
    print("[AutoDJ] Started.")
end

function AutoDJ.Stop()
    if not AutoDJ._running then
        print("[AutoDJ] Not running.")
        return
    end
    AutoDJ._stopFlag = true
    AutoDJ._running = false
    if AutoDJ._thread then
        task.cancel(AutoDJ._thread)
        AutoDJ._thread = nil
    end
    print("[AutoDJ] Stopped.")
end

function AutoDJ.Toggle()
    if AutoDJ._running then
        AutoDJ.Stop()
    else
        AutoDJ.Start()
    end
end

function AutoDJ.IsRunning()
    return AutoDJ._running
end

return AutoDJ
