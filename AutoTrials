----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function Notify(title, desc, time, kind)
    local win = getgenv().AetherWindow
    if win and win.Notify then
        pcall(function()
            win:Notify({ Title = title, Desc = desc, Time = time or 3, Type = kind or "normal" })
        end)
    else
        print(string.format("[AutoTrials] %s: %s", title, desc))
    end
end

local function getGameState()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    if pg:FindFirstChild("ReactLobbyHud") then return "LOBBY" end
    if pg:FindFirstChild("ReactUniversalHotbar") then return "GAME" end
    return nil
end

local function getCurrentTrial()
    local stateRep = ReplicatedStorage:FindFirstChild("StateReplicators")
    if not stateRep then return nil end

    local gameStateRep = stateRep:FindFirstChild("GameStateReplicator")
    if gameStateRep then
        local trial = gameStateRep:GetAttribute("GlobalTrial")
        if trial and trial ~= "" then return trial end
    end

    local trialsRep = stateRep:FindFirstChild("TrialsStateReplicator")
    if trialsRep then
        local trial = trialsRep:GetAttribute("GlobalTrial")
        if trial and trial ~= "" then return trial end
    end
    return nil
end

local function getSkillLevels()
    local skills = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("SurfaceGui") and obj.Name == "TileSurfaceGui" then
            local frame = obj:FindFirstChild("Frame")
            if frame then
                local skillName  = frame:FindFirstChild("SkillName")
                local skillLevel = frame:FindFirstChild("SkillLevel")
                if skillName and skillLevel then
                    local current = 0
                    local levelText = skillLevel.Text
                    if levelText:find("MAX") then
                        local maxMatch = levelText:match("%[(%d+)%]")
                        if maxMatch then current = tonumber(maxMatch) or 0 end
                    else
                        local parts = {}
                        for part in levelText:gmatch("[^/]+") do
                            table.insert(parts, part)
                        end
                        if #parts == 2 then
                            current = tonumber(parts[1]) or 0
                        end
                    end
                    skills[skillName.Text] = current
                end
            end
        end
    end
    return skills
end

local function checkSkillRequirements(trialName)
    local config = trialConfigs[trialName]
    if not config or not config.SkillTree or next(config.SkillTree) == nil then
        return true, {}
    end
    local skills  = getSkillLevels()
    local missing = {}
    for skillName, requiredLevel in pairs(config.SkillTree) do
        local current = skills[skillName] or 0
        if current < requiredLevel then
            table.insert(missing, string.format("%s (Req: %d, Cur: %d)", skillName, requiredLevel, current))
        end
    end
    return #missing == 0, missing
end

local function OpenInventory()
    local network = ReplicatedStorage:FindFirstChild("Network")
    if not network then return false end
    local inventory = network:FindFirstChild("Inventory")
    if not inventory then return false end
    local openRemote = inventory:FindFirstChild("URE:OpenInventory")
    if not openRemote then return false end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg and pg:FindFirstChild("ReactUniversalInventoryView") then return true end
    openRemote:FireServer()
    task.wait(2)
    return true
end

local function GetOwnedTowers()
    local towers = {}
    OpenInventory()
    for _ = 1, 15 do
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local inv = pg and pg:FindFirstChild("ReactUniversalInventoryView")
        local holder = inv and inv:FindFirstChild("Holder")
        local windowFrame = holder and holder:FindFirstChild("windowFrame")
        local towersFrame = windowFrame and windowFrame:FindFirstChild("towersInventoryFrame")
        local towerContainer = towersFrame and towersFrame:FindFirstChild("towerContainer")
        if towerContainer then
            task.wait(0.5)
            for _, scroller in ipairs(towerContainer:GetChildren()) do
                if string.find(scroller.Name, "scrolling") then
                    for _, frame in ipairs(scroller:GetChildren()) do
                        if frame:IsA("Frame") and frame.Name ~= "UIListLayout" then
                            local owned = false
                            local main = frame:FindFirstChild("main")
                            if main then
                                local topThing = main:FindFirstChild("topThing")
                                if topThing then
                                    if not topThing.Visible then
                                        owned = true
                                    else
                                        local icon = topThing:FindFirstChild("icon")
                                        if icon and icon:IsA("ImageLabel") then
                                            if icon.Image ~= "rbxassetid://8418293221" then
                                                owned = true
                                            end
                                        else
                                            owned = true
                                        end
                                    end
                                else
                                    owned = true
                                end
                            else
                                owned = true
                            end
                            if owned then table.insert(towers, frame.Name) end
                        end
                    end
                end
            end
            return towers
        end
        task.wait(0.5)
    end
    warn("[AutoTrials] Timeout waiting for inventory UI.")
    return towers
end

local function checkTowerRequirements(trialName)
    local config = trialConfigs[trialName]
    if not config or not config.Towers or #config.Towers == 0 then
        return true, {}
    end
    local owned   = GetOwnedTowers()
    local missing = {}
    for _, req in ipairs(config.Towers) do
        if req ~= "Placeholder" then
            local found = false
            for _, o in ipairs(owned) do
                if o == req then found = true; break end
            end
            if not found then table.insert(missing, req) end
        end
    end
    return #missing == 0, missing
end

----------------------------------------------------------------
-- Core run logic (executes once per "tick")
----------------------------------------------------------------
local function RunOnce()
    local trialName = getCurrentTrial()
    if not trialName then
        Notify("AutoTrials", "No active trial found.", 3, "error")
        return false
    end

    local skillOK, skillMissing = checkSkillRequirements(trialName)
    if not skillOK then
        Notify("AutoTrials", "Missing skills:\n" .. table.concat(skillMissing, "\n"), 10, "error")
        return false
    end

    local towerOK, towerMissing = checkTowerRequirements(trialName)
    if not towerOK then
        Notify("AutoTrials", "Missing towers:\n" .. table.concat(towerMissing, "\n"), 10, "error")
        return false
    end

    local state = getGameState()

    -- LOBBY -> join the trial, remember which one we joined
    if state == "LOBBY" then
        if writefile and makefolder then
            pcall(makefolder, "GlobalConfigs")
            pcall(writefile, "GlobalConfigs/trialscript.txt", trialName)
        end
        pcall(function()
            ReplicatedStorage.RemoteFunction:InvokeServer(
                "Multiplayer", "v2:start", { count = 1, mode = "Trials" }
            )
        end)
        Notify("AutoTrials", "Joined trial for " .. trialName, 3)
        return "joined"
    end

    -- GAME -> run the saved strategy
    if state == "GAME" then
        local savedTrial = nil
        if isfile then
            pcall(function()
                savedTrial = readfile("GlobalConfigs/trialscript.txt")
            end)
        end
        local targetTrial = savedTrial or trialName
        local mapped      = trialMap[targetTrial] or targetTrial
        local scriptUrl   = trialScripts[mapped]
        if not scriptUrl then
            Notify("AutoTrials", "No strategy for " .. targetTrial, 3, "error")
            return false
        end

        task.wait(2)
        local ok, err = pcall(function()
            local chunk = game:HttpGet(scriptUrl)
            chunk = "local TDS = shared.TDSTable or _G.TDS or error('TDS not found')\n" .. chunk
            local fn = loadstring(chunk)
            if fn then fn() end
        end)
        if ok then
            Notify("AutoTrials", "Running strategy for " .. targetTrial, 3)
        else
            warn("[AutoTrials] Error: " .. tostring(err))
            Notify("AutoTrials", "Failed to load strategy.", 3, "error")
        end
        return "ran"
    end

    return false
end

----------------------------------------------------------------
-- Public API
----------------------------------------------------------------
function AutoTrials.Start()
    if running then return end
    running = true

    thread = task.spawn(function()
        local lastJoinAt    = 0
        local ranForTrial   = nil
        local joinedForTrial = nil

        while running do
            if not Globals.AutoTrials then
                running = false
                break
            end

            local state = getGameState()
            local trialName = getCurrentTrial()

            -- Never run requirements checks more than once per trial per state
            local shouldTry = false
            if trialName then
                if state == "LOBBY" then
                    if joinedForTrial ~= trialName and (os.clock() - lastJoinAt) > 5 then
                        shouldTry = true
                    end
                elseif state == "GAME" then
                    if ranForTrial ~= trialName then
                        shouldTry = true
                    end
                end
            end

            if shouldTry then
                local ok, result = pcall(RunOnce)
                if not ok then
                    warn("[AutoTrials] RunOnce failed: " .. tostring(result))
                elseif result == "joined" then
                    lastJoinAt     = os.clock()
                    joinedForTrial = trialName
                elseif result == "ran" then
                    ranForTrial = trialName
                end
            end

            task.wait(2)
        end

        running = false
    end)
end

function AutoTrials.Stop()
    running = false
    if thread then
        pcall(task.cancel, thread)
        thread = nil
    end
end

function AutoTrials.IsRunning()
    return running
end

return AutoTrials
