--[[
    AutoMedic v2  (YeetML/tds)

    Facts this is built on (all measured in-game, not assumed):
      * ToggleSelectedTower is a TOGGLE and replies true (flipped) / false (refused, e.g. tower is
        claimed by another medic). It applies server-side before the reply arrives.
      * Activate "Ubercharge" replies true when it fires and false while on cooldown.
        Base debounce = 60s, duration = 10s (L4/L5) / 7.5s (L3).
      * The Accelerator skill (node 13, 0.5% per level, cap 25 -> 12.5%) shortens that debounce:
        level 25 = 52.5s. Measured on the server: 52.51-52.53s. The level is read from
        GameStateReplicator.Skills, honoring GameRules SkillsEnabled; after the first lap the real
        cooldown is also learned from the server's own false->true flip, so it self-corrects.
      * Releasing a target mid-uber removes its buff instantly -> selection must be held for the
        whole window, and must be released for the next medic to be able to claim the same towers.
      * The medic's own StatusEffects.FreezeImmune runs for the full duration no matter what we do
        with the selection, so it is a clean "uber ended" clock.
      * Game speed is GameStateReplicator.TimeScale.

    Design:
      * ONE coordinator thread = at most one of your medics holds a selection, always.
      * Selection changes are state-checked (never blind-toggled twice) and sent as one pipelined
        batch: release old medic -> select on new medic -> Activate, all in the same frame.
      * The hand-off is sent so it lands when the previous uber ends (duration learned from the
        FreezeImmune ON->OFF window), so the gap is ~0.04-0.09s (network floor) whenever the next
        medic is off cooldown. Measured: 4 medics, 4 consecutive 10.0s ubers, then one cooldown gap.
      * Next medic = the one that becomes ready first; unavoidable gaps are only cooldown gaps.
]]

local Players           = game:GetService("Players")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService       = game:GetService("HttpService")
local RunService        = game:GetService("RunService")

local LocalPlayer    = Players.LocalPlayer
local PlayerUserId   = LocalPlayer.UserId
local PlayerName     = LocalPlayer.Name
local RemoteFunction = ReplicatedStorage:WaitForChild("RemoteFunction")
local Globals        = getgenv()

-- a reload must never leave an old coordinator running
if Globals.__AutoMedicStop then pcall(Globals.__AutoMedicStop) end

local AutoMedic = {}

----------------------------------------------------------------
-- Constants
----------------------------------------------------------------
local ABILITY_NAME     = "Ubercharge"
local UBER_DURATION    = { [3] = 7.5, [4] = 10, [5] = 10 } -- real seconds at 1x; key = medic level
local UBER_COOLDOWN    = 60   -- base debounce, BEFORE the Accelerator skill
local INITIAL_COOLDOWN = 30
local ACCEL_PER_LEVEL  = 0.5  -- SkillAccelerator: % cooldown reduction per level (game's valuePerLevel)
local ACCEL_LEVEL_CAP  = 25
local CAPACITY_BY_LEVEL = { [0] = 1, [1] = 2, [2] = 3, [3] = 3, [4] = 4, [5] = 5 }
local EXCLUDED_TOWERS  = { ["farm"] = true, ["dj booth"] = true, ["djbooth"] = true }

local REACH_SLACK       = 3     -- studs added to the estimated medic reach (server is the real judge)
local PRE_LEAD          = 0.12  -- start the swap this long before the next medic is ready
local ACTIVATE_STAGGER  = 0.03  -- spacing between overlapping Activate attempts
local ACTIVATE_GRACE    = 1.5   -- keep trying this long after the expected ready time
local REFUSE_BLOCK_SECS = 30    -- a tower the server refused is skipped for this long
local END_GRACE         = 1.0   -- fallback if the FreezeImmune signal never shows up
local PREDICT_BIAS      = 0.0   -- + = send later, - = send earlier
local MAINT_INTERVAL    = 0.35
local HOLD_WHILE_IDLE   = true  -- keep the last medic's selection (Medi Gun) until the next swap

----------------------------------------------------------------
-- Debug log (set getgenv().AutoMedicDebug = true, read getgenv().AutoMedicLog)
----------------------------------------------------------------
local function dbg(msg)
    if not Globals.AutoMedicDebug then return end
    local log = Globals.AutoMedicLog
    if type(log) ~= "table" then log = {}; Globals.AutoMedicLog = log end
    log[#log + 1] = string.format("%9.3f  %s", os.clock(), msg)
    if #log > 600 then table.remove(log, 1) end
    shared.AutoMedicLog = log
end

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function IsAlive(inst) return inst ~= nil and inst.Parent ~= nil end
local function lower(s) return type(s) == "string" and string.lower(s) or "" end

local function getGameState()
    local sr = ReplicatedStorage:FindFirstChild("StateReplicators")
    return sr and sr:FindFirstChild("GameStateReplicator")
end

local function getSpeed()
    local g = getGameState()
    local v = g and tonumber(g:GetAttribute("TimeScale"))
    return (v and v > 0) and v or 1
end

local function decodeSelected(rep)
    local raw = rep and rep:GetAttribute("TowersSelected")
    if type(raw) ~= "string" or raw == "" then return {} end
    raw = raw:gsub("^[%c%s]+", "")
    local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok or type(decoded) ~= "table" then return {} end
    local set = {}
    for k, v in pairs(decoded) do
        if type(k) == "string" then set[k] = true
        elseif type(v) == "string" then set[v] = true end
    end
    return set
end

local function scanTowers()
    local list, byUID = {}, {}
    local folder = Workspace:FindFirstChild("Towers")
    if not folder then return list, byUID end
    for _, tower in ipairs(folder:GetChildren()) do
        local rep = tower:FindFirstChild("TowerReplicator")
        if rep then
            local d = {
                Tower = tower, Rep = rep,
                Name = rep:GetAttribute("Name"),
                UID = rep:GetAttribute("UID"),
                CreatedAt = rep:GetAttribute("CreatedAt") or math.huge,
                OwnerId = rep:GetAttribute("OwnerId"),
                OwnerName = rep:GetAttribute("OwnerName"),
                Upgrade = rep:GetAttribute("Upgrade") or 0,
                TowersCanSelect = rep:GetAttribute("TowersCanSelect"),
            }
            list[#list + 1] = d
            if d.UID then byUID[d.UID] = d end
        end
    end
    table.sort(list, function(a, b) return a.CreatedAt < b.CreatedAt end)
    return list, byUID
end

function AutoMedic.GetAllTowers() return (scanTowers()) end

local function isMine(d)
    return (d.OwnerId and d.OwnerId == PlayerUserId) or (d.OwnerName and d.OwnerName == PlayerName) or false
end
local function isMedic(d) return lower(d.Name) == "medic" end

local function currentSettings()
    local mode = "universal"
    local mt = Globals.MedicTarget or "Universal"
    if mt == "Self" then mode = "self" elseif mt == "Self First" then mode = "self_first" end
    return mode, Globals.Towerslot or {}
end

----------------------------------------------------------------
-- Parallel remote batches (calls are dispatched in order, in one frame)
----------------------------------------------------------------
local function dispatch(fns)
    local h = { pending = #fns, results = {} }
    for i, f in ipairs(fns) do
        task.spawn(function()
            h.results[i] = f()
            h.pending -= 1
            if h.pending == 0 and h.waiter then
                local w = h.waiter
                h.waiter = nil
                task.spawn(w)
            end
        end)
    end
    return h
end

local function join(h)
    if h.pending > 0 then
        h.waiter = coroutine.running()
        coroutine.yield()
    end
    return h.results
end

local function parallel(fns) return join(dispatch(fns)) end

-- Round-trip floor: single samples spike (measured 0.06s typical, 0.325s on a spike), the minimum
-- of recent samples is the stable estimate of the real network delay.
local rttSamples = {}
local function recordRtt(x)
    rttSamples[#rttSamples + 1] = x
    if #rttSamples > 30 then table.remove(rttSamples, 1) end
end
local function rttFloor()
    local m = math.huge
    for _, v in ipairs(rttSamples) do if v < m then m = v end end
    return m == math.huge and 0.06 or m
end

-- true = flipped, false/nil = refused or error
local function toggleTower(medic, tower)
    local s = os.clock()
    local ok, res = pcall(function()
        return RemoteFunction:InvokeServer("Troops", "TowerServerEvent", "ToggleSelectedTower", medic.Tower, tower.Tower)
    end)
    if not ok then return nil end
    recordRtt(os.clock() - s)
    return res == true
end

-- Ubercharge cooldown reduction (%) from the Accelerator skill tree node, read straight from the
-- replicated skill levels (no require() of game modules: weak executors choke on that).
-- Honors the game's own switches: GameRules SkillsEnabled and the per-skill enabled flag.
local function getSkillCooldownPct()
    local pct = 0
    pcall(function()
        local sr = ReplicatedStorage:FindFirstChild("StateReplicators")
        local g = sr and sr:FindFirstChild("GameStateReplicator")
        local raw = g and g:GetAttribute("Skills")
        if type(raw) ~= "string" then return end
        raw = raw:gsub("^[%c%s]+", "")
        local all = HttpService:JSONDecode(raw)
        local mine = all[tostring(PlayerUserId)]
        local lvl = mine and tonumber(mine.SkillAccelerator) or 0
        pct = math.min(math.max(lvl, 0), ACCEL_LEVEL_CAP) * ACCEL_PER_LEVEL

        local rules = sr:FindFirstChild("GameRulesReplicator")
        if rules then
            if rules:GetAttribute("SkillsEnabled") == false then pct = 0 end
            local flagsRaw = rules:GetAttribute("Skills")
            if type(flagsRaw) == "string" then
                flagsRaw = flagsRaw:gsub("^[%c%s]+", "")
                local flags = HttpService:JSONDecode(flagsRaw)
                if flags and flags.SkillAccelerator == false then pct = 0 end
            end
        end
    end)
    return pct
end

----------------------------------------------------------------
-- Per-medic bookkeeping
----------------------------------------------------------------
local records = {}          -- [medicUID] = { readyAt, lastFiredAt, accepted, blocked, fails }
local learnedDuration = {}  -- [speedKey] = measured real uber duration (FreezeImmune ON->OFF)
local cooldownObserved = {} -- [speedKey] = cooldown measured from the server's own false->true flip

local function speedKey(s) return string.format("%.3f", s) end

local function getRecord(m)
    local rec = records[m.UID]
    if not rec then
        local readyIn = 0
        local g = getGameState()
        local st = g and tonumber(g:GetAttribute("ServerTime"))
        if st and m.CreatedAt ~= math.huge then
            readyIn = math.max(0, m.CreatedAt + INITIAL_COOLDOWN - st) / getSpeed()
        end
        rec = { readyAt = os.clock() + readyIn, lastFiredAt = 0, lastSentAt = 0,
                accepted = {}, blocked = {}, fails = 0 }
        records[m.UID] = rec
    end
    return rec
end

local function chooseNext(medics)
    local best, bestRec
    for _, m in ipairs(medics) do
        local rec = getRecord(m)
        if not best
            or rec.readyAt < bestRec.readyAt - 1e-3
            or (math.abs(rec.readyAt - bestRec.readyAt) <= 1e-3 and rec.lastFiredAt < bestRec.lastFiredAt) then
            best, bestRec = m, rec
        end
    end
    return best, bestRec
end

----------------------------------------------------------------
-- Target picking
----------------------------------------------------------------
local function pickTargets(m, list, rec)
    local capacity = m.TowersCanSelect or CAPACITY_BY_LEVEL[m.Upgrade] or 1
    local mpos = m.Rep:GetAttribute("Position")
    if typeof(mpos) ~= "Vector3" or capacity <= 0 then return {} end
    -- strictReach: anything inside it is guaranteed to be accepted (measured: the server also accepted
    -- a tower at 23.4 studs with Range=20/RangeBuff=12.5, i.e. beyond this). reach adds slack for those.
    local strictReach = (tonumber(m.Rep:GetAttribute("Range")) or 0)
        * (1 + (tonumber(m.Rep:GetAttribute("RangeBuff")) or 0) / 100)
    local reach = strictReach + REACH_SLACK

    -- towers claimed by OTHER players' medics are unavailable (server refuses them).
    -- our own medics' claims are ignored: they get released as part of the swap.
    local claimed = {}
    for _, d in ipairs(list) do
        if isMedic(d) and not isMine(d) then
            for uid in pairs(decodeSelected(d.Rep)) do claimed[uid] = true end
        end
    end

    local now = os.clock()
    local pool = {}
    for _, d in ipairs(list) do
        local n = lower(d.Name)
        if d.UID and d.UID ~= m.UID and n ~= "" and n ~= "medic"
            and not EXCLUDED_TOWERS[n] and not claimed[d.UID] then
            local untilT = rec.blocked[d.UID]
            if not untilT or untilT <= now then
                local p = d.Rep:GetAttribute("Position")
                if typeof(p) == "Vector3" then
                    local dx, dz = p.X - mpos.X, p.Z - mpos.Z
                    local dist = math.sqrt(dx * dx + dz * dz)
                    if dist <= reach then
                        d.Confident = dist <= strictReach
                        pool[#pool + 1] = { d = d, dist = dist, mine = isMine(d), name = n }
                    end
                end
            end
        end
    end

    local mode, wanted = currentSettings()
    local picked, used = {}, {}
    local function take(e) picked[#picked + 1] = e.d; used[e] = true end
    local function pass(filter)
        for _, name in ipairs(wanted) do
            local nl = lower(name)
            for _, e in ipairs(pool) do
                if #picked >= capacity then return end
                if not used[e] and e.name == nl and (not filter or filter(e)) then take(e) end
            end
        end
    end

    if mode == "self" then
        pass(function(e) return e.mine end)
    elseif mode == "self_first" then
        pass(function(e) return e.mine end)
        pass(function(e) return not e.mine end)
    else
        pass(nil)
        if #picked < capacity then -- Universal fills spare capacity with the closest towers
            local rest = {}
            for _, e in ipairs(pool) do if not used[e] then rest[#rest + 1] = e end end
            table.sort(rest, function(a, b) return a.dist < b.dist end)
            for _, e in ipairs(rest) do
                if #picked >= capacity then break end
                take(e)
            end
        end
    end
    return picked
end

----------------------------------------------------------------
-- Selection planning
----------------------------------------------------------------
-- Ops that make `m` hold exactly `desired` and every other own medic hold nothing.
-- Order matters: releases first, then selects (same-frame pipelining relies on it).
local function planSelection(m, rec, desired, byUID, ownAll)
    local ops, meta = {}, {}
    local function add(medic, tower, kind)
        ops[#ops + 1] = function() return toggleTower(medic, tower) end
        meta[#meta + 1] = { kind = kind, tower = tower }
    end

    for _, o in ipairs(ownAll) do
        if o.UID ~= m.UID then
            for uid in pairs(decodeSelected(o.Rep)) do
                local t = byUID[uid]
                if t then add(o, t, "release") end
            end
        end
    end

    local sel, want = decodeSelected(m.Rep), {}
    for _, t in ipairs(desired) do want[t.UID] = true end
    for uid in pairs(sel) do
        if not want[uid] then
            local t = byUID[uid]
            if t then add(m, t, "release") end
        end
    end

    local confirmed = true -- every needed select is one the server already accepted before
    for _, t in ipairs(desired) do
        if not sel[t.UID] then
            add(m, t, "select")
            if not rec.accepted[t.UID] and not t.Confident then confirmed = false end
        end
    end
    return ops, meta, confirmed
end

local function applyResults(meta, results, rec, blockOnRefuse)
    local now = os.clock()
    for i, md in ipairs(meta) do
        if md.kind == "select" then
            local uid = md.tower.UID
            if results[i] == true then
                rec.accepted[uid] = true
                rec.blocked[uid] = nil
            else
                rec.accepted[uid] = nil
                if blockOnRefuse then rec.blocked[uid] = now + REFUSE_BLOCK_SECS end
                dbg("select refused " .. tostring(md.tower.Name) .. " " .. string.sub(uid, 1, 6)
                    .. (blockOnRefuse and " (blocked)" or " (will retry)"))
            end
        end
    end
end

-- One clean (non-pipelined) round. Returns true when nothing needed changing.
local function syncSelection(m, rec)
    local list, byUID = scanTowers()
    local ownAll = {}
    for _, d in ipairs(list) do if isMedic(d) and isMine(d) then ownAll[#ownAll + 1] = d end end
    local desired = pickTargets(m, list, rec)
    local ops, meta = planSelection(m, rec, desired, byUID, ownAll)
    if #ops == 0 then return true end
    applyResults(meta, parallel(ops), rec, true)
    return false
end

----------------------------------------------------------------
-- Firing
----------------------------------------------------------------
local function fireUber(m, rec)
    local state = { fired = false, attempts = 0 }
    local inflight = 0
    local stopAt = math.max(os.clock(), rec.readyAt) + ACTIVATE_GRACE

    local function attempt()
        inflight += 1
        state.attempts += 1
        local sentAt = os.clock()
        local ok, res = pcall(function()
            return RemoteFunction:InvokeServer("Troops", "Abilities", "Activate",
                { Troop = m.Tower, Name = ABILITY_NAME, Data = {} })
        end)
        local ackAt = os.clock()
        inflight -= 1
        if ok then recordRtt(ackAt - sentAt) end
        if ok and res == true and not state.fired then
            state.fired, state.ackAt, state.sentAt, state.rtt = true, ackAt, sentAt, ackAt - sentAt
        end
    end

    while not state.fired and IsAlive(m.Tower) and os.clock() < stopAt do
        task.spawn(attempt)
        task.wait(ACTIVATE_STAGGER)
    end
    local limit = os.clock() + 0.5
    while not state.fired and inflight > 0 and os.clock() < limit do task.wait(0.01) end
    return state
end

-- Swap selection to `m` and fire. Returns { fired, ackAt, sentAt, rtt, attempts, how }.
local function engage(m, rec, ownAll, byUID, list)
    local desired = pickTargets(m, list, rec)
    if #desired == 0 then return { fired = false, attempts = 0, how = "no targets in range" } end

    local ops, meta, confirmed = planSelection(m, rec, desired, byUID, ownAll)
    local handle = dispatch(ops)

    if confirmed then
        -- every select was accepted before: fire in the same frame as the swap
        local res = fireUber(m, rec)
        applyResults(meta, join(handle), rec, false)
        res.how = "pipelined"
        return res
    end

    applyResults(meta, join(handle), rec, false)
    for _ = 1, 3 do
        if syncSelection(m, rec) then break end
    end
    if next(decodeSelected(m.Rep)) == nil then
        return { fired = false, attempts = 0, how = "nothing selectable" }
    end
    local res = fireUber(m, rec)
    res.how = "verified"
    return res
end

----------------------------------------------------------------
-- Uber window tracking
-- Duration = FreezeImmune ON -> OFF. Both are replication events on the same path, so network
-- delay cancels out (measuring from the Activate ack picked up a latency spike: 9.77s vs 10.0s).
----------------------------------------------------------------
local function trackUber(u)
    local se = u.m.Rep:FindFirstChild("StatusEffects")
    if not se then return end
    if se:GetAttribute("FreezeImmune") ~= nil then
        u.sawActive, u.onSeenAt = true, os.clock()
    end
    local conn
    conn = se:GetAttributeChangedSignal("FreezeImmune"):Connect(function()
        if se:GetAttribute("FreezeImmune") ~= nil then
            if not u.onSeenAt then u.sawActive, u.onSeenAt = true, os.clock() end
        elseif u.sawActive and not u.endSeenAt then
            u.endSeenAt = os.clock()
            if u.onSeenAt then
                local d = u.endSeenAt - u.onSeenAt
                local nominal = u.nominal / u.speed
                if d > nominal * 0.5 and d < nominal * 1.5 + 0.5 then
                    local old = learnedDuration[u.key]
                    learnedDuration[u.key] = old and (old * 0.5 + d * 0.5) or d
                    dbg(string.format("uber ended: ON->OFF %.3fs (learned %.3fs)", d, learnedDuration[u.key]))
                end
            end
            conn:Disconnect()
        end
    end)
    task.delay(u.nominal / u.speed + 6, function() if conn then conn:Disconnect() end end)
end

-- "ended" once it is time to send the hand-off. The hand-off is timed so it LANDS on the server
-- exactly when the buff would end: replicated-ON time + duration - one network delay.
local function uberStatus(u, now)
    if not u or not IsAlive(u.m.Tower) then return "ended" end
    if u.endSeenAt then return "ended" end
    local nominal = u.nominal / u.speed
    local L = learnedDuration[u.key]
    if L then
        local sendAt
        if u.onSeenAt then sendAt = u.onSeenAt + L - rttFloor() + PREDICT_BIAS
        else sendAt = u.sentAt + L + PREDICT_BIAS end
        if now >= sendAt then return "ended" end
    elseif not u.sawActive and now > u.ackAt + 0.6 then
        if now >= u.ackAt + nominal - rttFloor() then return "ended" end -- signal never appeared
    end
    if now >= u.ackAt + nominal + END_GRACE then return "ended" end
    return "active"
end

----------------------------------------------------------------
-- Coordinator
----------------------------------------------------------------
local function collectMedics(list)
    local ownAll, medics = {}, {}
    for _, d in ipairs(list) do
        if isMedic(d) and isMine(d) then
            ownAll[#ownAll + 1] = d
            if UBER_DURATION[d.Upgrade] then medics[#medics + 1] = d end
        end
    end
    return ownAll, medics
end

local function coordinator()
    local cur, holder, holderUIDs = nil, nil, nil
    local lastMaint = 0

    while true do
        local list, byUID = scanTowers()
        local ownAll, medics = collectMedics(list)
        if #medics == 0 then
            cur, holder, holderUIDs = nil, nil, nil
            task.wait(0.5)
            continue
        end

        local nextM, nextRec = chooseNext(medics)
        local abort = false

        -- wait for the moment: previous uber over AND next medic about to be ready
        while true do
            local now = os.clock()
            if not IsAlive(nextM.Tower) then abort = true break end
            local curDone = uberStatus(cur, now) ~= "active"
            if curDone and now >= nextRec.readyAt - PRE_LEAD then break end

            if curDone and not HOLD_WHILE_IDLE and holder and holderUIDs and next(holderUIDs) then
                local ops = {}
                for uid in pairs(holderUIDs) do
                    local t = byUID[uid]
                    if t and decodeSelected(holder.Rep)[uid] then
                        ops[#ops + 1] = function() return toggleTower(holder, t) end
                    end
                end
                if #ops > 0 then parallel(ops) end
                holderUIDs = nil
            end

            if now - lastMaint >= MAINT_INTERVAL then
                lastMaint = now
                local l2, b2 = scanTowers()
                local own2, med2 = collectMedics(l2)
                if #med2 == 0 then abort = true break end
                nextM, nextRec = chooseNext(med2)
                list, byUID, ownAll = l2, b2, own2

                -- keep the single-holder invariant + repair anything the server dropped
                local ops = {}
                for _, o in ipairs(own2) do
                    if not holder or o.UID ~= holder.UID then
                        for uid in pairs(decodeSelected(o.Rep)) do
                            local t = b2[uid]
                            if t then ops[#ops + 1] = function() return toggleTower(o, t) end end
                        end
                    end
                end
                if holder and holderUIDs then
                    local sel = decodeSelected(holder.Rep)
                    for uid in pairs(holderUIDs) do
                        local t = b2[uid]
                        if t and not sel[uid] then
                            ops[#ops + 1] = function() return toggleTower(holder, t) end
                        end
                    end
                end
                if #ops > 0 then
                    dbg("maintenance: fixing " .. #ops .. " selection(s)")
                    parallel(ops)
                end
            end
            RunService.Heartbeat:Wait()
        end
        if abort then continue end

        -- fresh state for the swap itself
        list, byUID = scanTowers()
        ownAll = collectMedics(list)
        local res = engage(nextM, nextRec, ownAll, byUID, list)
        holder = nextM
        holderUIDs = decodeSelected(nextM.Rep)

        if res.fired then
            local speed = getSpeed()
            local key = speedKey(speed)
            local pct = getSkillCooldownPct()
            local formulaCd = (UBER_COOLDOWN * (1 - pct / 100)) / speed

            -- self-correct from what the server actually did. Only the send->send gap is used (acks
            -- carry latency spikes). A false->true flip (attempts > 1) pins the cooldown to ~1 stagger.
            -- A first-try success only proves "cooldown <= gap", so it can shorten the estimate, never grow it.
            if nextRec.lastSentAt > 0 then
                local gap = res.sentAt - nextRec.lastSentAt
                local obs = cooldownObserved[key]
                if res.attempts > 1 and gap > formulaCd * 0.4 and gap < formulaCd * 1.6 then
                    local x = gap - ACTIVATE_STAGGER * 0.5
                    cooldownObserved[key] = obs and (obs * 0.5 + x * 0.5) or x
                    dbg(string.format("cooldown observed %.2fs (skill formula %.2fs, accelerator -%.1f%%)",
                        cooldownObserved[key], formulaCd, pct))
                elseif res.attempts == 1 then
                    local x = gap - 0.05
                    if x >= formulaCd * 0.6 and x < (obs or formulaCd) then cooldownObserved[key] = x end
                end
            end
            local cd = cooldownObserved[key] or formulaCd

            nextRec.fails = 0
            nextRec.lastFiredAt = res.ackAt
            nextRec.lastSentAt = res.sentAt
            nextRec.readyAt = res.sentAt + cd -- send->send tracks the server cooldown directly

            local u = { m = nextM, ackAt = res.ackAt, sentAt = res.sentAt, rtt = res.rtt,
                        speed = speed, key = key, nominal = UBER_DURATION[nextM.Upgrade] }
            trackUber(u)
            cur = u

            local n = 0
            for _ in pairs(holderUIDs) do n += 1 end
            dbg(string.format("FIRED %s %s  towers=%d  rtt=%.3f  attempts=%d  cooldown=%.2fs (-%.1f%%)  predictive=%s",
                string.sub(nextM.UID, 1, 6), res.how or "?", n, res.rtt, res.attempts, cd, pct,
                tostring(learnedDuration[key] ~= nil)))
        else
            nextRec.fails += 1
            nextRec.readyAt = os.clock() + math.min(1 + nextRec.fails * 1.5, 10)
            dbg(string.format("fire failed %s (%s) fails=%d retry in %.1fs",
                string.sub(nextM.UID, 1, 6), tostring(res.how), nextRec.fails, nextRec.readyAt - os.clock()))
        end
    end
end

----------------------------------------------------------------
-- Public API (same entry point the hub already uses)
----------------------------------------------------------------
local thread = nil

local function releaseAll()
    local list, byUID = scanTowers()
    local ops = {}
    for _, o in ipairs(list) do
        if isMedic(o) and isMine(o) then
            for uid in pairs(decodeSelected(o.Rep)) do
                local t = byUID[uid]
                if t then ops[#ops + 1] = function() return toggleTower(o, t) end end
            end
        end
    end
    if #ops > 0 then parallel(ops) end
end

local function cancelThread()
    if thread then pcall(task.cancel, thread) thread = nil end
end

function AutoMedic.Chain(_targetPlayer, _towersToSelect, toggle, _mode)
    cancelThread()
    if toggle == false then
        task.spawn(releaseAll)
        return
    end
    thread = task.spawn(function()
        while true do
            local ok, err = pcall(coordinator)
            if not ok then
                warn("[AutoMedic] " .. tostring(err))
                dbg("ERROR " .. tostring(err))
                task.wait(1)
            end
        end
    end)
end

function AutoMedic.Stop() AutoMedic.Chain(nil, nil, false) end
function AutoMedic.Debug() return records, learnedDuration end

Globals.__AutoMedicStop = function() cancelThread() end

return AutoMedic
