local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local PlayerUserId = LocalPlayer.UserId
local PlayerName = LocalPlayer.Name
local RemoteFunction = ReplicatedStorage:FindFirstChild("RemoteFunction")
local Globals = getgenv()   -- live access to your settings

local AutoMedic = {}
local activeLoops = {}
local activeChainThread = nil

local CAPACITY_BY_LEVEL = {
    [0] = 1,
    [1] = 2,
    [2] = 3,
    [3] = 3,
    [4] = 4,
    [5] = 5
}

local UBERCHARGE_DURATION = {
    [3] = 10,
    [4] = 12.5,
    [5] = 15
}

local function getTimescaleMultiplier()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return 1 end
    local hotbar = playerGui:FindFirstChild("ReactUniversalHotbar")
    local frame = hotbar and hotbar:FindFirstChild("Frame")
    local timescale = frame and frame:FindFirstChild("timescale")
    if not timescale or not timescale.Visible then
        return 1
    end
    if timescale:FindFirstChild("Lock") then
        return 1
    end
    return 2
end

local function resolveTargetPlayer(targetInput)
    if type(targetInput) == "number" then
        return targetInput, nil
    elseif type(targetInput) == "string" then
        if string.lower(targetInput) == "universal" or targetInput == "" then
            return "universal", "universal"
        end
        local numericId = tonumber(targetInput)
        if numericId then
            return numericId, nil
        end
        return nil, targetInput
    end
    return "universal", "universal"
end

function AutoMedic.GetAllTowers()
    local towersFolder = Workspace:FindFirstChild("Towers")
    local allTowers = {}
    if not towersFolder then return allTowers end

    for _, tower in ipairs(towersFolder:GetChildren()) do
        local replicator = tower:FindFirstChild("TowerReplicator")
        if replicator and tower.Parent then
            table.insert(allTowers, {
                Tower = tower,
                Name = replicator:GetAttribute("Name"),
                CreatedAt = replicator:GetAttribute("CreatedAt") or math.huge,
                OwnerId = replicator:GetAttribute("OwnerId"),
                OwnerName = replicator:GetAttribute("OwnerName"),
                Upgrade = replicator:GetAttribute("Upgrade") or 0,
                TowersCanSelect = replicator:GetAttribute("TowersCanSelect")
            })
        end
    end

    table.sort(allTowers, function(a, b)
        return a.CreatedAt < b.CreatedAt
    end)

    return allTowers
end

local function getMyMedics()
    local allTowers = AutoMedic.GetAllTowers()
    local myMedics = {}

    for _, data in ipairs(allTowers) do
        local isOwner = (data.OwnerId and data.OwnerId == PlayerUserId)
            or (data.OwnerName and data.OwnerName == PlayerName)

        if isOwner and data.Name and string.lower(data.Name) == "medic" then
            table.insert(myMedics, data.Tower)
        end
    end

    return myMedics
end

local function countReadyMedics(medicsList)
    local count = 0
    for _, medicTower in ipairs(medicsList) do
        if medicTower and medicTower.Parent then
            local replicator = medicTower:FindFirstChild("TowerReplicator")
            local upgrade = replicator and replicator:GetAttribute("Upgrade") or 0
            if upgrade >= 3 then
                count = count + 1
            end
        end
    end
    return count
end

local function activateUbercharge(medicTower)
    if not RemoteFunction or not medicTower or not medicTower.Parent then return end
    pcall(function()
        RemoteFunction:InvokeServer("Troops", "Abilities", "Activate", {
            Troop = medicTower,
            Name = "Ubercharge",
            Data = {}
        })
    end)
end

local function toggleMedicTargets(medicTower, targetTowers)
    if not RemoteFunction or not medicTower or not medicTower.Parent or not targetTowers or #targetTowers == 0 then return end
    for _, targetTower in ipairs(targetTowers) do
        if targetTower and targetTower.Parent then
            pcall(function()
                RemoteFunction:InvokeServer("Troops", "TowerServerEvent", "ToggleSelectedTower", medicTower, targetTower)
            end)
        end
    end
end

local function getMedicCapacity(medicTower)
    if not medicTower or not medicTower.Parent then return 0 end
    local medicReplicator = medicTower:FindFirstChild("TowerReplicator")
    if not medicReplicator then return 0 end
    local currentUpgrade = medicReplicator:GetAttribute("Upgrade") or 0
    return medicReplicator:GetAttribute("TowersCanSelect") or CAPACITY_BY_LEVEL[currentUpgrade] or 1
end

local function getUberchargeDuration(medicTower)
    if not medicTower or not medicTower.Parent then return 10 end
    local medicReplicator = medicTower:FindFirstChild("TowerReplicator")
    if not medicReplicator then return 10 end
    return UBERCHARGE_DURATION[medicReplicator:GetAttribute("Upgrade") or 3] or 10
end

-- Fixed target selection (self / self_first / universal)
local function getTargetTowersFromIndex(targetPlayer, towersToSelect, maxCapacity, mode)
    local allTowers = AutoMedic.GetAllTowers()
    local targetId, targetName = resolveTargetPlayer(targetPlayer)
    local isUniversal = (targetId == "universal" or targetName == "universal")
    mode = mode or "universal"

    local targetTowers = {}
    local usedIndices = {}

    local function isOwnedByTarget(data)
        if isUniversal then return true end
        if targetId and data.OwnerId and data.OwnerId == targetId then return true end
        if targetName and data.OwnerName and string.lower(data.OwnerName) == string.lower(targetName) then return true end
        return false
    end

    local function addMatchingTowers(ownerCondition)
        for _, name in ipairs(towersToSelect or {}) do
            if #targetTowers >= maxCapacity then break end
            local nameLower = string.lower(name)

            for i, data in ipairs(allTowers) do
                if usedIndices[i] then continue end
                if not data.Name or string.lower(data.Name) == "medic" then continue end
                if string.lower(data.Name) ~= nameLower then continue end

                local ownedByTarget = isOwnedByTarget(data)
                local ownerMatches = false

                if ownerCondition == "self" then
                    ownerMatches = ownedByTarget
                elseif ownerCondition == "other" then
                    ownerMatches = not ownedByTarget
                else
                    ownerMatches = true
                end

                if ownerMatches then
                    table.insert(targetTowers, data.Tower)
                    usedIndices[i] = true
                    if #targetTowers >= maxCapacity then break end
                end
            end
        end
    end

    if mode == "self_first" then
        addMatchingTowers("self")
        if #targetTowers < maxCapacity then
            addMatchingTowers("other")
        end
    elseif mode == "self" then
        addMatchingTowers("self")
    else
        addMatchingTowers(nil)
    end

    return targetTowers
end

-- Live settings reader (re-checks every cycle)
local function getCurrentSettings()
    local target = "universal"
    local mode = "universal"
    local towers = Globals.Towerslot or {}

    local medicTarget = Globals.MedicTarget or "Universal"

    if medicTarget == "Self" then
        target = LocalPlayer.UserId
        mode = "self"
    elseif medicTarget == "Self First" then
        target = LocalPlayer.UserId
        mode = "self_first"
    end

    return target, mode, towers
end

function AutoMedic.Function(targetPlayer, towersToSelect, toggle, medicIndex)
    medicIndex = medicIndex or 1

    if not activeLoops[medicIndex] then
        activeLoops[medicIndex] = {thread = nil, lastTargets = {}}
    end

    if activeLoops[medicIndex].thread then
        task.cancel(activeLoops[medicIndex].thread)
        activeLoops[medicIndex].thread = nil
    end

    local myMedics = getMyMedics()
    local selectedMedic = myMedics[medicIndex]

    if not selectedMedic then
        warn(string.format("[AutoMedic]: Medic at index [%d] not found!", medicIndex))
        return false
    end

    if toggle == false then
        if #activeLoops[medicIndex].lastTargets > 0 then
            local oldTargets = activeLoops[medicIndex].lastTargets
            activeLoops[medicIndex].lastTargets = {}
            task.spawn(function()
                toggleMedicTargets(selectedMedic, oldTargets)
            end)
        end
        return true
    end

    local medicReplicator = selectedMedic:FindFirstChild("TowerReplicator")
    local currentUpgrade = medicReplicator and medicReplicator:GetAttribute("Upgrade") or 0
    if currentUpgrade < 3 then
        warn(string.format("[AutoMedic]: Medic [%d] level is too low! (Level %d/3 required)", medicIndex, currentUpgrade))
        return false
    end

    if toggle then
        local thread = task.spawn(function()
            while true do
                if not selectedMedic or not selectedMedic.Parent then
                    activeLoops[medicIndex].lastTargets = {}
                    break
                end

                -- Live re-check
                local liveTarget, liveMode, liveTowers = getCurrentSettings()
                local capacity = getMedicCapacity(selectedMedic)
                local targetTowers = getTargetTowersFromIndex(liveTarget, liveTowers, capacity, liveMode)

                if #targetTowers == 0 then
                    if #activeLoops[medicIndex].lastTargets > 0 then
                        local oldTargets = activeLoops[medicIndex].lastTargets
                        activeLoops[medicIndex].lastTargets = {}
                        task.spawn(function()
                            toggleMedicTargets(selectedMedic, oldTargets)
                        end)
                    end
                    task.wait(0.1)
                    continue
                end

                -- Detach old targets in background
                if #activeLoops[medicIndex].lastTargets > 0 then
                    local oldTargets = activeLoops[medicIndex].lastTargets
                    activeLoops[medicIndex].lastTargets = {}
                    task.spawn(function()
                        toggleMedicTargets(selectedMedic, oldTargets)
                    end)
                end

                -- Attach new targets (blocking, but fast because it's just sending)
                toggleMedicTargets(selectedMedic, targetTowers)
                activeLoops[medicIndex].lastTargets = targetTowers
                activateUbercharge(selectedMedic)

                task.wait(0.1)
            end
        end)
        activeLoops[medicIndex].thread = thread
    end

    return true
end

function AutoMedic.Chain(targetPlayer, towersToSelect, toggle, mode)
    if activeChainThread then
        task.cancel(activeChainThread)
        activeChainThread = nil
        print("[AutoMedic]: Stopped active chain loop.")
    end

    if toggle == false then
        print("[AutoMedic]: Chain disabled.")
        return
    end

    local function runChainSequence()
        local myMedics = getMyMedics()
        local readyCount = countReadyMedics(myMedics)

        if readyCount < 4 then
            warn(string.format("[AutoMedic.Chain]: Insufficient Level 3+ Medics (%d/4). Waiting...", readyCount))
            task.wait(0.1)
            return true
        end

        for index, medicTower in ipairs(myMedics) do
            if countReadyMedics(getMyMedics()) < 4 then
                warn("[AutoMedic.Chain]: A Medic was sold mid-chain! Resetting...")
                return true
            end

            if not medicTower or not medicTower.Parent then
                continue
            end

            local medicReplicator = medicTower:FindFirstChild("TowerReplicator")
            local currentUpgrade = medicReplicator and medicReplicator:GetAttribute("Upgrade") or 0
            if currentUpgrade < 3 then
                continue
            end

            -- LIVE re-check every single medic
            local liveTarget, liveMode, liveTowers = getCurrentSettings()
            local capacity = getMedicCapacity(medicTower)
            local targetTowers = getTargetTowersFromIndex(liveTarget, liveTowers, capacity, liveMode)

            while #targetTowers == 0 do
                task.wait(0.1)
                if countReadyMedics(getMyMedics()) < 4 then
                    return true
                end
                liveTarget, liveMode, liveTowers = getCurrentSettings()
                targetTowers = getTargetTowersFromIndex(liveTarget, liveTowers, capacity, liveMode)
            end

            local duration = getUberchargeDuration(medicTower)
            local multiplier = getTimescaleMultiplier()
            local realWait = (multiplier == 2) and ((duration / 2) + 0.1) or duration

            print(string.format(
                "[AutoMedic.Chain]: Medic [%d] (Level %d) -> %d target(s) | Mode: %s | Waiting %.2fs",
                index, currentUpgrade, #targetTowers, liveMode, realWait
            ))

            local attachedTargets = table.clone(targetTowers)
            toggleMedicTargets(medicTower, attachedTargets)
            activateUbercharge(medicTower)

            task.wait(realWait)

            -- Detach in background – this makes the deselect instant from the loop's perspective
            if medicTower and medicTower.Parent then
                task.spawn(function()
                    toggleMedicTargets(medicTower, attachedTargets)
                end)
            end
        end

        return true
    end

    if toggle then
        activeChainThread = task.spawn(function()
            while true do
                local success = runChainSequence()
                if not success then break end
            end
        end)
    else
        task.spawn(runChainSequence)
    end
end

return AutoMedic
