Globals.StartTimeScale = function()
    if Globals.TimeScaleRunning or not Globals.TimeScaleEnabled then return end
    Globals.TimeScaleRunning = true
    task.spawn(function()
        while Globals.TimeScaleEnabled do
            Globals.ApplyTimeScaleOnce()
            task.wait(3)
        end
        Globals.TimeScaleNoTicketsWarned = false
        Globals.TimeScaleRunning = false
    end)
end

Globals.ApplyTimeScaleOnce = function()
    if not Globals.TimeScaleEnabled or Globals.GameState ~= "GAME" then return end
    local frame = GetTimescaleFrame()
    if not frame or not frame.Visible then return end

    local desired = CoerceTimeScaleValue(Globals.TimeScaleValue, 2)
    if not desired then return end

    local lock = frame:FindFirstChild("Lock")
    if lock and lock.Visible then
        if LocalPlayer.TimescaleTickets.Value < 1 then
            if not Globals.TimeScaleNoTicketsWarned then
                Globals.Logger:Log("No timescale tickets left")
                Globals.TimeScaleNoTicketsWarned = true
            end
            return
        end
        UnlockSpeedTickets()
        task.wait(0.4)
    else
        Globals.TimeScaleNoTicketsWarned = false
    end
    SetGameTimescale(desired)
end

task.spawn(function()
    while true do
        if _G.AutoProgSettings.__locked then
            for key, value in pairs(_G.AutoProgSettings) do
                if key ~= "__locked" then
                    if Globals[key] ~= value then
                        Globals[key] = value
                        print("[AutoProg Lock] Forced " .. key .. " = " .. tostring(value))
                    end
                end
            end
        end

        if Globals.AutoPickups and not Globals.AutoPickupsRunning then StartAutoPickups() end
        if Globals.AutoSkip and not Globals.AutoSkipRunning then StartAutoSkip() end
        if Globals.TimeScaleEnabled and not Globals.TimeScaleRunning then Globals.StartTimeScale() end
        if Globals.AutoChain and not Globals.AutoChainRunning then StartAutoChain() end
        if Globals.AutoDJ and not Globals.AutoDjRunning then StartAutoDjBooth() end

        if Globals.RandomDJ then
            if not Globals.AutoDJLib then
                Globals.AutoDJLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/YeetML/tds/refs/heads/main/AutoDjCustomSongs"))()
            end
            if Globals.AutoDJLib and not Globals.AutoDJLib.IsRunning() then
                Globals.AutoDJLib.Start()
            end
        elseif Globals.AutoDJLib and Globals.AutoDJLib.IsRunning() then
            Globals.AutoDJLib.Stop()
        end

        if Globals.MuteOtherDJs then
            if not Globals.AutoDJLib then
                Globals.AutoDJLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/YeetML/tds/refs/heads/main/AutoDjCustomSongs"))()
            end
            if Globals.AutoDJLib and Globals.AutoDJLib.StartMuteOthers then
                Globals.AutoDJLib.StartMuteOthers()
            end
        end

        if Globals.AutoNecro and not Globals.AutoNecroRunning then StartAutoNecro() end
        if Globals.AutoFreezer and not Globals.AutoFreezerRunning then StartAutoFreezer() end
        if Globals.AutoSaboteur and not Globals.AutoSaboteurRunning then StartAutoSaboteur() end
        if Globals.AutoMercenary and not Globals.AutoMercenaryBaseRunning then StartAutoMercenary() end
        if Globals.AutoMilitary and not Globals.AutoMilitaryBaseRunning then StartAutoMilitary() end
        if Globals.SellFarms and not Globals.SellFarmsRunning then StartSellFarm() end
        if Globals.AntiLag and not Globals.AntiLagRunning then StartAntiLag() end
        if (Globals.AutoRejoin or Globals.AutoRestart) and not Globals.BackToLobbyRunning then StartBackToLobby() end
        if Globals.AutoGatling and not Globals.AutoGatlingRunning then StartAutoGatling() end
        if Globals.Gatlify and not Globals.GatlifyRunning then StartGatlify() end
        if Globals.AutoPremium and not Globals.AutoPremiumRunning then StartAutoPremium() end
        if Globals.AutoOpenCrates and not Globals.AutoOpenRunning then StartAutoOpenCrates() end
        if Globals.AutoReady and not Globals.AutoReadyRunning then StartAutoReady() end
        if Globals.Easy and not Globals.EasyModeRunning then StartEasyMode() end
        if Globals.AutoUpgradeSelected and not Globals.AutoUpgradeSelectedRunning then StartAutoUpgradeSelected() end
        if Globals.AutoUpgradeAll and not Globals.AutoUpgradeAllRunning then StartAutoUpgradeAll() end
        if Globals.SmartAutoPlace and not Globals.SmartAutoPlaceRunning then StartSmartAutoPlace() end
if Globals.AutoUpgradeFarms and Globals.SmartAutoPlace and not Globals.SAPUpgradeLoopRunning then
    task.spawn(function()
        SAPScheduler.StartUpgradeLoop(Globals, SAPDeps)
    end)
end

        if Globals.AutoMedic and not Globals.AutoMedicRunning then
            StartMedicChain()
        elseif not Globals.AutoMedic and Globals.AutoMedicRunning then
            StopMedicChain()
        end
        if Globals.AutoBounty and not Globals.AutoBountyRunning then
            StartBountyChain()
        elseif not Globals.AutoBounty and Globals.AutoBountyRunning then
            StopBountyChain()
        end
        if Globals.AutoRedeemCodes and not Globals.CodesRedeemed and not Globals.AutoRedeemRunning then
            redeemCodesFromBeebom()
        end
        task.wait(1)
    end
end)

