function StartMedicChain()
    Globals.AutoMedicRunning = true
    task.spawn(function()
        local myMedics = {}
        repeat
            myMedics = {}
            local towersFolder = workspace:FindFirstChild("Towers")
            if towersFolder then
                for _, tower in ipairs(towersFolder:GetChildren()) do
                    local replicator = tower:FindFirstChild("TowerReplicator")
                    if replicator then
                        local ownerId = replicator:GetAttribute("OwnerId")
                        local ownerName = replicator:GetAttribute("OwnerName")
                        local towerName = replicator:GetAttribute("Name")
                        local isOwner = (ownerId and ownerId == LocalPlayer.UserId) or (ownerName and ownerName == LocalPlayer.Name)
                        if isOwner and towerName and string.lower(towerName) == "medic" then
                            table.insert(myMedics, tower)
                        end
                    end
                end
            end
            if #myMedics == 0 then task.wait(1) end
        until #myMedics > 0 or not Globals.AutoMedic

        if not Globals.AutoMedic then
            Globals.AutoMedicRunning = false
            return
        end

        if not Globals.AutoMedicLib then
            local success, loadedLib = pcall(function()
                return loadstring(game:HttpGet("https://raw.githubusercontent.com/YeetML/tds/refs/heads/main/AutoMedic"))()
            end)
            if success and loadedLib then
                Globals.AutoMedicLib = loadedLib
            else
                Globals.AutoMedicRunning = false
                return
            end
        end

        local target = "universal"
        local mode = "universal"
        if Globals.MedicTarget == "Self" then
            target = LocalPlayer.UserId
            mode = "self"
        elseif Globals.MedicTarget == "Self First" then
            target = LocalPlayer.UserId
            mode = "self_first"
        end
        Globals.AutoMedicLib.Chain(target, Globals.Towerslot or {}, true, mode)
    end)
end

function StartBountyChain()
    Globals.AutoBountyRunning = true
    task.spawn(function()
        local myKingpins = {}
        repeat
            myKingpins = {}
            local towersFolder = workspace:FindFirstChild("Towers")
            if towersFolder then
                for _, tower in ipairs(towersFolder:GetChildren()) do
                    local replicator = tower:FindFirstChild("TowerReplicator")
                    if replicator then
                        local ownerId = replicator:GetAttribute("OwnerId")
                        local ownerName = replicator:GetAttribute("OwnerName")
                        local towerName = replicator:GetAttribute("Name")
                        local pathAttr = replicator:GetAttribute("Path")
                        local isOwner = (ownerId and ownerId == LocalPlayer.UserId) or (ownerName and ownerName == LocalPlayer.Name)
                        if isOwner and towerName and string.lower(towerName) == "evolvedkingpin" and pathAttr == 1 then
                            table.insert(myKingpins, tower)
                        end
                    end
                end
            end
            if #myKingpins == 0 then task.wait(1) end
        until #myKingpins > 0 or not Globals.AutoBounty

        if not Globals.AutoBounty then
            Globals.AutoBountyRunning = false
            return
        end

        if not Globals.AutoBountyLib then
            local success, loadedLib = pcall(function()
                return loadstring(game:HttpGet("https://raw.githubusercontent.com/YeetML/tds/refs/heads/main/AutoBounty"))()
            end)
            if success and loadedLib then
                Globals.AutoBountyLib = loadedLib
            else
                Globals.AutoBountyRunning = false
                return
            end
        end
        Globals.AutoBountyLib.Bounty("Universal")
    end)
end

function StartAutoMercenary()
    if not Globals.AutoMercenary and not Globals.AutoMilitary then return end
    if Globals.AutoMercenaryBaseRunning then return end
    Globals.AutoMercenaryBaseRunning = true

    if not Globals.MaxPathDistance or Globals.MaxPathDistance == 0 then
        while not Globals.MaxPathDistance or Globals.MaxPathDistance == 0 do
            CalcLength()
            task.wait(1)
        end
    end
    if Globals.MercenaryPath ~= Globals.MaxPathDistance then
        Globals.MercenaryPath = Globals.MaxPathDistance
        SetSetting("MercenaryPath", Globals.MaxPathDistance)
        if Globals.MercenarySlider then
            Globals.MercenarySlider:SetValue(Globals.MaxPathDistance)
        end
    end

    task.spawn(function()
        while Globals.AutoMercenary do
            local TowersFolder = workspace:FindFirstChild("Towers")
            if TowersFolder then
                for _, towers in ipairs(TowersFolder:GetDescendants()) do
                    if towers:IsA("Folder") and towers.Name == "TowerReplicator"
                    and towers:GetAttribute("Name") == "Mercenary Base"
                    and towers:GetAttribute("OwnerId") == game.Players.LocalPlayer.UserId
                    and (towers:GetAttribute("Upgrade") or 0) >= 5 then
                        RemoteFunc:InvokeServer("Troops", "Abilities", "Activate", {
                            Troop = towers.Parent, Name = "Air-Drop",
                            Data = { pathName = 1, directionCFrame = CFrame.new(), dist = Globals.MercenaryPath or 195 }
                        })
                        task.wait(0.5)
                        if not Globals.AutoMercenary then break end
                    end
                end
            end
            task.wait(0.5)
        end
        Globals.AutoMercenaryBaseRunning = false
    end)
end

