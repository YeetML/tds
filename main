function StartAutoSaboteur()
    if Globals.AutoSaboteurRunning or not Globals.AutoSaboteur then return end
    Globals.AutoSaboteurRunning = true
    task.spawn(function()
        while Globals.AutoSaboteur do
            local towersFolder = workspace:FindFirstChild("Towers")
            local npcsFolder = workspace:FindFirstChild("NPCs")
            if not towersFolder or not npcsFolder then
                task.wait(0.5)
                continue
            end

            local saboteurs = {}
            for _, tower in ipairs(towersFolder:GetChildren()) do
                local rep = tower:FindFirstChild("TowerReplicator")
                if rep then
                    local name = rep:GetAttribute("Name")
                    local ownerId = rep:GetAttribute("OwnerId")
                    local upgrade = rep:GetAttribute("Upgrade") or 0
                    if name == "Saboteur" and ownerId == LocalPlayer.UserId and upgrade >= 3 then
                        table.insert(saboteurs, tower)
                    end
                end
            end

            if #saboteurs == 0 then
                task.wait(0.5)
                continue
            end

            local npcPositions = {}
            for _, npc in ipairs(npcsFolder:GetChildren()) do
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                local pos = hrp and hrp.Position
                if not pos then
                    local part = npc:FindFirstChildWhichIsA("BasePart")
                    if part then pos = part.Position end
                end
                if pos then table.insert(npcPositions, pos) end
            end

            if #npcPositions == 0 then
                task.wait(0.5)
                continue
            end

            for _, tower in ipairs(saboteurs) do
                local rep = tower:FindFirstChild("TowerReplicator")
                local towerPos = rep and rep:GetAttribute("Position")
                if typeof(towerPos) ~= "Vector3" then
                    local hrp = tower:FindFirstChild("HumanoidRootPart")
                    towerPos = hrp and hrp.Position
                    if not towerPos then
                        local part = tower:FindFirstChildWhichIsA("BasePart")
                        if part then towerPos = part.Position end
                    end
                end
                if not towerPos then continue end

                local range = rep and (rep:GetAttribute("Range") or rep:GetAttribute("TowerRange") or 16.5) or 16.5
                range = tonumber(range) or 16.5

                local targetPos = nil
                for _, pos in ipairs(npcPositions) do
                    local dx = towerPos.X - pos.X
                    local dz = towerPos.Z - pos.Z
                    if math.sqrt(dx * dx + dz * dz) <= range then
                        targetPos = pos
                        break
                    end
                end

                if targetPos then
                    pcall(function()
                        RemoteFunc:InvokeServer("Troops", "Abilities", "Activate", {
                            Troop = tower, Name = "Aggressive Toxins", Data = { position = targetPos }
                        })
                    end)
                end
            end
            task.wait(0.5)
        end
        Globals.AutoSaboteurRunning = false
    end)
end

