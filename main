    if Globals.StackEnabled then
        if not Globals.StackSphere then
            Globals.StackSphere = Instance.new("Part")
            Globals.StackSphere.Shape = Enum.PartType.Ball
            Globals.StackSphere.Size = Vector3.new(1.5, 1.5, 1.5)
            Globals.StackSphere.Color = Color3.fromRGB(0, 255, 0)
            Globals.StackSphere.Transparency = 0.5
            Globals.StackSphere.Anchored = true
            Globals.StackSphere.CanCollide = false
            Globals.StackSphere.Material = Enum.Material.Neon
            Globals.StackSphere.Parent = workspace
            mouse.TargetFilter = Globals.StackSphere
        end
        local hit = mouse.Hit
        if hit then Globals.StackSphere.Position = hit.Position end
    elseif Globals.StackSphere then
        Globals.StackSphere:Destroy()
        Globals.StackSphere = nil
    end
    UpdatePathVisuals()
end)

