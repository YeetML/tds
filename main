        Callback = function(v) SetSetting("HideUsername", v) UpdatePrivacyState() end
    })
    Settings:Textbox({
        Title = "Streamer Name", Desc = "", Placeholder = "Spoof Name",
        Value = Globals.StreamerName or "", ClearTextOnFocus = false,
