function StartBackToLobby()
    if Globals.GameState ~= "GAME" then return end
    if Globals.BackToLobbyRunning then return end
    Globals.BackToLobbyRunning = true
    task.spawn(function()
        local stateReplicators = ReplicatedStorage:WaitForChild("StateReplicators", 30)
        local gameStateReplicator = stateReplicators and stateReplicators:WaitForChild("GameStateReplicator", 30)
        local voteReplicator = stateReplicators and stateReplicators:WaitForChild("VoteReplicator", 30)
        if not gameStateReplicator or not voteReplicator then
            while true do
                pcall(HandlePostMatch)
                task.wait(1)
            end
            return
        end
        while true do
            local isGameOver = gameStateReplicator:GetAttribute("GameOver") == true
            if isGameOver then
                local health = gameStateReplicator:GetAttribute("Health") or 0
                local isTrial = IsTrial()
                if isTrial then
                    if health > 0 then
                        local rematchRemote = ReplicatedStorage:FindFirstChild("Network")
                            and ReplicatedStorage.Network:FindFirstChild("GameManager")
                            and ReplicatedStorage.Network.GameManager:FindFirstChild("RE:Rematch")
                        if rematchRemote then
                            rematchRemote:FireServer()
                            Globals.Logger:Log("Trial win - Rematching...")
                            task.wait(2)
                        else
                            pcall(HandlePostMatch)
                            break
                        end
                        task.wait(1)
                        continue
                    else
                        pcall(HandlePostMatch)
                        break
                    end
                end
                if isfile("ADS_LastStrat.lua") then
                    pcall(delfile, "ADS_LastStrat.lua")
                end
                pcall(HandlePostMatch)
                break
            end
            task.wait(1)
        end
        Globals.BackToLobbyRunning = false
    end)
end

