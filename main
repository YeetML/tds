            SkillTree = {
                ["Bigger Budget"] = 10, ["Fortify"] = 10, ["Stonks"] = 10, ["Over-Heal"] = 10,
                ["Bandages"] = 10, ["Accelerator"] = 10, ["Enhanced Optics"] = 10, ["Resourcefulness"] = 10,
            }
        }
    }

    local function getCurrentTrial()
        local stateRep = game:GetService("ReplicatedStorage"):FindFirstChild("StateReplicators")
        if stateRep then
            local gameStateRep = stateRep:FindFirstChild("GameStateReplicator")
            if gameStateRep then
                local trial = gameStateRep:GetAttribute("GlobalTrial")
                if trial and trial ~= "" then return trial end
            end
            local trialsRep = stateRep:FindFirstChild("TrialsStateReplicator")
            if trialsRep then
                local trial = trialsRep:GetAttribute("GlobalTrial")
                if trial and trial ~= "" then return trial end
            end
        end
        return nil
    end

    local function getSkillLevels()
        local skills = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("SurfaceGui") and obj.Name == "TileSurfaceGui" then
                local frame = obj:FindFirstChild("Frame")
                if frame then
                    local skillName = frame:FindFirstChild("SkillName")
                    local skillLevel = frame:FindFirstChild("SkillLevel")
                    if skillName and skillLevel then
                        local name = skillName.Text
                        local levelText = skillLevel.Text
                        local current = 0
                        if levelText:find("MAX") then
                            local maxMatch = levelText:match("%[(%d+)%]")
                            if maxMatch then current = tonumber(maxMatch) or 0 end
                        else
                            local parts = {}
                            for part in levelText:gmatch("[^/]+") do
                                table.insert(parts, part)
                            end
                            if #parts == 2 then
                                current = tonumber(parts[1]) or 0
                            end
                        end
                        skills[name] = current
                    end
                end
            end
        end
        return skills
    end

    local function checkSkillRequirements(trialName)
        local config = trialConfigs[trialName]
        if not config or not config.SkillTree or next(config.SkillTree) == nil then
            return true, {}
        end
        local skills = getSkillLevels()
        local missing = {}
        for skillName, requiredLevel in pairs(config.SkillTree) do
            local current = skills[skillName] or 0
            if current < requiredLevel then
                table.insert(missing, string.format("%s (Required: %d, Current: %d)", skillName, requiredLevel, current))
            end
        end
        return #missing == 0, missing
    end

    local function OpenInventory()
        local network = game:GetService("ReplicatedStorage"):FindFirstChild("Network")
        if not network then return false end
        local inventory = network:FindFirstChild("Inventory")
        if not inventory then return false end
        local openRemote = inventory:FindFirstChild("URE:OpenInventory")
        if not openRemote then return false end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg and pg:FindFirstChild("ReactUniversalInventoryView") then
            return true
        end
        openRemote:FireServer()
        task.wait(2)
        return true
    end

    local function GetOwnedTowers()
        local towers = {}
        OpenInventory()
        for attempt = 1, 15 do
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            if pg then
                local inv = pg:FindFirstChild("ReactUniversalInventoryView")
                if inv then
                    local holder = inv:FindFirstChild("Holder")
                    if holder then
                        local windowFrame = holder:FindFirstChild("windowFrame")
                        if windowFrame then
                            local towersFrame = windowFrame:FindFirstChild("towersInventoryFrame")
                            if towersFrame then
                                local towerContainer = towersFrame:FindFirstChild("towerContainer")
                                if towerContainer then
                                    task.wait(0.5)
                                    for _, scroller in ipairs(towerContainer:GetChildren()) do
                                        if string.find(scroller.Name, "scrolling") then
                                            for _, frame in ipairs(scroller:GetChildren()) do
                                                if frame:IsA("Frame") and frame.Name ~= "UIListLayout" then
                                                    local owned = false
                                                    local main = frame:FindFirstChild("main")
                                                    if main then
                                                        local topThing = main:FindFirstChild("topThing")
                                                        if topThing then
                                                            if not topThing.Visible then
                                                                owned = true
                                                            else
                                                                local icon = topThing:FindFirstChild("icon")
                                                                if icon and icon:IsA("ImageLabel") then
                                                                    local image = icon.Image
                                                                    if image ~= "rbxassetid://8418293221" then
                                                                        owned = true
                                                                    end
                                                                else
                                                                    owned = true
                                                                end
                                                            end
                                                        else
                                                            owned = true
                                                        end
                                                    else
                                                        owned = true
                                                    end
                                                    if owned then
                                                        table.insert(towers, frame.Name)
                                                    end
                                                end
                                            end
                                        end
                                    end
                                    return towers
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
        return towers
    end

    local function checkTowerRequirements(trialName)
        local config = trialConfigs[trialName]
        if not config or not config.Towers or #config.Towers == 0 then
            return true, {}
        end
        local owned = GetOwnedTowers()
        local missing = {}
        for _, req in ipairs(config.Towers) do
            if req == "Placeholder" then continue end
            local found = false
            for _, o in ipairs(owned) do
                if o == req then found = true break end
            end
            if not found then table.insert(missing, req) end
        end
        return #missing == 0, missing
    end

    local Trial = Strategies:Label({ Title = "Current Trial: Loading...", Desc = "Required: Loading..." })
    local ReqMet = Strategies:Label({ Title = "Requirements: Checking...", Desc = "" })

    local function updateTrialLabels()
        local trialName = getCurrentTrial() or "No Active Trial"
        pcall(function()
            Trial:SetTitle("Current Trial: " .. tostring(trialName))
            Trial:SetDesc(trialName ~= "No Active Trial" and "See game for requirements" or "None required")
            ReqMet:SetTitle(trialName ~= "No Active Trial" and "Requirements: Met ✓" or "Requirements: N/A")
            ReqMet:SetDesc(trialName ~= "No Active Trial" and "Trial is active." or "No trial currently available.")
        end)
    end

    updateTrialLabels()
    task.spawn(function()
        while true do
            updateTrialLabels()
            task.wait(3)
        end
    end)

    task.spawn(function()
        local rep = game:GetService("ReplicatedStorage"):FindFirstChild("StateReplicators")
        if rep then
            local function onTrialChange() updateTrialLabels() end
            local gameStateRep = rep:FindFirstChild("GameStateReplicator")
            if gameStateRep then
                gameStateRep:GetAttributeChangedSignal("GlobalTrial"):Connect(onTrialChange)
            end
            local trialsRep = rep:FindFirstChild("TrialsStateReplicator")
            if trialsRep then
                trialsRep:GetAttributeChangedSignal("GlobalTrial"):Connect(onTrialChange)
            end
        end
    end)

    Strategies:Toggle({
        Title = "Run Auto Trials",
        Desc = "Checks skills & towers, then starts the trial.",
        Value = Globals.AutoTrials,
        Callback = function(v)
            SetSetting("AutoTrials", v)
            if not v then return end
            task.spawn(function()
                local trialName = getCurrentTrial()
                if not trialName then
                    Globals.Window:Notify({Title = "AutoTrials", Desc = "No active trial found.", Time = 3, Type = "error"})
                    return
                end
                local skillPass, skillMissing = checkSkillRequirements(trialName)
                if not skillPass then
                    Globals.Window:Notify({Title = "AutoTrials", Desc = "Missing skills:\n" .. table.concat(skillMissing, "\n"), Time = 10, Type = "error"})
                    return
                end
                local towerPass, towerMissing = checkTowerRequirements(trialName)
                if not towerPass then
                    Globals.Window:Notify({Title = "AutoTrials", Desc = "Missing towers:\n" .. table.concat(towerMissing, "\n"), Time = 10, Type = "error"})
                    return
                end
                if Globals.GameState == "LOBBY" then
                    if writefile and makefolder then
                        pcall(makefolder, "GlobalConfigs")
                        pcall(writefile, "GlobalConfigs/trialscript.txt", trialName)
                    end
                    RemoteFunc:InvokeServer("Multiplayer", "v2:start", { count = 1, mode = "Trials" })
                    Globals.Window:Notify({Title = "AutoTrials", Desc = "Joined trial for " .. trialName, Time = 3})
                    return
                end
                if Globals.GameState == "GAME" then
                    local savedTrial = nil
                    if isfile then
                        pcall(function()
                            savedTrial = readfile("GlobalConfigs/trialscript.txt")
                        end)
                    end
                    local targetTrial = savedTrial or trialName
                    local trialMap = {
                        ["SpeedyEnemies"] = "Speedy Enemies", ["Speedy Enemies"] = "Speedy Enemies",
                        ["Glass"] = "Glass", ["Quarantine"] = "Quarantine", ["Fog"] = "Fog",
                        ["Limitation"] = "Limitation", ["Flying"] = "Flying", ["Jailed"] = "Jailed",
                        ["ExplodingEnemies"] = "Exploding Enemies", ["Exploding Enemies"] = "Exploding Enemies",
                        ["Inflation"] = "Inflation", ["Committed"] = "Committed",
                        ["Hidden"] = "Hidden", ["HiddenEnemies"] = "Hidden Enemies",
                        ["Hidden Enemies"] = "Hidden Enemies", ["Broke"] = "Broke",
                        ["Healthy"] = "Healthy Enemies", ["HealthyEnemies"] = "Healthy Enemies",
                        ["Healthy Enemies"] = "Healthy Enemies",
                    }
                    local mapped = trialMap[targetTrial] or targetTrial
                    local scriptUrl = trialScripts[mapped]
                    if not scriptUrl then
                        Globals.Window:Notify({Title = "AutoTrials", Desc = "No strategy for " .. targetTrial, Time = 3, Type = "error"})
                        return
                    end
                    task.wait(2)
                    local ok, err = pcall(function()
                        local chunk = game:HttpGet(scriptUrl)
                        chunk = "local TDS = shared.TDSTable or _G.TDS or error('TDS not found')\n" .. chunk
                        local fn = loadstring(chunk)
                        if fn then fn() end
                    end)
                    if ok then
                        Globals.Window:Notify({Title = "AutoTrials", Desc = "Running strategy for " .. targetTrial, Time = 3})
                    else
                        Globals.Window:Notify({Title = "AutoTrials", Desc = "Failed to load strategy.", Time = 3, Type = "error"})
                    end
                end
            end)
        end
    })
end

Globals.Window:Line()

