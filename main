function StartSellFarm()
    if Globals.SellFarmsRunning or not Globals.SellFarms then return end
    if Globals.GameState ~= "GAME" then return end
    Globals.SellFarmsRunning = true
    task.spawn(function()
        local soldThisSession = {}
        while Globals.SellFarms do
            local CurrentWave = GetCurrentWave()
            local target = Globals.SellFarmsWave or 1
            if CurrentWave >= target then
                local TowersFolder = workspace:FindFirstChild("Towers")
                if TowersFolder then
                    local pending = {}
                    for _, rep in ipairs(TowersFolder:GetDescendants()) do
                        if rep:IsA("Folder") and rep.Name == "TowerReplicator" then
                            local name = rep:GetAttribute("Name")
                            local owner = rep:GetAttribute("OwnerId")
                            local uid = rep:GetAttribute("UID")
                            if name == "Farm" and owner == LocalPlayer.UserId
                            and not (uid and soldThisSession[uid]) then
                                table.insert(pending, { Model = rep.Parent, UID = uid })
                            end
                        end
                    end
                    for _, entry in ipairs(pending) do
                        if not Globals.SellFarms then break end
                        if entry.Model and entry.Model.Parent then
                            local sold = false
                            for attempt = 1, 3 do
                                local ok, res = pcall(function()
                                    return RemoteFunc:InvokeServer("Troops", "Sell", { Troop = entry.Model })
                                end)
                                if ok and CheckResOk(res) then
                                    sold = true
                                    break
                                end
                                task.wait(0.25)
                            end
                            if sold and entry.UID then
                                soldThisSession[entry.UID] = true
                            end
                            task.wait(0.15 + math.random() * 0.15)
                        end
                    end
                end
            end
            task.wait(1)
        end
        Globals.SellFarmsRunning = false
    end)
end

