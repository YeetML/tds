        end
        C.Globals.activeStrategyThread = task.spawn(function()
            C.Globals.tdsReplaying = true
            pcall(function()
                loadstring(readfile("ADS_LastStrat.lua"))()
            end)
            C.Globals.tdsReplaying = false
            C.Globals.activeStrategyThread = nil
        end)
    end

    function TDS:Addons()
        if C.GameState == "LOBBY" then return false end
        if C.Flag.PremiumLoaded then return true end

        if C.Flag.IsCurrentlyLoading then
            while C.Flag.IsCurrentlyLoading do task.wait(0.1) end
            return C.Flag.PremiumLoaded
        end

        local originalPlace = self.Place
        C.Flag.IsCurrentlyLoading = true

        local url = "https://api.jnkie.com/api/v1/luascripts/public/57fe397f76043ce06afad24f07528c9f93e97730930242f57134d0b60a2d250b/download"
        local ok, code = pcall(game.HttpGet, game, url)
        if not ok or not code then
            C.Flag.IsCurrentlyLoading = false
            return false
        end

        local func = loadstring(code)
        if not func then
            C.Flag.IsCurrentlyLoading = false
            return false
        end

        pcall(func)

        while self.Place == originalPlace do task.wait(0.1) end

        C.Flag.PremiumLoaded     = true
        C.Flag.IsCurrentlyLoading = false
        return true
    end

    function TDS:Mode(difficulty, code)
        self.SavedDifficulty = difficulty
        local targetCode = ""

        if IsMobile then
            if (code and code ~= "") or (C.Globals.PrivateCode and C.Globals.PrivateCode ~= "") then
                C.Window:Notify({
                    Title = "Warning",
                    Desc  = "Private server codes are not supported on mobile devices.",
                    Time  = 25,
                    Type  = "error",
                })
            end
        else
            if code and code ~= "" then
                targetCode = code
            elseif C.Globals.PrivateCode then
                targetCode = C.Globals.PrivateCode
            end
        end

        self.PrivateCode = tostring(targetCode)

        if C.GameState ~= "LOBBY" then return false end

        if targetCode ~= "" and not MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, 10518590) then
            local serverType = game:GetService("RobloxReplicatedStorage").GetServerType:InvokeServer()
            if serverType ~= "VIPServer" then
                game:GetService("ExperienceService"):LaunchExperience({
                    placeId  = game.PlaceId,
                    linkCode = tostring(targetCode),
                })
                return true
            end
        end

        if difficulty == "Trial" then
            local elevators = workspace:WaitForChild("TrialElevators")
            local network   = ReplicatedStorage:WaitForChild("Network")
            if elevators and network then
                local target
                repeat
                    for _, v in pairs(elevators:GetChildren()) do
                        if v.Name:match("Elevator") then target = v; break end
                    end
                    if not target then task.wait(0.5) end
                until target

                task.spawn(function()
                    local en = network:WaitForChild("Elevators")
                    local enter = en:WaitForChild("RF:Enter")
                    local setSize = en:WaitForChild("RF:SetSize")
                    local setReady = en:WaitForChild("RF:SetReady")
                    pcall(function() enter:InvokeServer(target) end)
                    pcall(function() setSize:InvokeServer(1) end)
                    pcall(function() setReady:InvokeServer(true) end)
                end)
                return true
            end
        end

        local hud   = PlayerGui:WaitForChild("ReactLobbyHud", 30)
        local frame = hud and hud:WaitForChild("Frame", 30)
        local mm    = frame and frame:WaitForChild("matchmaking", 30)

        if mm then
            local success = false
            repeat
                local ok, result = pcall(function()
                    local mode = self.MatchmakingMap[difficulty]
                    local payload
                    if difficulty == "Hardcore" then
                        payload = { mode = "hardcore", difficulty = "Easy", count = 1 }
                    elseif difficulty == "Voidcore" then
                        payload = { mode = "hardcore", difficulty = "Hard", count = 1 }
                    elseif mode then
                        payload = { mode = mode, count = 1 }
                        if difficulty:match("Ducky") then
                            payload.difficulty = difficulty:gsub("Ducky", "")
                        end
                    else
                        payload = { difficulty = difficulty, mode = "survival", count = 1 }
                    end
                    return C.RemoteFunc:InvokeServer("Multiplayer", "v2:start", payload)
                end)
                if ok and C.Fn.CheckResOk(result) then
                    success = true
                else
                    task.wait(0.5)
                end
            until success
        end

        return true
    end

    function TDS:Loadout(...)
        if C.GameState ~= "GAME" then return end
        local towers = {...}
        local StateRep = ReplicatedStorage:FindFirstChild("StateReplicators")
        local equipped = {}

        if StateRep then
            for _, folder in ipairs(StateRep:GetChildren()) do
                if folder.Name == "PlayerReplicator"
                    and folder:GetAttribute("UserId") == LocalPlayer.UserId
                then
                    local ea = folder:GetAttribute("EquippedTowers")
                    if type(ea) == "string" then
                        local clean = ea:match("%[.*%]")
                        local ok, tbl = pcall(function()
                            return HttpService:JSONDecode(clean)
                        end)
                        if ok and type(tbl) == "table" then equipped = tbl end
                    end
                end
            end
        end

        for _, t in ipairs(equipped) do
            if t ~= "None" then
                local done = false
                repeat
                    local ok = pcall(function()
                        C.RemoteEvent:FireServer("Inventory", "Unequip", "Tower", t)
                        task.wait(0.3)
                    end)
                    if ok then done = true else task.wait(0.2) end
                until done
            end
        end
        task.wait(0.5)

        for _, t in ipairs(towers) do
            if t and t ~= "" then
                local done = false
                repeat
                    local ok = pcall(function()
                        C.RemoteEvent:FireServer("Inventory", "Equip", "Tower", t)
                        C.Logger and C.Logger:Log("Equipped tower: " .. t)
                        task.wait(0.3)
                    end)
                    if ok then done = true else task.wait(0.2) end
                until done
            end
        end
        task.wait(0.5)
        return true
    end

    function TDS:VoteSkip(startWave, endWave)
        task.spawn(function()
            local curWave = C.Fn.GetCurrentWave()
            self.LastVoteSkipTarget = self.LastVoteSkipTarget or 0

            if not startWave then
                if self.LastVoteSkipTarget < curWave then
                    self.LastVoteSkipTarget = curWave
                else
                    self.LastVoteSkipTarget = self.LastVoteSkipTarget + 1
                end
                startWave = self.LastVoteSkipTarget
                endWave   = startWave
            else
                endWave = endWave or startWave
                self.LastVoteSkipTarget = endWave
            end

            for wave = startWave, endWave do
                while C.Fn.GetCurrentWave() < wave do task.wait(1) end
                local targetNext = wave + 1
                while C.Fn.GetCurrentWave() < targetNext do
                    local voteUi = PlayerGui:FindFirstChild("ReactOverridesVote")
                    local voteBtn = voteUi and voteUi:FindFirstChild("Frame")
                        and voteUi.Frame:FindFirstChild("votes")
                        and voteUi.Frame.votes:FindFirstChild("vote", true)
                    if voteBtn and voteBtn.Position == UDim2.new(0.5, 0, 0.5, 0) then
                        pcall(function()
                            C.RemoteFunc:InvokeServer("Voting", "Skip")
                        end)
                    end
                    task.wait(0.5)
                end
                C.Logger and C.Logger:Log("Successfully skipped wave " .. wave)
            end
        end)
    end

    function TDS:GameInfo(name, list)
        if C.GameState ~= "GAME" then return false end

        local voteGui = PlayerGui:WaitForChild("ReactGameIntermission", 30)
        if not (voteGui and voteGui.Enabled and voteGui:WaitForChild("Frame", 5)) then return end

        local mods = (list and next(list)) and list or C.Globals.Modifiers
        C.Fn.CastModifierVote(mods)

        local sr = ReplicatedStorage:WaitForChild("StateReplicators", 5)
        local gsRep = sr and sr:FindFirstChild("GameStateReplicator")

        if MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, 10518590)
            or (gsRep and gsRep:GetAttribute("IsPrivateServer") == true)
        then
            C.Fn.SelectMapOverride(name, "vip")
            C.Logger and C.Logger:Log("Selected map: " .. name)
            repeat task.wait(1) until PlayerGui:FindFirstChild("ReactUniversalHotbar")
            return true
        elseif C.Fn.IsMapAvailable(name) then
            C.Fn.SelectMapOverride(name)
            repeat task.wait(1) until PlayerGui:FindFirstChild("ReactUniversalHotbar")
            return true
        else
            C.Logger and C.Logger:Log("Map '" .. name .. "' not available, rejoining...")
            C.Fn.RejoinMatch()
            repeat task.wait(9999) until false
        end
    end

    function TDS:UnlockTimeScale()  C.Fn.UnlockSpeedTickets()  end
    function TDS:TimeScale(val)     C.Fn.SetGameTimescale(val) end
    function TDS:StartGame()        C.Fn.LobbyReadyUp()        end
    function TDS:Ready()
        if C.GameState ~= "GAME" then return false end
        C.Fn.MatchReadyUp()
    end
    function TDS:GetWave() return C.Fn.GetCurrentWave() end
    function TDS:WaitForWave(w)
        if C.GameState ~= "GAME" then return false end
        while self:GetWave() < w do task.wait(0.5) end
        return true
    end
    function TDS:RestartGame() C.Fn.TriggerRestart() end

    function TDS:Place(tname, px, py, pz, ...)
        local args = {...}
        local isStacking = args[#args] == "stack" or args[#args] == true

        if isStacking and not C.Flag.PremiumLoaded and C.GameState == "GAME" then
            C.Window:Notify({
                Title = "ADS",
                Desc  = "Stacking requires Premium. Automatically loading key system...",
                Time  = 3,
                Type  = "normal",
            })
            self:Addons()
            return self:Place(tname, px, py, pz, table.unpack(args))
        end

        if C.GameState ~= "GAME" then return false end

        local existing = {}
        for _, child in ipairs(workspace.Towers:GetChildren()) do
            for _, sub in ipairs(child:GetChildren()) do
                if sub.Name == "Owner" and sub.Value == LocalPlayer.UserId then
                    existing[child] = true
                    break
                end
            end
        end

        C.Fn.DoPlaceTower(tname, Vector3.new(px, py, pz), table.unpack(args))

        local newT
        repeat
            for _, child in ipairs(workspace.Towers:GetChildren()) do
                if not existing[child] then
                    for _, sub in ipairs(child:GetChildren()) do
                        if sub.Name == "Owner" and sub.Value == LocalPlayer.UserId then
                            newT = child
                            break
                        end
                    end
                end
                if newT then break end
            end
            task.wait(0.05)
        until newT

        table.insert(self.PlacedTowers, newT)
        return #self.PlacedTowers
    end

    function TDS:Upgrade(idx, pId)
        local t = self.PlacedTowers[idx]
        if t then
            C.Fn.DoUpgradeTower(t, pId or 1)
            C.Logger and C.Logger:Log("Upgrading tower index: " .. idx)
            C.UpgradeHistory[idx] = (C.UpgradeHistory[idx] or 0) + 1
        end
    end

    function TDS:SetTarget(idx, targetType, reqWave)
        if reqWave then repeat task.wait(0.5) until C.Fn.GetCurrentWave() >= reqWave end
        local t = self.PlacedTowers[idx]
        if not t then return end
        pcall(function()
            C.RemoteFunc:InvokeServer("Troops", "Target", "Set", {
                Troop  = t,
                Target = targetType,
            })
            C.Logger and C.Logger:Log("Set target for tower index " .. idx .. " to " .. targetType)
        end)
    end

    function TDS:Sell(idx, reqWave)
        if reqWave then repeat task.wait(0.5) until C.Fn.GetCurrentWave() >= reqWave end
        local t = self.PlacedTowers[idx]
        if t and C.Fn.DoSellTower(t) then return true end
        return false
    end

    function TDS:SellAll(reqWave)
        task.spawn(function()
            if reqWave then repeat task.wait(0.5) until C.Fn.GetCurrentWave() >= reqWave end
            local copy = {table.unpack(self.PlacedTowers)}
            for _, t in ipairs(copy) do
                if C.Fn.DoSellTower(t) then
                    for i, orig in ipairs(self.PlacedTowers) do
                        if orig == t then
                            table.remove(self.PlacedTowers, i)
                            break
                        end
                    end
                end
            end
            return true
        end)
    end

    function TDS:Ability(idx, name, data, loop)
        local t = self.PlacedTowers[idx]
        if not t then return false end
        C.Logger and C.Logger:Log("Activating ability '" .. name .. "' for tower index: " .. idx)
        return C.Fn.DoActivateAbility(t, name, data, loop)
    end

    function TDS:AutoChain(...)
        local indices = {...}
        if #indices == 0 then return end
        local running = true

        task.spawn(function()
            local i = 1
            while running do
                local idx = indices[i]
                local tower = C.TDS.PlacedTowers[idx]
                if tower then
                    C.Fn.DoActivateAbility(tower, "Call Of Arms")
                end

                local hotbar = PlayerGui.ReactUniversalHotbar.Frame
                local ts = hotbar:FindFirstChild("timescale")
                if ts then
                    if ts:FindFirstChild("Lock") then task.wait(10.5)
                    else task.wait(5.5) end
                else
                    task.wait(10.5)
                end

                i = i + 1
                if i > #indices then i = 1 end
            end
        end)

        return function() running = false end
    end

    function TDS:SetOption(idx, name, val, reqWave)
        local t = self.PlacedTowers[idx]
        if t then
            C.Logger and C.Logger:Log("Setting option '" .. name .. "' for tower index: " .. idx)
            return C.Fn.DoSetOption(t, name, val, reqWave)
        end
        return false
    end

    function TDS:MedicSelect(idx, val)
        local t = self.PlacedTowers[idx]
        local target = self.PlacedTowers[val]
        if t and target then
            C.Logger and C.Logger:Log("Medic: " .. idx .. " -> " .. val)
            C.RemoteFunc:InvokeServer("Troops", "TowerServerEvent", "ToggleSelectedTower", t, target)
            return true
        end
        return false
    end

    function TDS:RemoveIndex()
        self.PlacedTowers    = {}
        self.PlacedTraps     = {}
        self.MapInteractions = {}
        table.clear(C.UpgradeHistory)
        C.Logger and C.Logger:Log("CLEARED EVERYTHING: indexes, upgrade histories, execution loops reset.")
    end

    function TDS:Rejoin() C.Fn.SmartTeleportToLobby() end

    -- ─── Strategy recorder wrapper ──────────────────────────────────────────
    C.Fn.strategyRecordingSetup = function()
        local originalMethods = {}
        local recordable = {
            "Mode","Place","Upgrade","SetTarget","Sell","SellAll","Ability",
            "SetOption","MedicSelect","Ready","VoteSkip","WaitForWave",
            "UnlockTimeScale","TimeScale",
        }

        for _, methodName in ipairs(recordable) do
            originalMethods[methodName] = TDS[methodName]
            TDS[methodName] = function(self, ...)
                if not C.Globals.tdsReplaying and C.GameState == "GAME" then
                    local argumentsList = {...}
                    local stringified = {}
                    for _, v in ipairs(argumentsList) do
                        local t = type(v)
                        if t == "string" then
                            table.insert(stringified, string.format("%q", v))
                        elseif t == "number" or t == "boolean" then
                            table.insert(stringified, tostring(v))
                        elseif t == "table" then
                            local parts = {}
                            for k, val in pairs(v) do
                                local kt = type(k)
                                local fk
                                if kt == "string" then fk = string.format("[%q]", k)
                                elseif kt == "number" then fk = string.format("[%d]", k)
                                else fk = string.format("[%s]", tostring(k)) end
                                local fv = type(val) == "string" and string.format("%q", val) or tostring(val)
                                table.insert(parts, fk .. " = " .. fv)
                            end
                            table.insert(stringified, "{" .. table.concat(parts, ", ") .. "}")
                        else
                            table.insert(stringified, "nil")
                        end
                    end

                    if methodName == "Mode" then
                        C.executed_actions = {}
                    else
                        local line = string.format("TDS:%s(%s)", methodName, table.concat(stringified, ", "))
                        table.insert(C.executed_actions, line)

                        local content = "local TDS = shared.TDSTable or loadstring(game:HttpGet(\"https://raw.githubusercontent.com/DuxiiT/auto-strat/refs/heads/main/Library.lua\"))()\n\n"
                            .. table.concat(C.executed_actions, "\n")
                        writefile("ADS_LastStrat.lua", content)
                    end
                end
                return originalMethods[methodName](self, ...)
            end
        end
    end

    C.Fn.strategyRecordingSetup()

    if C.GameState == "LOBBY" and C.Globals.AutoRejoin and isfile("ADS_LastStrat.lua") then
        pcall(delfile, "ADS_LastStrat.lua")
    end

    if C.GameState == "GAME" and C.Globals.AutoRejoin and isfile("ADS_LastStrat.lua") then
        task.spawn(function()
            task.wait(2)
            TDS:RunStrategy()
        end)
    end
end

