    -- ─── Auto Necro ─────────────────────────────────────────────────────────
    function Jobs.StartAutoNecro()
        if Flag.AutoNecro or not Globals.AutoNecro then return end
        Flag.AutoNecro = true

        local lastActivation = 0

        local function getNecros(towers)
            local list = {}
            if not towers then return list end
            for _, rep in ipairs(towers:GetDescendants()) do
                if rep:IsA("Folder") and rep.Name == "TowerReplicator"
                    and rep:GetAttribute("Name") == "Necromancer"
                    and rep:GetAttribute("OwnerId") == LocalPlayer.UserId
                then
                    list[#list + 1] = rep.Parent
                end
            end
            return list
        end

        local function countGraves(store)
            if not store then return 0 end
            local cnt = 0
            for k, v in pairs(store:GetAttributes()) do
                if type(k) == "string" and #k > 20 then
                    local isDestroy = false
                    if type(v) == "table" then
                        for _, e in pairs(v) do
                            if tostring(e) == "Destroy" then isDestroy = true; break end
                        end
                    elseif tostring(v):find("Destroy") then
                        isDestroy = true
                    end
                    if isDestroy then store:SetAttribute(k, nil) else cnt = cnt + 1 end
                end
            end
            return cnt
        end

        local function pickMaxGraves(rep, store, up)
            local m = rep and rep:GetAttribute("Max_Graves")
            if store then
                local g = store:GetAttribute("Max_Graves")
                if type(g) == "number" and g > 0 then m = g end
            end
            if not m or m < 2 then
                if up >= 4 then m = 9
                elseif up >= 2 then m = 6
                else m = 3 end
            end
            return m
        end

        task.spawn(function()
            local idx = 1
            while Globals.AutoNecro do
                local towers = workspace:FindFirstChild("Towers")
                local necros = getNecros(towers)

                for _, n in ipairs(necros) do
                    local rep = n:FindFirstChild("TowerReplicator")
                    local store = rep and rep:FindFirstChild("GraveStone")
                    if store then countGraves(store) end
                end

                if #necros >= 1 then
                    if idx > #necros then idx = 1 end
                    local cur = necros[idx]
                    local rep = cur:FindFirstChild("TowerReplicator")
                    local up  = rep and (rep:GetAttribute("Upgrade") or 0) or 0
                    local store = rep and rep:FindFirstChild("GraveStone")
                    local maxG = pickMaxGraves(rep, store, up)
                    local cnt  = countGraves(store)
                    local debounce = (rep and rep:GetAttribute("AbilityDebounce")) or 5
                    local now = os.clock()

                    if maxG and cnt >= maxG and (now - lastActivation >= debounce) then
                        local response = RemoteFunc:InvokeServer("Troops", "Abilities", "Activate",
                            {Troop = cur, Name = "Raise The Dead", Data = {}})
                        if response then
                            lastActivation = now
                            idx = idx + 1
                            task.wait(1)
                        else
                            task.wait(0.5)
                        end
                    else
                        task.wait(0.1)
                    end
                else
                    task.wait(1)
                end
            end
            Flag.AutoNecro = false
        end)
    end

