    -- ─── Path helpers ───────────────────────────────────────────────────────
    C.Fn.FindPath = function()
        local MapFolder = workspace:FindFirstChild("Map")
        if not MapFolder then return nil end
        local PathsFolder = MapFolder:FindFirstChild("Paths")
        if not PathsFolder then return nil end
        local PathFolder = PathsFolder:GetChildren()[1]
        if not PathFolder then return nil end

        local nodes = {}
        for _, node in ipairs(PathFolder:GetChildren()) do
            if node:IsA("BasePart") then
                table.insert(nodes, node)
            end
        end

        table.sort(nodes, function(a, b)
            local na = tonumber(a.Name:match("%d+"))
            local nb = tonumber(b.Name:match("%d+"))
            if na and nb then return na < nb end
            return a.Name < b.Name
        end)

        return nodes
    end

    C.Fn.TotalLength = function(nodes)
        local total = 0
        for i = 1, #nodes - 1 do
            total = total + (nodes[i + 1].Position - nodes[i].Position).Magnitude
        end
        return total
    end

    C.Fn.CalcLength = function()
        local map = workspace:FindFirstChild("Map")
        if C.GameState == "GAME" and map then
            local nodes = C.Fn.FindPath()
            if nodes and #nodes > 0 then
                C.MaxPathDistance = C.Fn.TotalLength(nodes)
                if C.MercenarySlider then C.MercenarySlider:SetMax(C.MaxPathDistance) end
                if C.MilitarySlider  then C.MilitarySlider:SetMax(C.MaxPathDistance)  end
                C.MaxLenght = C.MaxPathDistance
                return true
            end
        end
        return false
    end

    C.Fn.GetPointAtDistance = function(nodes, distance)
        if not nodes or #nodes < 2 then return nil end
        local current = 0
        for i = 1, #nodes - 1 do
            local startPos = nodes[i].Position
            local endPos   = nodes[i + 1].Position
            local segLen   = (endPos - startPos).Magnitude
            if current + segLen >= distance then
                local remaining = distance - current
                local dir       = (endPos - startPos).Unit
                return startPos + dir * remaining
            end
            current = current + segLen
        end
        return nodes[#nodes].Position
    end

