-- BLOCK 6 — Watchdog loop
-- ═════════════════════════════════════════════════════════════════════════════
do
    local C       = Ctx
    local Globals = C.Globals
    local Flag    = C.Flag
    local Jobs    = C.Jobs
    local Fn      = C.Fn

    task.spawn(function()
        while true do
            if _G.AutoProgSettings.__locked then
                for k, v in pairs(_G.AutoProgSettings) do
                    if k ~= "__locked" and Globals[k] ~= v then
                        Globals[k] = v
                        print("[AutoProg Lock] Forced " .. k .. " = " .. tostring(v))
                    end
                end
            end

            if Globals.AutoPickups    and not Flag.AutoPickups    then Jobs.StartAutoPickups()    end
            if Globals.AutoSkip       and not Flag.AutoSkip       then Jobs.StartAutoSkip()       end
            if Globals.TimeScaleEnabled and not Flag.TimeScale    then Fn.StartTimeScale()        end
            if Globals.AutoChain      and not Flag.AutoChain      then Jobs.StartAutoChain()      end
            if Globals.AutoDJ         and not Flag.AutoDj         then Jobs.StartAutoDjBooth()    end

            if Globals.RandomDJ then
                if not C.Data.AutoDJ then
                    C.Data.AutoDJ = loadstring(game:HttpGet("https://raw.githubusercontent.com/YeetML/tds/refs/heads/main/AutoDjCustomSongs"))()
                end
                if C.Data.AutoDJ and not C.Data.AutoDJ.IsRunning() then
                    C.Data.AutoDJ.Start()
                end
            elseif C.Data.AutoDJ and C.Data.AutoDJ.IsRunning() then
                C.Data.AutoDJ.Stop()
            end

            if Globals.MuteOtherDJs then
                if not C.Data.AutoDJ then
                    C.Data.AutoDJ = loadstring(game:HttpGet("https://raw.githubusercontent.com/YeetML/tds/refs/heads/main/AutoDjCustomSongs"))()
                end
                if C.Data.AutoDJ and C.Data.AutoDJ.StartMuteOthers then
                    C.Data.AutoDJ.StartMuteOthers()
                end
            end

            if Globals.AutoNecro and not Flag.AutoNecro then Jobs.StartAutoNecro() end

            if Globals.AutoFreezer and not Flag.AutoFreezer then Jobs.StartAutoFreezer()
            elseif not Globals.AutoFreezer and Flag.AutoFreezer then Jobs.StopAutoFreezer() end

            if Globals.AutoSaboteur and not Flag.AutoSaboteur then Jobs.StartAutoSaboteur()
            elseif not Globals.AutoSaboteur and Flag.AutoSaboteur then Jobs.StopAutoSaboteur() end

            if Globals.AutoBrawler and not Flag.AutoBrawler then Jobs.StartAutoBrawler()
            elseif not Globals.AutoBrawler and Flag.AutoBrawler then Jobs.StopAutoBrawler() end

            if Globals.AutoTrials and not Flag.AutoTrials then Jobs.StartAutoTrials()
            elseif not Globals.AutoTrials and Flag.AutoTrials then Jobs.StopAutoTrials() end

            if Globals.AutoMercenary and not Flag.AutoMercenaryBase then Jobs.StartAutoMercenary() end
            if Globals.AutoMilitary  and not Flag.AutoMilitaryBase  then Jobs.StartAutoMilitary()  end
            if Globals.SellFarms     and not Flag.SellFarms         then Jobs.StartSellFarm()      end
            if Globals.AntiLag       and not Flag.AntiLag           then Jobs.StartAntiLag()      end

            if (Globals.AutoRejoin or Globals.AutoRestart) and not Flag.BackToLobby then
                Jobs.StartBackToLobby()
            end

            if Globals.AutoGatling and not Flag.AutoGatling then Jobs.StartAutoGatling() end
            if Globals.Gatlify     and not Flag.Gatlify     then Jobs.StartGatlify()     end
            if Globals.AutoPremium and not Flag.AutoPremium then Jobs.StartAutoPremium() end
            if Globals.AutoOpenCrates and not Flag.AutoOpenCrates then Jobs.StartAutoOpenCrates() end
            if Globals.AutoReady   and not Flag.AutoReady   then Jobs.StartAutoReady()   end
            if Globals.Easy        and not Flag.Easy        then Jobs.StartEasyMode()    end

            if Globals.AutoUpgradeSelected and not Flag.AutoUpgradeSelected
                then Jobs.StartAutoUpgradeSelected() end
            if Globals.AutoUpgradeAll and not Flag.AutoUpgradeAll
                then Jobs.StartAutoUpgradeAll() end

            if Globals.AutoMedic and not Flag.AutoMedic then Jobs.StartMedicChain()
            elseif not Globals.AutoMedic and Flag.AutoMedic then Jobs.StopMedicChain() end

            if Globals.AutoBounty and not Flag.AutoBounty then Jobs.StartBountyChain()
            elseif not Globals.AutoBounty and Flag.AutoBounty then Jobs.StopBountyChain() end

            if Globals.AutoRedeemCodes and not Flag.CodesRedeemed and not Flag.AutoRedeem then
                Fn.redeemCodesFromBeebom()
            end

            task.wait(1)
        end
    end)
end

