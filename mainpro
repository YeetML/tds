    C.Fn.fetchCodesFromBeebom = function()
        local httpRequest = C.SendRequest
        if not httpRequest then
            warn("[CodeRedeemer] No HTTP support – skipping.")
            return {}
        end
        local response = httpRequest({
            Url     = "https://beebom.com/tower-defense-simulator-tds-codes/",
            Method  = "GET",
            Headers = { ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36" },
        })
        if response.StatusCode ~= 200 then
            warn("[CodeRedeemer] Failed to fetch page. Status: " .. tostring(response.StatusCode))
            return {}
        end
        local html  = response.Body or ""
        local codes = {}
        for code in html:gmatch("<strong>([A-Z0-9]+)</strong>") do
            local exists = false
            for _, e in ipairs(codes) do
                if e == code then exists = true; break end
            end
            if not exists then table.insert(codes, code) end
        end
        return codes
    end

