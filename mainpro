    C.Fn.DoActivateAbility = function(obj, name, data, isLooping)
        if type(data) == "boolean" then
            isLooping = data
            data = nil
        end
        data = type(data) == "table" and data or nil

        local positions
        if data and type(data.towerPosition) == "table" then
            positions = data.towerPosition
        end
        local cloneIdx  = data and data.towerToClone
        local targetIdx = data and data.towerTarget

        local function attempt()
            while true do
                local ok, res = pcall(function()
                    local d
                    if data then
                        d = table.clone(data)
                        if positions and #positions > 0 then
                            d.towerPosition = positions[math.random(#positions)]
                        end
                        if type(cloneIdx) == "number" then
                            d.towerToClone = C.TDS.PlacedTowers[cloneIdx]
                        end
                        if type(targetIdx) == "number" then
                            d.towerTarget = C.TDS.PlacedTowers[targetIdx]
                        end
                    end
                    return C.RemoteFunc:InvokeServer("Troops", "Abilities", "Activate", {
                        Troop = obj,
                        Name  = name,
                        Data  = d,
                    })
                end)
                if ok and C.Fn.CheckResOk(res) then return true end
                task.wait(0.25)
            end
        end

        if isLooping then
            local active = true
            task.spawn(function()
                while active do
                    attempt()
                    task.wait(1)
                end
            end)
            return function() active = false end
        end
        return attempt()
    end

