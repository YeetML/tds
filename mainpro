    -- ─── Back to lobby ──────────────────────────────────────────────────────
    function Jobs.StartBackToLobby()
        if GameState ~= "GAME" then return end
        if Flag.BackToLobby then return end
        Flag.BackToLobby = true

        task.spawn(function()
            local sr = ReplicatedStorage:WaitForChild("StateReplicators", 30)
            local gsRep = sr and sr:WaitForChild("GameStateReplicator", 30)
            local voteRep = sr and sr:WaitForChild("VoteReplicator", 30)

            if not gsRep or not voteRep then
                while true do
                    pcall(Fn.HandlePostMatch)
                    task.wait(1)
                end
            end

            while true do
                local isGameOver = gsRep:GetAttribute("GameOver") == true
                if isGameOver then
                    local health = gsRep:GetAttribute("Health") or 0
                    if Fn.IsTrial() then
                        if health > 0 then
                            local rematch = ReplicatedStorage:FindFirstChild("Network")
                                and ReplicatedStorage.Network:FindFirstChild("GameManager")
                                and ReplicatedStorage.Network.GameManager:FindFirstChild("RE:Rematch")
                            if rematch then
                                rematch:FireServer()
                                C.Logger and C.Logger:Log("Trial win - Rematching...")
                                task.wait(2)
                                task.wait(1)
                                continue
                            else
                                C.Logger and C.Logger:Log("Rematch remote not found, falling back to rejoin.")
                                pcall(Fn.HandlePostMatch)
                                break
                            end
                        else
                            C.Logger and C.Logger:Log("Trial loss - Forcing rejoin to lobby...")
                            pcall(Fn.HandlePostMatch)
                            break
                        end
                    end

                    if isfile("ADS_LastStrat.lua") then pcall(delfile, "ADS_LastStrat.lua") end
                    pcall(Fn.HandlePostMatch)
                    break
                end
                task.wait(1)
            end
