    end

    C.Fn.MatchReadyUp = function()
        local sr = ReplicatedStorage:WaitForChild("StateReplicators")
        local voteRep = sr and sr:FindFirstChild("VoteReplicator")
        local gsRep   = sr and sr:FindFirstChild("GameStateReplicator")

        if not voteRep then return end

        if gsRep and gsRep:GetAttribute("GameStarted") == true then
            return
        end

        local voteTitle = voteRep:GetAttribute("Title")
        local voteCount = voteRep:GetAttribute("VoteCount")
        local maxVotes  = voteRep:GetAttribute("MaxVotes")
        if voteTitle ~= "Ready?"
            or (voteCount and maxVotes and maxVotes > 0 and voteCount >= maxVotes)
        then
            return
        end

        if voteRep:GetAttribute("Enabled") == true then
            C.Fn.RunVoteSkip()
            return
        end

        local yieldSignal = Instance.new("BindableEvent")
        local voteConn, gsConn

        voteConn = voteRep.AttributeChanged:Connect(function(attr)
            if attr == "Enabled" and voteRep:GetAttribute("Enabled") == true then
                C.Fn.RunVoteSkip()
                yieldSignal:Fire()
            elseif attr == "Title" and voteRep:GetAttribute("Title") ~= "Ready?" then
                yieldSignal:Fire()
            elseif attr == "VoteCount" or attr == "MaxVotes" then
                local cur = voteRep:GetAttribute("VoteCount")
                local mx  = voteRep:GetAttribute("MaxVotes")
                if cur and mx and mx > 0 and cur >= mx then
                    yieldSignal:Fire()
                end
            end
        end)

        if gsRep then
            gsConn = gsRep:GetAttributeChangedSignal("GameStarted"):Connect(function()
                if gsRep:GetAttribute("GameStarted") == true then
                    yieldSignal:Fire()
                end
            end)
        end

        yieldSignal.Event:Wait()

        voteConn:Disconnect()
        if gsConn then gsConn:Disconnect() end
        yieldSignal:Destroy()
    end

