    -- ─── Auto Gatling (external) ────────────────────────────────────────────
    function Jobs.StartAutoGatling()
        if Flag.AutoGatling or not Globals.AutoGatling then return end
        Flag.AutoGatling = true
        task.spawn(function()
            while Globals.AutoGatling do
                if not Flag.GatlingExecuted then
                    Flag.GatlingExecuted = true
                    task.spawn(function()
                        pcall(function()
                            loadstring(game:HttpGet("https://raw.githubusercontent.com/avtryxz/autogutlin/refs/heads/main/autogutlin.lua"))()
                        end)
                    end)
                end
                task.wait(1)
            end
            Flag.AutoGatling = false
        end)
    end

    -- ─── Gatlify (external) ─────────────────────────────────────────────────
    function Jobs.StartGatlify()
        if Flag.Gatlify or not Globals.Gatlify then return end
        Flag.Gatlify = true
        task.spawn(function()
            while Globals.Gatlify do
                if GameState == "GAME" then
                    if not Flag.GatlifyExecuted then
                        repeat task.wait(0.5) until not Flag.IsCurrentlyLoading
                            and (os.clock() - Flag.LastLoadTime >= 5)
                        if not Globals.Gatlify then break end
                        if not Flag.GatlifyExecuted then
                            Flag.IsCurrentlyLoading = true
                            Flag.GatlifyExecuted    = true
                            pcall(function()
                                loadstring(game:HttpGet("https://raw.githubusercontent.com/avtryxz/Gatlify/refs/heads/main/Gatlify.lua"))()
                            end)
                            Flag.IsCurrentlyLoading = false
                            Flag.LastLoadTime       = os.clock()
                        end
                    end
                else
                    Flag.GatlifyExecuted = false
                end
                task.wait(1)
            end
            Flag.Gatlify = false
        end)
    end

