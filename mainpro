        Flag.AutoReady = true
        task.spawn(function()
            local voteRep = ReplicatedStorage:WaitForChild("StateReplicators")
                :WaitForChild("VoteReplicator")
            repeat task.wait(0.1) until voteRep:GetAttribute("Enabled") == true
                and voteRep:GetAttribute("Title") == "Ready?"
            Fn.RunVoteSkip()
            repeat task.wait(0.1) until voteRep:GetAttribute("Enabled") == false
            Flag.AutoReady = false
        end)
    end

    -- ─── Easy mode ──────────────────────────────────────────────────────────
    function Jobs.StartEasyMode()
        if Flag.Easy or not Globals.Easy then return end
        Flag.Easy = true
        task.spawn(function()
            local content
            while Globals.Easy and content == nil do
                local ok, res = pcall(function()
                    return game:HttpGet("https://raw.githubusercontent.com/DuxiiT/auto-strat/refs/heads/main/Strategies/Easy.lua")
                end)
                if ok and type(res) == "string" then content = res
                else task.wait(1) end
            end

            if content then
                while not (TDS and TDS.Loadout) do task.wait(0.5) end
                local f = loadstring(content)
                if f then
                    pcall(f)
                    C.Window:Notify({Title = "ADS", Desc = "Running...", Time = 3})
                end
            end

            repeat task.wait(2) until not Globals.Easy
                or (GameState == "GAME" and not game:IsLoaded())
            Flag.Easy = false
        end)
    end

    -- ─── Auto DJ song ───────────────────────────────────────────────────────
    function Jobs.AutoSetDJSong()
        if Globals.RandomDJ then return end
        task.spawn(function()
            local ownerId = LocalPlayer.UserId
            local towerNames = {
                "Default","Neon Rave","Neko","Ghost","Plushie",
                "Masquerade","Mako","Garage Band","Ducky","Seal","Gingerbread",
            }
            local songId = Globals.DJCustomSongID
            if not songId or songId == "" then return end
            local fullId = "rbxassetid://" .. songId

            while true do
                local towers = workspace:FindFirstChild("Towers")
                if towers then
                    for _, name in ipairs(towerNames) do
                        local m = towers:FindFirstChild(name)
                        if m then
                            local ownerVal = m:FindFirstChild("Owner")
                            if ownerVal and ownerVal.Value == ownerId then
                                local hrp = m:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    local ap = hrp:FindFirstChild("AudioPlayer")
                                    if ap then
                                        if pcall(function() return ap.AssetId end) then
                                            ap.AssetId = fullId
                                            pcall(function() ap:Play() end)
                                        elseif pcall(function() return ap.SoundId end) then
                                            ap.SoundId = fullId
                                            pcall(function() ap:Play() end)
                                        end
                                        return
                                    end
                                end
                            end
                        end
                    end
                end
                task.wait(1)
            end
        end)
    end

    task.spawn(function()
        local towers = workspace:WaitForChild("Towers", 10)
        if not towers then return end
        Jobs.AutoSetDJSong()
        towers.ChildAdded:Connect(Jobs.AutoSetDJSong)
    end)

