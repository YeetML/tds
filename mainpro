    C.Fn.ApplyTimeScaleOnce = function()
        if not C.Globals.TimeScaleEnabled or C.GameState ~= "GAME" then return end

        local frame = C.Fn.GetTimescaleFrame()
        if not frame or not frame.Visible then return end

        local desired = C.Fn.CoerceTimeScaleValue(C.Globals.TimeScaleValue, 2)
        if not desired then return end

        local lock = frame:FindFirstChild("Lock")
        if lock and lock.Visible then
            if LocalPlayer.TimescaleTickets.Value < 1 then
                if not C.Flag.TimeScaleNoTicketsWarned then
                    C.Logger and C.Logger:Log("No timescale tickets left")
                    C.Flag.TimeScaleNoTicketsWarned = true
                end
                return
            end
            C.Fn.UnlockSpeedTickets()
            task.wait(0.4)
        else
            C.Flag.TimeScaleNoTicketsWarned = false
        end

        C.Fn.SetGameTimescale(desired)
    end

