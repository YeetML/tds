        local PostData = {
            username = "TDS AutoStrat",
            embeds = {{
                title       = (match.Status == "WIN" and "🏆 TRIUMPH" or "💀 DEFEAT"),
                color       = (match.Status == "WIN" and 0x2ecc71 or 0xe74c3c),
                description =
                    "### 📋 Match Overview\n" ..
                    "> **Status:** `" .. match.Status .. "`\n" ..
                    "> **Time:** `"   .. match.Time   .. "`\n" ..
                    "> **Current Level:** `" .. match.Level .. "`\n" ..
                    "> **Wave:** `"  .. match.Wave   .. "`\n",
