    C.Fn.CastModifierVote = function(modsTable)
        local BulkMods = ReplicatedStorage:WaitForChild("Network")
            :WaitForChild("Modifiers")
            :WaitForChild("RF:BulkVoteModifiers")
        local ModRep = ReplicatedStorage:WaitForChild("StateReplicators")
            :FindFirstChild("ModifierReplicator")

        local Available = {}
        if ModRep then
            local raw = ModRep:GetAttribute("Available")
            if type(raw) == "string" then
                local clean = raw:match("{.+}")
                if clean then
                    pcall(function()
                        Available = HttpService:JSONDecode(clean)
                    end)
                end
            end
        end

        local selected = {}
        local missing  = {}

        if modsTable then
            for k, v in pairs(modsTable) do
                local modName = type(k) == "string" and k or v
                if type(modName) == "string" then
                    if Available[modName] == true then
                        selected[modName] = true
                    else
                        table.insert(missing, modName)
                    end
                end
            end
        end

        if #missing > 0 and C.Window then
            C.Window:Notify({
                Title = "ADS",
                Desc  = "Locked (Skipped) modifiers: " .. table.concat(missing, ", "),
                Time  = 50,
                Type  = "error",
            })
        end

        if next(selected) then
            pcall(function()
                BulkMods:InvokeServer(selected)
                C.Logger and C.Logger:Log("Successfully casted modifier votes.")
            end)
        end
    end

    C.Fn.IsMapAvailable = function(name)
        for _, g in ipairs(workspace:GetDescendants()) do
            if g:IsA("SurfaceGui") and g.Name == "MapDisplay" then
                local t = g:FindFirstChild("Title")
                if t and t.Text == name then return true end
            end
        end

        local hasVoted = false
        repeat
            local intermission = PlayerGui:WaitForChild("ReactGameIntermission"):WaitForChild("Frame")
            local vetoValue = intermission.buttons.veto.value
            local vetoText  = vetoValue.Text

            if vetoText ~= "" then
                if not vetoText:find("Veto") then return false end
                local cur, tot = vetoText:match("(%d+)/(%d+)")
                cur, tot = tonumber(cur), tonumber(tot)
                if not hasVoted and tot and tot > 0 and cur == 0 then
                    C.RemoteEvent:FireServer("LobbyVoting", "Veto")
                    hasVoted = true
                end
            end

            local found = false
            for _, g in ipairs(workspace:GetDescendants()) do
                if g:IsA("SurfaceGui") and g.Name == "MapDisplay" then
                    local t = g:FindFirstChild("Title")
                    if t and t.Text == name then found = true; break end
                end
            end

            wait(1)
            local totalPlayers = #C.Players:GetChildren()
            local isFull = vetoText == "Veto (" .. totalPlayers .. "/" .. totalPlayers .. ")"
        until found or isFull

        for _, g in ipairs(workspace:GetDescendants()) do
            if g:IsA("SurfaceGui") and g.Name == "MapDisplay" then
                local t = g:FindFirstChild("Title")
                if t and t.Text == name then return true end
            end
        end
        return false
    end

    C.Fn.SetGameTimescale = function(targetVal)
        if C.GameState ~= "GAME" then return false end

        local speedList = {0, 0.5, 1, 1.5, 2}
        local targetIdx
        for i, v in ipairs(speedList) do
            if v == targetVal then targetIdx = i; break end
        end
        if not targetIdx then return end

        local speedLabel = LocalPlayer.PlayerGui.ReactUniversalHotbar.Frame.timescale.Speed
        local curVal = tonumber(speedLabel.Text:match("x([%d%.]+)"))
        if not curVal then return end

        local curIdx
        for i, v in ipairs(speedList) do
            if v == curVal then curIdx = i; break end
        end
        if not curIdx then return end

        local diff = targetIdx - curIdx
        if diff < 0 then diff = #speedList + diff end

        for _ = 1, diff do
            C.RemoteFunc:InvokeServer("TicketsManager", "CycleTimeScale")
            task.wait(0.5)
        end
    end

