    local easyBtn = CreateModeToggle(208, "Easy", "ForceEasy")
    local frostBtn = CreateModeToggle(234, "Frost", "ForceFrost")
    local hcUnevoBtn = CreateModeToggle(260, "HC Unevo", "ForceHardcoreUnevo")
    local hcEvoBtn = CreateModeToggle(286, "HC Evo", "ForceHardcoreEvo")

    -- Helper to update a mode button
    local function updateModeButton(btn, settingKey)
        if _G.AutoProgSettings[settingKey] then
            btn.Text = btn.Text:gsub(": OFF", ": ON")
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
        else
            btn.Text = btn.Text:gsub(": ON", ": OFF")
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        end
    end

    -- Save settings
    local function saveSettings()
        if writefile then
            local saveData = {
                AutoProgressionEnabled = _G.AutoProgSettings.AutoProgressionEnabled,
                ForceEasy = _G.AutoProgSettings.ForceEasy,
                ForceFrost = _G.AutoProgSettings.ForceFrost,
                ForceHardcoreUnevo = _G.AutoProgSettings.ForceHardcoreUnevo,
                ForceHardcoreEvo = _G.AutoProgSettings.ForceHardcoreEvo,
            }
            writefile(SETTINGS_FILE, HttpService:JSONEncode(saveData))
        end
    end

    -- Update main UI
    local function updateMainUI()
        local anyForceOn = _G.AutoProgSettings.ForceEasy or
                           _G.AutoProgSettings.ForceFrost or
                           _G.AutoProgSettings.ForceHardcoreUnevo or
                           _G.AutoProgSettings.ForceHardcoreEvo

        local isRunning = AutoProgressionEnabled or anyForceOn

        if isRunning then
            toggle.Text = "ON"
            toggle.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
            if anyForceOn then
                title.Text = "Auto Progression (Forced)"
                if statusDisplay.Text:find("Status: Idle") or statusDisplay.Text:find("Status: Stopped") then
                    statusDisplay.Text = "Status: Forcing Mode"
                end
            else
                title.Text = "Auto Progression Running"
                if statusDisplay.Text:find("Status: Idle") or statusDisplay.Text:find("Status: Stopped") then
                    statusDisplay.Text = "Status: Running..."
                end
            end
        else
            toggle.Text = "OFF"
            toggle.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
            title.Text = "Auto Progression OFF"
            statusDisplay.Text = "Status: Stopped"
        end
    end

    -- Force toggle handler (mutual exclusivity)
    local function toggleMode(settingKey, btn)
        -- NEW: clear the cross-script "active" flags whenever a force mode is switched. This
        -- signals any currently-running hardcoreevo/hardcoreunevo loop to stop cleanly (see the
        -- stop-check added to hardcoreevo's loop), and guarantees RunHardcoreEvo/Unevo's guard
        -- won't block the fresh run we're about to trigger below.
        getgenv().HcEvoActive = false
        getgenv().HcUnevoActive = false

        local forceKeys = {"ForceEasy", "ForceFrost", "ForceHardcoreUnevo", "ForceHardcoreEvo"}
        for _, key in ipairs(forceKeys) do
            if key ~= settingKey then
                _G.AutoProgSettings[key] = false
            end
        end

        _G.AutoProgSettings[settingKey] = not _G.AutoProgSettings[settingKey]

        updateModeButton(easyBtn, "ForceEasy")
        updateModeButton(frostBtn, "ForceFrost")
        updateModeButton(hcUnevoBtn, "ForceHardcoreUnevo")
        updateModeButton(hcEvoBtn, "ForceHardcoreEvo")

        if _G.AutoProgSettings[settingKey] then
            AutoProgressionEnabled = true
            _G.AutoProgSettings.AutoProgressionEnabled = true
            updateMainUI()
            saveSettings()
            task.spawn(RunAutoProgression)
        else
            updateMainUI()
            saveSettings()
        end
    end

    -- Main toggle click
    toggle.MouseButton1Click:Connect(function()
        AutoProgressionEnabled = not AutoProgressionEnabled
        _G.AutoProgSettings.AutoProgressionEnabled = AutoProgressionEnabled

        if not AutoProgressionEnabled then
            _G.AutoProgSettings.ForceEasy = false
            _G.AutoProgSettings.ForceFrost = false
            _G.AutoProgSettings.ForceHardcoreUnevo = false
            _G.AutoProgSettings.ForceHardcoreEvo = false
            -- NEW: stop signal for any active hardcore loop
            getgenv().HcEvoActive = false
            getgenv().HcUnevoActive = false
            updateModeButton(easyBtn, "ForceEasy")
            updateModeButton(frostBtn, "ForceFrost")
            updateModeButton(hcUnevoBtn, "ForceHardcoreUnevo")
            updateModeButton(hcEvoBtn, "ForceHardcoreEvo")
            SetStatus("Stopped")
        else
            SetStatus("Starting...")
        end

        updateMainUI()
        saveSettings()

        if AutoProgressionEnabled then
            task.spawn(RunAutoProgression)
        else
            _G.AutoProgSettings.__locked = false
        end
    end)

    -- Mode button clicks
    easyBtn.MouseButton1Click:Connect(function() toggleMode("ForceEasy", easyBtn) end)
    frostBtn.MouseButton1Click:Connect(function() toggleMode("ForceFrost", frostBtn) end)
    hcUnevoBtn.MouseButton1Click:Connect(function() toggleMode("ForceHardcoreUnevo", hcUnevoBtn) end)
    hcEvoBtn.MouseButton1Click:Connect(function() toggleMode("ForceHardcoreEvo", hcEvoBtn) end)

    -- Load saved state
    if isfile and isfile(SETTINGS_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(SETTINGS_FILE))
        end)
        if success and type(data) == "table" then
            for k, v in pairs(data) do
                _G.AutoProgSettings[k] = v
            end
        end
    end

    -- NEW: belt-and-suspenders — even if a saved file (old or from elsewhere) had these keys
    -- set true, force them back off right after loading. saveSettings() below never writes
    -- these two keys either, so they can't get re-persisted from this script.
    _G.AutoProgSettings.AutoUpgradeSelected = false
    _G.AutoProgSettings.AutoUpgradeAll = false
    getgenv().AutoUpgradeSelected = false
    getgenv().AutoUpgradeAll = false

    AutoProgressionEnabled = _G.AutoProgSettings.AutoProgressionEnabled or false
    local anyForceOn = _G.AutoProgSettings.ForceEasy or
                       _G.AutoProgSettings.ForceFrost or
                       _G.AutoProgSettings.ForceHardcoreUnevo or
                       _G.AutoProgSettings.ForceHardcoreEvo
    if anyForceOn then
        AutoProgressionEnabled = true
        _G.AutoProgSettings.AutoProgressionEnabled = true
    end

    updateMainUI()
    updateModeButton(easyBtn, "ForceEasy")
    updateModeButton(frostBtn, "ForceFrost")
    updateModeButton(hcUnevoBtn, "ForceHardcoreUnevo")
    updateModeButton(hcEvoBtn, "ForceHardcoreEvo")

    if AutoProgressionEnabled then
        -- NOTE: this fires on every UI recreation (e.g. from the recovery loop below). It's now
        -- safe even if a hardcoreevo/hardcoreunevo match loop is still active, because
        -- RunHardcoreEvo()/RunHardcoreUnevo() will see HcEvoActive/HcUnevoActive == true and
        -- bail out instead of loading a duplicate copy.
        task.spawn(RunAutoProgression)
    end

    -- Dragging
    local dragging = false
    local dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                       startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Update stats every second
    task.spawn(function()
        while task.wait(1) do
            local level = GetStat("Level")
            local coins = GetStat("Coins")
            local gems = GetStat("Gems")
            levelDisplay.Text = "Level: " .. tostring(level)
            coinsDisplay.Text = "Coins: " .. tostring(coins)
            gemsDisplay.Text = "Gems: " .. tostring(gems)
        end
    end)

    return {
        title = title,
        status = statusDisplay,
        toggle = toggle,
        levelDisplay = levelDisplay,
        coinsDisplay = coinsDisplay,
        gemsDisplay = gemsDisplay,
        easyBtn = easyBtn,
        frostBtn = frostBtn,
        hcUnevoBtn = hcUnevoBtn,
        hcEvoBtn = hcEvoBtn,
    }
end

