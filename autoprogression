local function fetchCodesFromBeebom()
    local httpRequest = syn and syn.request or http and http.request or request
    if not httpRequest then
        warn("[CodeRedeemer] No HTTP support – skipping.")
        return {}
    end
    local response = httpRequest({
        Url = "https://beebom.com/tower-defense-simulator-tds-codes/",
        Method = "GET",
        Headers = {
            ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        }
    })
    if response.StatusCode ~= 200 then
        warn("[CodeRedeemer] Failed to fetch page. Status: " .. tostring(response.StatusCode))
        return {}
    end
    local html = response.Body or ""
    local codes = {}
    
    for code in html:gmatch("<strong>([A-Z0-9]+)</strong>") do
        local alreadyExists = false
        for _, existing in ipairs(codes) do
            if existing == code then
                alreadyExists = true
                break
            end
        end
        if not alreadyExists then
            table.insert(codes, code)
        end
    end
    return codes
end

local function ClaimAchievements()
    -- Load the Cache module
    local ok, CacheMod = pcall(require, ReplicatedStorage.Client.Modules.Cache)
    if not ok then return end

    local achCache = CacheMod("Achievements")
    local data = achCache:GetValue()
    if not data then
        achCache:Download()
        local start = os.clock()
        while not achCache:GetValue() and os.clock() - start < 5 do
            task.wait(0.1)
        end
        data = achCache:GetValue()
    end
    if not data then return end

    -- Find claimable achievements
    local claimable = {}
    for name, entry in pairs(data) do
        if type(entry) == "table" and entry.completed == true then
            table.insert(claimable, name)
        end
    end

    if #claimable == 0 then return end

    -- Claim them silently
    local claimFunc = ReplicatedStorage:WaitForChild("Network"):WaitForChild("Achievements"):WaitForChild("RF:Claim")
    for _, name in ipairs(claimable) do
        pcall(function()
            claimFunc:InvokeServer(name)
        end)
        task.wait(0.3)
    end
end

local function redeemCodesFromBeebom()
    print("[CodeRedeemer] Fetching codes from Beebom...")
    SetStatus("Fetching codes from Beebom...")
