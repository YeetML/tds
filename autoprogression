local HISTORY_FILE = "AutoProgressionHistory.json"
local MAX_HISTORY = 100

local function LogDecision(entry)
    if not writefile then return end
    local history = {}
    if isfile(HISTORY_FILE) then
        local success, json = pcall(readfile, HISTORY_FILE)
        if success then
            history = HttpService:JSONDecode(json) or {}
        end
    end
    table.insert(history, entry)
    if #history > MAX_HISTORY then
        table.remove(history, 1)
    end
    pcall(function()
        writefile(HISTORY_FILE, HttpService:JSONEncode(history))
    end)
end

