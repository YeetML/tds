-- ===== HARDCORE UNEVO / EVO HELPERS =====
local function RunHardcoreUnevo()
    -- NEW: guard against a second concurrent load (e.g. UI-recovery re-triggering RunAutoProgression
    -- while a hardcoreunevo match loop is already active in the background)
    if getgenv().HcUnevoActive then
        print("[AutoProgression] Hardcore UNEVO already running, skipping duplicate load.")
        SetStatus("Hardcore UNEVO already running")
        return
    end

    -- NEW: force AutoRejoin off BEFORE the strategy script loads TDS's "main" module. main.lua
    -- reads AutoRejoin once at load time and, if it's true, sets up its own auto-teleport-to-
    -- lobby-on-loss behavior — which fires on the very first loss and overrides hardcoreunevo's
    -- own restart/loss-count logic. Leftover true from a prior Easy/Frost run (they set
    -- autoRejoin = true) or from ApplyStrategySettings will otherwise leak in here.
    getgenv().AutoRejoin = false
    -- NEW: this loadout bypasses ApplyStrategySettings, so force these off here too.
    getgenv().AutoUpgradeSelected = false
    getgenv().AutoUpgradeAll = false

    print("[AutoProgression] Running Hardcore UNEVO strategy")
    SetStatus("Running Hardcore UNEVO strategy...")
    local result = AutoBuyTowers({
        {"Minigunner", 8000},
        {"Boomerang", 300},
    })
    if result == "OK" then
        SetStatus("Loading Hardcore UNEVO strategy...")
        loadstring(game:HttpGet("https://raw.githubusercontent.com/YeetML/tds/refs/heads/main/hardcoreunevo"))()
    else
        print("[AutoProgression] Not enough coins for UNEVO towers, farming Easy.")
        SetStatus("Not enough coins for UNEVO – farming Easy")
        RunYeetEasy()
    end
end

local function RunHardcoreEvo()
    -- NEW: guard against a second concurrent load. Without this, if RunAutoProgression() fires
    -- twice while a hardcoreevo match loop is already running in the background (which can happen
    -- via the UI-recovery loop, or clicking the force toggle twice), you get two independent
    -- 30-loss counters both watching the same match result — each real loss gets counted twice,
    -- so it teleports to lobby after ~15 real losses instead of 30, and looks "broken".
    if getgenv().HcEvoActive then
        print("[AutoProgression] Hardcore EVO already running, skipping duplicate load.")
        SetStatus("Hardcore EVO already running")
        return
    end

    -- NEW: same reasoning as RunHardcoreUnevo above — force AutoRejoin off before "main" loads,
    -- so hardcoreevo's own 30-loss counter/restart logic actually gets to run instead of main.lua
    -- teleporting to lobby on the first loss.
    getgenv().AutoRejoin = false
    -- NEW: this loadout bypasses ApplyStrategySettings, so force these off here too.
    getgenv().AutoUpgradeSelected = false
    getgenv().AutoUpgradeAll = false

    print("[AutoProgression] Running Hardcore EVO strategy")
    SetStatus("Running Hardcore EVO strategy...")
    local result = AutoBuyTowers({
        {"EvolvedOperator", 15000, "Coins", 4500, "Gems"},
        {"EvolvedJuggernaut", 15000, "Coins", 6000, "Gems"},
        {"EvolvedKingpin", 15000, "Coins", 5500, "Gems"},
        {"Ace Pilot", 1500, "Coins"}
    })
    if result == "OK" then
        SetStatus("Loading Hardcore EVO strategy...")
        loadstring(game:HttpGet("https://raw.githubusercontent.com/YeetML/tds/refs/heads/main/hardcoreevo"))()
    else
        print("[AutoProgression] Not enough resources for EVO towers, falling back to UNEVO.")
        SetStatus("Not enough resources for EVO – falling back to UNEVO")
        RunHardcoreUnevo()
    end
end

-- ===== STRATEGY RUNNERS =====
local runningEasy = false
local runningFrost = false
local AutoProgressionRunning = false
local AutoProgressionEnabled = false

local function RunYeetEasy()
    if runningEasy then return end
    runningEasy = true
    getgenv().TimeScaleEnabled = false
    SetStatus("Starting Easy strategy...")

    if not IsInLobby() then
        while true do
            local availableMaps = GetAvailableMaps()
            local availableStrategies = {}
            for _, strategy in ipairs(EasyStrategies) do
                if availableMaps[strategy.mapName] then
                    table.insert(availableStrategies, strategy)
                end
            end

            if #availableStrategies > 0 then
                local chosen = availableStrategies[math.random(1, #availableStrategies)]
                ApplyStrategySettings(chosen)
                task.wait(0.3)
                print("[AutoProgression] Selected Easy: " .. chosen.name .. " on " .. chosen.mapName)
                SetStatus("Loading Easy: " .. chosen.name .. " on " .. chosen.mapName)
                loadstring(game:HttpGet(chosen.url))()
                runningEasy = false
                return
            end

            local vetoInfo = GetVetoInfo()
            if not vetoInfo then
                print("[AutoProgression] Could not read veto text – assuming no vetoes.")
                break
            end

            if vetoInfo.used < vetoInfo.total then
                print("[AutoProgression] Text: Veto (" .. vetoInfo.used .. "/" .. vetoInfo.total .. ") – vetoing.")
                VetoMap()
            else
                print("[AutoProgression] Text: Veto (" .. vetoInfo.used .. "/" .. vetoInfo.total .. ") – no vetoes left.")
                break
            end
        end

        print("[AutoProgression] No Easy maps available. Teleporting to lobby...")
        SetStatus("No Easy maps – teleporting to lobby")
        SmartTeleportToLobby()
    else
        local chosen = EasyStrategies[math.random(1, #EasyStrategies)]
        ApplyStrategySettings(chosen)
        task.wait(0.3)
        print("[AutoProgression] In lobby, selected Easy: " .. chosen.name)
        SetStatus("In lobby – loading Easy: " .. chosen.name)
        loadstring(game:HttpGet(chosen.url))()
    end

    runningEasy = false
end

