    local pass = 0

    while pass < maxPasses do
        pass = pass + 1
        local boughtThisPass = 0

        -- Re-scan every pass so newly unlocked skills appear
        local skillNodes = {}
        for _, child in ipairs(workspace:GetChildren()) do
            local tileGui = child:FindFirstChild("TileSurfaceGui")
            if tileGui then
                local frame = tileGui:FindFirstChild("Frame")
                if frame then
                    local purchaseFrame = frame:FindFirstChild("PurchaseFrame")
                    if purchaseFrame then
                        table.insert(skillNodes, {
                            id = child.Name,
                            purchaseFrame = purchaseFrame,
                        })
                    end
                end
            end
        end

        -- Sort numerically (1 → 2 → 3 ...)
        table.sort(skillNodes, function(a, b)
            local numA = tonumber(a.id) or 999
            local numB = tonumber(b.id) or 999
            return numA < numB
        end)

        print(string.format("[SkillTree] === Pass %d | Found %d skill nodes ===", pass, #skillNodes))

        for _, node in ipairs(skillNodes) do
            local skillId = node.id
            local purchaseFrame = node.purchaseFrame

            -- Only buy if currently unlocked
            if not purchaseFrame.Visible then
                continue
            end

            local innerFrame = purchaseFrame:FindFirstChild("PurchaseFrame")
            local coinsFrame = innerFrame and innerFrame:FindFirstChild("Coins")
            local coinsLabel = coinsFrame and coinsFrame:FindFirstChild("text")

            if not coinsLabel or not coinsLabel:IsA("TextLabel") then
                continue
            end

            local maxAttempts = 40
            local attempts = 0

            while attempts < maxAttempts do
                attempts = attempts + 1

                if not purchaseFrame.Visible then
                    break
                end

                coinsLabel = coinsFrame:FindFirstChild("text")
                if not coinsLabel then break end

                local costText = coinsLabel.Text
                local costString = costText:gsub("[^%d]", "")
                local cost = tonumber(costString)

                if not cost then
                    if costText:upper():find("MAX") or costText == "" or costText == "0" then
                        break
                    else
                        break
                    end
                end

                local coins = GetStat("Coins")
                if coins < cost then
                    print(string.format("[SkillTree] %s – not enough coins (need %d, have %d). Stopping.", skillId, cost, coins))
                    SetStatus("Out of coins for skills")
                    return
                end

                print(string.format("[SkillTree] %s – buying for %d coins (you have %d)", skillId, cost, coins))

                local success, result = pcall(function()
                    return remote:InvokeServer(skillId)
                end)

                if not success then
                    warn(string.format("[SkillTree] %s – purchase failed: %s", skillId, tostring(result)))
                    break
                end

                boughtThisPass = boughtThisPass + 1
                totalBought = totalBought + 1
                task.wait(0.45)

                -- Check if maxed
                coinsLabel = coinsFrame:FindFirstChild("text")
                if coinsLabel and (coinsLabel.Text:upper():find("MAX") or coinsLabel.Text == "" or coinsLabel.Text == "0") then
                    print(string.format("[SkillTree] %s – maxed out.", skillId))
                    break
                end
            end

            task.wait(0.2)
        end

        print(string.format("[SkillTree] Pass %d finished – bought %d levels this pass", pass, boughtThisPass))

        -- Nothing bought this pass → done
        if boughtThisPass == 0 then
            break
        end

        task.wait(0.5) -- allow UI to update newly unlocked skills
    end

    if totalBought > 0 then
        print(string.format("[SkillTree] Finished. Total levels bought: %d", totalBought))
        SetStatus("Skills processed (" .. totalBought .. " levels)")
    else
        print("[SkillTree] No unlocked skills found to buy.")
        SetStatus("No unlocked skills available")
    end
end]]

