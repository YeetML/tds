end

local function APR_IsTrial()
    local rep = APR_GetGameStateReplicator()
    if not rep then return false end
    local t = rep:GetAttribute("GlobalTrial")
    return t and t ~= ""
end

local function APR_IsEasySurvival()
    if APR_IsTrial() then return false end
    local rep = APR_GetGameStateReplicator()
    if not rep then return false end
    return rep:GetAttribute("Difficulty") == "Easy"
