local function BuyTower(towerName)
    SetStatus("Buying " .. towerName .. "...")
    print("Buying " .. towerName)
    local aliases = {
        ["EvolvedOperator"] = "Operator",
        ["EvolvedJuggernaut"] = "Juggernaut",
        ["EvolvedKingpin"] = "Kingpin",
    }
    local function attemptPurchase(name)
        local success, result = pcall(function()
            return RemoteFunc:InvokeServer("Shop", "Purchase", "Tower", name)
        end)
        if success then
            print("Successfully bought " .. name)
            SetStatus("Bought " .. name)
            return true
        else
            print("Failed to buy " .. name .. ": " .. tostring(result))
            SetStatus("Failed to buy " .. name)
            return false
        end
    end
    if attemptPurchase(towerName) then return true end
    local alternate = aliases[towerName]
    if alternate then
        print("Primary failed, trying alternate: " .. alternate)
        SetStatus("Trying alternate: " .. alternate)
        if attemptPurchase(alternate) then return true end
    end
    return false
end

local function GetStat(name)
    local obj = LocalPlayer:FindFirstChild(name)
    if obj and obj.Value ~= nil then return tonumber(obj.Value) or 0 end
    local attr = LocalPlayer:GetAttribute(name)
    if attr ~= nil then return tonumber(attr) or 0 end
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local stat = leaderstats and leaderstats:FindFirstChild(name)
    if stat and stat.Value ~= nil then return tonumber(stat.Value) or 0 end
    return 0
end

local function waitForCache(key, timeoutSec)
    timeoutSec = timeoutSec or 5
    local c = Cache(key)
    local value = c:GetValue()
    if not value then
        c:Download()
        local start = os.clock()
        while not c:GetValue() and os.clock() - start < timeoutSec do
            task.wait(0.1)
        end
        value = c:GetValue()
    end
    return value or {}
end

local function GetOwnedTowersFromCache()
    local troops = waitForCache("Inventory.Troops") or {}
    local owned = {}
    for name in pairs(troops) do owned[name] = true end
    return owned
end

local function OwnsTowerCache(towerName)
    local owned = GetOwnedTowersFromCache()
    return owned[towerName] == true
end

local function GetTowerLevel(towerName)
    local expTable = waitForCache("TowerExp") or {}
    local exp = expTable[towerName] or 0
    local level = TowerExpUtil.getLevel({ TowerExp = expTable }, towerName)
    return level, exp
end

local function IsTowerMaxLevel(towerName)
    local level = GetTowerLevel(towerName)
    return level == 20
end

