local BootCampRunning = false
local function RunBootCamp()
    if BootCampRunning then
        print("[BootCamp] Already running, skipping.")
        return
    end

    local stateReplicators = ReplicatedStorage:FindFirstChild("StateReplicators")
    if not stateReplicators then
        print("[BootCamp] StateReplicators not found – teleporting to lobby.")
        SmartTeleportToLobby()
        return
    end

    local rep = stateReplicators:FindFirstChild("GameStateReplicator")
    if not rep then
        print("[BootCamp] GameStateReplicator not found – teleporting to lobby.")
        SmartTeleportToLobby()
        return
    end

    local difficultyTimeout = os.clock() + 20
    while rep:GetAttribute("Difficulty") == nil and os.clock() < difficultyTimeout do
        task.wait(0.1)
    end

    local difficulty = rep:GetAttribute("Difficulty")
    if difficulty ~= "Chapter0Mission1" then
        print("[BootCamp] Not Boot Camp. Difficulty:", difficulty)
        SetStatus("Not Boot Camp – returning to lobby")
        SmartTeleportToLobby()
        return
    end

    print("[BootCamp] Boot Camp detected – starting automation.")
    SetStatus("Running Boot Camp...")

    BootCampRunning = true

    local NetworkMod = require(ReplicatedStorage.Shared.Modules.Network)
    local GameStateMod = require(ReplicatedStorage.Shared.Modules.GameState)

    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
    local rf = ReplicatedStorage:WaitForChild("RemoteFunction")

    local LOBBY_PLACE_ID = 3260590327
    local SCOUT_POSITION = Vector3.new(43.76766967773437500,-18.74999046325683594,-11.34976959228515625)
    local SNIPER_POSITION = Vector3.new(48.01165008544921875, -13.72033500671386719, 14.51969814300537109)

    local function log(...) end

    local function TeleportToLobbyOnce()
        if game.PlaceId == LOBBY_PLACE_ID then return true end
        local ok, err = pcall(function()
            TeleportService:Teleport(LOBBY_PLACE_ID, LocalPlayer)
        end)
        if not ok then warn("[BootCamp] Teleport failed:", err) end
        return ok
    end

    local function getDialogParts()
        local dialog = PlayerGui:FindFirstChild("ReactOverridesDialog")
        local frame = dialog and dialog:FindFirstChild("Frame")
        local content = frame and frame:FindFirstChild("content")
        local textLabel = content and content:FindFirstChild("dialogRichText")
        return content, textLabel
    end

    local function normalizeDialogText(text)
        text = tostring(text or "")
        text = text:gsub("<.->", "")
        text = text:gsub("%s+", " ")
        text = text:lower()
        return text
    end

    local BLOCKED_DIALOGUES = {
        ["start by placing a scout."] = true,
        ["select the sniper tower."] = true
    }

    local function pressDialogContent(content)
        if not content then return false end
        local ok = pcall(function()
            local connections = getconnections(content.InputBegan)
            local listener = connections and connections[1] and connections[1].Function
            if not listener then return end
            local manager = getupvalues(listener)[1]
            if type(manager) ~= "table" or type(manager._listeners) ~= "table" then return end
            for _, callback in pairs(manager._listeners) do
                if type(callback) == "function" then
                    for _, constant in ipairs(getconstants(callback)) do
                        if constant == "MouseButton1" then
                            callback(content, {
                                UserInputType = Enum.UserInputType.MouseButton1
                            })
                            return
                        end
                    end
                end
            end
        end)
        return ok
    end

    task.spawn(function()
        local lastText = ""
        local lastPressedAt = 0
        while rep.Parent and rep:GetAttribute("GameOver") ~= true do
            local content, textLabel = getDialogParts()
            if content and textLabel then
                local current = normalizeDialogText(textLabel.Text)
                if current ~= "" then
                    if BLOCKED_DIALOGUES[current] then
                        lastText = current
                    else
                        local changed = current ~= lastText
                        local retryReady = os.clock() - lastPressedAt >= 0.75
                        if changed or retryReady then
                            log("Auto pressing dialogue:", textLabel.Text)
                            pressDialogContent(content)
                            lastText = current
                            lastPressedAt = os.clock()
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)

    task.spawn(function()
        while rep.Parent and rep:GetAttribute("GameOver") ~= true do
            local readyPrompt = false
            pcall(function()
                readyPrompt = GameStateMod.Replicator:Get("TutorialReadyPrompt") == true
            end)
            if readyPrompt then
                pcall(function()
                    NetworkMod.Channel("TutorialReady"):FireServer("Ready")
                end)
            end
            task.wait(0.25)
        end
    end)

    task.spawn(function()
        local voteRep = stateReplicators:FindFirstChild("VoteReplicator", 10)
        if not voteRep then return end
        while rep.Parent and rep:GetAttribute("GameOver") ~= true do
            local enabled = voteRep:GetAttribute("Enabled")
            local title = voteRep:GetAttribute("Title")
            if enabled == true and (title == "Ready?" or title == "Skip?") then
                pcall(function()
                    rf:InvokeServer("Voting", "Skip")
                end)
            end
            task.wait(0.35)
        end
    end)

    local function checkSuccess(data)
        if data == true then return true end
        if type(data) == "table" and data.Success == true then return true end
        local ok, isModel = pcall(function() return data and data:IsA("Model") end)
        if ok and isModel then return true end
        return type(data) == "userdata"
    end

    local function getTowerNear(position, towerName)
        local towers = workspace:FindFirstChild("Towers")
        if not towers then return nil end
        local closestTower, closestDistance = nil, math.huge
        for _, tower in ipairs(towers:GetChildren()) do
            local ok, towerPos = pcall(function() return tower:GetPivot().Position end)
            if ok then
                local distance = (towerPos - position).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestTower = tower
                end
            end
        end
        if closestTower and closestDistance <= 4 then
            log("Detected placed tower:", closestTower.Name, "distance:", closestDistance)
            return closestTower
        end
        return nil
    end

    local function pressHotbar(slot)
        local ok, err = pcall(function()
            NetworkMod.Channel("Hotbar"):FireServer("Click", slot)
        end)
        if not ok then warn("[BootCamp] Hotbar " .. slot .. " failed:", err) end
        return ok
    end

    local function placeUntilExists(towerName, position, hotbarSlot)
        log("Trying placement:", towerName, position)
        while rep.Parent and rep:GetAttribute("GameOver") ~= true do
            local existing = getTowerNear(position, towerName)
            if existing then
                log("Placement confirmed:", towerName)
                return existing
            end
            if hotbarSlot then pressHotbar(hotbarSlot) end
            pcall(function()
                rf:InvokeServer("Troops", "Place", {
                    Rotation = CFrame.new(),
                    Position = position
                }, towerName)
            end)
            task.wait(0.2)
            existing = getTowerNear(position, towerName)
            if existing then
                log("Placement confirmed:", towerName)
                return existing
            end
            task.wait(0.1)
        end
        return nil
    end

    local function upgradeUntilSuccess(tower, path)
        if not tower then return false end
        while tower.Parent and rep.Parent and rep:GetAttribute("GameOver") ~= true do
            local ok, result = pcall(function()
                return rf:InvokeServer("Troops", "Upgrade", "Set", {
                    Troop = tower,
                    Path = path or 1
                })
            end)
            if ok and checkSuccess(result) then return true end
            task.wait(0.25)
        end
        return false
    end

    local function getDialogTextLabel()
        local dialog = PlayerGui:FindFirstChild("ReactOverridesDialog")
        local frame = dialog and dialog:FindFirstChild("Frame")
        local content = frame and frame:FindFirstChild("content")
        return content and content:FindFirstChild("dialogRichText") or nil
    end

    local function normalizeText(text)
        text = tostring(text or "")
        text = text:gsub("<.->", "")
        text = text:gsub("%s+", " ")
        text = text:lower()
        return text
    end

    local function waitForDialogText(expectedText, timeoutSeconds)
        local wanted = normalizeText(expectedText)
        local deadline = os.clock() + (timeoutSeconds or 60)
        log("Waiting for dialog:", expectedText)
        while os.clock() < deadline do
            if rep:GetAttribute("GameOver") == true then return false end
            local label = getDialogTextLabel()
            if label then
                local current = normalizeText(label.Text)
                if current == wanted or current:find(wanted, 1, true) then
                    log("Dialog detected:", label.Text)
                    return true
                end
            end
            task.wait(0.05)
        end
        warn("[BootCamp] Timed out waiting for dialog:", expectedText)
        return false
    end

    task.spawn(function()
        task.wait(5 * 60)
        if rep and rep.Parent and rep:GetAttribute("GameOver") ~= true then
            warn("[BootCamp] Stuck for 5 minutes – returning to lobby.")
            TeleportToLobbyOnce()
        end
    end)

    if not waitForDialogText("Start by placing a scout.", 90) then
        BootCampRunning = false
        return
    end
    log("Scout selection dialog detected")
    pcall(function()
        NetworkMod.Channel("TutorialFlow"):FireServer("PromptShown", "ScoutSelectionPromptShown")
    end)
    task.wait(0.15)
    pressHotbar(1)
    task.wait(0.15)

    local scout = placeUntilExists("Scout", SCOUT_POSITION, 1)
    if not scout then
        warn("[BootCamp] Scout placement failed.")
        BootCampRunning = false
        return
    end

    if not waitForDialogText("Select the sniper tower.", 90) then
        BootCampRunning = false
        return
    end
    log("Sniper selection dialog detected")
    pcall(function()
        NetworkMod.Channel("TutorialFlow"):FireServer("PromptShown", "SniperSelectionPromptShown")
    end)
    task.wait(0.15)
    pressHotbar(2)
    task.wait(0.15)

    local sniper = placeUntilExists("Sniper", SNIPER_POSITION, 2)
    if not sniper then
        warn("[BootCamp] Sniper placement failed.")
        BootCampRunning = false
        return
    end

    log("Scout + Sniper placed. Starting upgrades...")

    local scoutUpgradeDeadline = os.clock() + 45
    while os.clock() < scoutUpgradeDeadline do
        if rep:GetAttribute("AllowedUpgradeTower") == "Scout"
            and rep:GetAttribute("AllowedUpgradeType") == "Upgrade" then
            break
        end
        if rep:GetAttribute("GameOver") == true then
            BootCampRunning = false
            return
        end
        task.wait(0.1)
    end
    pcall(function()
        NetworkMod.Channel("TutorialFlow"):FireServer("PromptShown", "ScoutUpgradePromptShown")
    end)
    task.wait(0.3)
    upgradeUntilSuccess(scout, 1)
    upgradeUntilSuccess(scout, 1)

    local sniperUpgradeDeadline = os.clock() + 45
    while os.clock() < sniperUpgradeDeadline do
        if rep:GetAttribute("AllowedUpgradeTower") == "Sniper"
            and rep:GetAttribute("AllowedUpgradeType") == "Upgrade" then
            break
        end
        if rep:GetAttribute("GameOver") == true then
            BootCampRunning = false
            return
        end
        task.wait(0.1)
    end
    pcall(function()
        NetworkMod.Channel("TutorialFlow"):FireServer("PromptShown", "SniperUpgradePromptShown")
    end)
    task.wait(0.3)
    upgradeUntilSuccess(sniper, 1)
    upgradeUntilSuccess(sniper, 1)

    log("Boot Camp setup complete.")

    task.spawn(function()
        repeat
            task.wait(0.1)
        until not rep.Parent or rep:GetAttribute("GameOver") == true

        if not rep.Parent then
            BootCampRunning = false
            return
        end

        task.wait(3)
        log("Boot Camp finished. Returning to lobby once.")
        TeleportToLobbyOnce()
        BootCampRunning = false
        SetStatus("Boot Camp completed – returned to lobby")
    end)
end

local runningEasy = false
local function RunYeetEasy()
    if runningEasy then return end
    runningEasy = true
    getgenv().TimeScaleEnabled = false
    SetStatus("Starting Easy strategy...")

    if not IsInLobby() then
        while true do
            local availableMaps = GetAvailableMaps()
            local feasibleStrategies = {}

            for _, strategy in ipairs(EasyStrategies) do
                if availableMaps[strategy.mapName] then
                    local reqs = EasyTowerRequirements[strategy.name] or {}
                    local feasible = true

                    for _, req in ipairs(reqs) do
                        local towerName = req[1]
                        local cost = req[2] or 0
                        if not OwnsTower(towerName) then
                            local coins = GetStat("Coins")
                            if coins < cost then
                                feasible = false
                                break
                            end
                        end
                    end

                    if feasible then
                        table.insert(feasibleStrategies, strategy)
                    end
                end
            end

            if #feasibleStrategies > 0 then
                local chosen = feasibleStrategies[math.random(1, #feasibleStrategies)]
                local reqs = EasyTowerRequirements[chosen.name] or {}

                if #reqs > 0 then
                    local buyResult = AutoBuyTowers(reqs)
                    if buyResult ~= "OK" then
                        print("[AutoProgression] Failed to buy towers for " .. chosen.name .. ", skipping.")
                        continue
                    end
                end

                ApplyStrategySettings(chosen)
                task.wait(0.3)
                print("[AutoProgression] Selected Easy: " .. chosen.name .. " on " .. chosen.mapName)
                SetStatus("Loading Easy: " .. chosen.name .. " on " .. chosen.mapName)
                loadstring(game:HttpGet(chosen.url))()
                StartPostMatchLobbyWatcher()
                runningEasy = false
                return
            end

            local vetoInfo = GetVetoInfo()
            if not vetoInfo then
                print("[AutoProgression] Could not read veto text – assuming no vetoes.")
                break
            end
            if vetoInfo.used < vetoInfo.total then
                print("[AutoProgression] Vetoing map (used " .. vetoInfo.used .. "/" .. vetoInfo.total .. ")")
                VetoMap()
            else
                print("[AutoProgression] No vetoes left.")
                break
            end
        end

        print("[AutoProgression] No feasible Easy maps available. Returning to lobby...")
        SetStatus("No Easy maps – teleporting to lobby")
        SmartTeleportToLobby()
    else
        local chosen = nil
        for _, strategy in ipairs(EasyStrategies) do
            local reqs = EasyTowerRequirements[strategy.name] or {}
            local feasible = true
            for _, req in ipairs(reqs) do
                local towerName = req[1]
                local cost = req[2] or 0
                if not OwnsTower(towerName) then
                    local coins = GetStat("Coins")
                    if coins < cost then
                        feasible = false
                        break
                    end
                end
            end
            if feasible then
                chosen = strategy
                break
            end
        end

        if chosen then
            local reqs = EasyTowerRequirements[chosen.name] or {}
            if #reqs > 0 then
                AutoBuyTowers(reqs)
            end
            ApplyStrategySettings(chosen)
            task.wait(0.3)
            print("[AutoProgression] In lobby, selected Easy: " .. chosen.name)
            SetStatus("In lobby – loading Easy: " .. chosen.name)
            loadstring(game:HttpGet(chosen.url))()
            StartPostMatchLobbyWatcher()
        else
            SetStatus("Cannot afford any Easy towers – returning to lobby")
            SmartTeleportToLobby()
        end
        runningEasy = false
    end
end

