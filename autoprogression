-- RUN EASY  (strict difficulty gate: must be "Easy" in-match)
-- ═══════════════════════════════════════════════════════════════
local runningEasy = false
RunYeetEasy = function()
    if runningEasy then return end
    runningEasy = true
    getgenv().TimeScaleEnabled = false
    SetStatus("Starting Easy strategy...")

    local function getDifficulty()
        local sr = ReplicatedStorage:FindFirstChild("StateReplicators")
        local rep = sr and sr:FindFirstChild("GameStateReplicator")
        return rep and rep:GetAttribute("Difficulty") or nil
    end

    if not IsInLobby() then
        -- Wait briefly in case Difficulty hasn't replicated yet
        local diff = getDifficulty()
        local deadline = os.clock() + 5
        while not diff and os.clock() < deadline do
            task.wait(0.1)
            diff = getDifficulty()
        end

        if diff ~= "Easy" then
            print("[AutoProgression] Easy – wrong difficulty (" .. tostring(diff) .. ") – returning to lobby.")
            SetStatus("Easy: wrong difficulty – going to lobby")
            runningEasy = false
            getgenv().SmartTeleportToLobby()
            return
        end

        while true do
            local availableMaps = GetAvailableMaps()
            local feasibleStrategies = {}

            for _, strategy in ipairs(EasyStrategies) do
                if availableMaps[strategy.mapName] then
                    local reqs = EasyTowerRequirements[strategy.name] or {}
                    local feasible = true

                    for _, req in ipairs(reqs) do
                        local towerName = req[1]
                        local cost = req[2] or 0
                        if not OwnsTower(towerName) then
                            local coins = GetStat("Coins")
                            if coins < cost then
                                feasible = false
                                break
                            end
                        end
                    end

                    if feasible then
                        table.insert(feasibleStrategies, strategy)
                    end
                end
            end

            if #feasibleStrategies > 0 then
                table.sort(feasibleStrategies, function(a, b)
                    local pa = a.priority or 0
                    local pb = b.priority or 0
                    if pa ~= pb then
                        return pa > pb
                    end
                    return (EasyStrategyOrder[a.name] or 999) < (EasyStrategyOrder[b.name] or 999)
                end)
                local chosen = feasibleStrategies[1]
                local reqs = EasyTowerRequirements[chosen.name] or {}

                if #reqs > 0 then
                    local buyResult = AutoBuyTowers(reqs)
                    if buyResult ~= "OK" then
                        print("[AutoProgression] Failed to buy towers for " .. chosen.name .. ", skipping.")
                        continue
                    end
                end

                ApplyStrategySettings(chosen)
                task.wait(0.3)
                print("[AutoProgression] Selected Easy: " .. chosen.name .. " on " .. chosen.mapName)
                SetStatus("Loading Easy: " .. chosen.name .. " on " .. chosen.mapName)
                loadstring(game:HttpGet(chosen.url))()
                -- No teleport here – main script watcher will handle it
                runningEasy = false
                return
            end

            local vetoInfo = GetVetoInfo()
            if not vetoInfo then
                print("[AutoProgression] Could not read veto text – assuming no vetoes.")
                break
            end
            if vetoInfo.used < vetoInfo.total then
                print("[AutoProgression] Vetoing map (used " .. vetoInfo.used .. "/" .. vetoInfo.total .. ")")
                VetoMap()
            else
                print("[AutoProgression] No vetoes left.")
                break
            end
        end

        print("[AutoProgression] No feasible Easy maps available. Returning to lobby...")
        SetStatus("No Easy maps – teleporting to lobby")
        runningEasy = false                             -- ← was missing before
        getgenv().SmartTeleportToLobby()
    else
        -- In lobby: prefer strategies that require towers we can afford to buy
        local chosen = nil
        local fallback = nil

        for _, strategy in ipairs(EasyStrategies) do
            local reqs = EasyTowerRequirements[strategy.name] or {}
            local feasible = true
            local needsBuying = false

            for _, req in ipairs(reqs) do
                local towerName = req[1]
                local cost = req[2] or 0
                if not OwnsTower(towerName) then
                    needsBuying = true
                    if GetStat("Coins") < cost then
                        feasible = false
                        break
                    end
                end
            end

            if feasible then
                if needsBuying then
                    chosen = strategy
                    break
                else
                    fallback = strategy
                end
            end
        end

        if not chosen then chosen = fallback end

        if chosen then
            local reqs = EasyTowerRequirements[chosen.name] or {}
            if #reqs > 0 then AutoBuyTowers(reqs) end
            ApplyStrategySettings(chosen)
            task.wait(0.3)
            print("[AutoProgression] In lobby, selected Easy: " .. chosen.name)
            SetStatus("In lobby – loading Easy: " .. chosen.name)
            loadstring(game:HttpGet(chosen.url))()
        else
            SetStatus("Cannot afford any Easy towers – returning to lobby")
            getgenv().SmartTeleportToLobby()
        end
        runningEasy = false
    end
end

