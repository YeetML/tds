local AutoProgressionRunning = false
local AutoProgressionEnabled = false

local function RunAutoProgression()
    if AutoProgressionRunning then return end
    AutoProgressionRunning = true
    task.wait(0.5)

    local stateRep = ReplicatedStorage:FindFirstChild("StateReplicators")
    if stateRep then
        local gameStateRep = stateRep:FindFirstChild("GameStateReplicator")
        if gameStateRep and gameStateRep:GetAttribute("Difficulty") == "Chapter0Mission1" then
            print("[AutoProgression] Auto-detected Boot Camp match. Running Boot Camp automation...")
            SetStatus("Boot Camp detected – running...")
            RunBootCamp()
            AutoProgressionRunning = false
            return
        end
    end

    local forceEasy = _G.AutoProgSettings.ForceEasy or false
    local forceFrost = _G.AutoProgSettings.ForceFrost or false
    local forceHcUnevo = _G.AutoProgSettings.ForceHardcoreUnevo or false
    local forceHcEvo = _G.AutoProgSettings.ForceHardcoreEvo or false
    local forceBootCamp = _G.AutoProgSettings.ForceBootCamp or false

    if forceBootCamp then
        SetStatus("Force mode: Boot Camp")
        RunBootCamp()
        AutoProgressionRunning = false
        return
    elseif forceEasy then
        SetStatus("Force mode: Easy")
        RunYeetEasy()
        AutoProgressionRunning = false
        return
    elseif forceFrost then
        SetStatus("Force mode: Frost")
        local haveRocketeer = OwnsTower("Rocketeer")
        local haveGatling = OwnsTower("Gatling Gun")
        local haveTrapper = OwnsTower("Trapper")
        local haveHacker = OwnsTower("Hacker")
        if haveGatling and haveTrapper and haveHacker and haveRocketeer then
            RunFrostStrategy()
        else
            local result = AutoBuyTowers({
                {"Gatling Gun", 35000, "Coins"},
                {"Trapper", 3000, "Coins"},
                {"Hacker", 5500, "Gems"},
                {"Rocketeer", 2500, "Coins"},
            })
            if result == "OK" then
                RunFrostStrategy()
            elseif result == "Coins" then
                print("[AutoProgression] Not enough Coins for Frost – farming Easy.")
                SetStatus("Not enough Coins for Frost – farming Easy")
                RunYeetEasy()
            elseif result == "Gems" then
                print("[AutoProgression] Not enough Gems for Frost – farming UNEVO.")
                SetStatus("Not enough Gems for Frost – farming UNEVO")
                RunHardcoreUnevo()
            end
        end
        AutoProgressionRunning = false
        return
    elseif forceHcUnevo then
        SetStatus("Force mode: Hardcore UNEVO")
        RunHardcoreUnevo()
        AutoProgressionRunning = false
        return
    elseif forceHcEvo then
        SetStatus("Force mode: Hardcore EVO")
        RunHardcoreEvo()
        AutoProgressionRunning = false
        return
    end

    local level = GetStat("Level")
    local currentDifficulty = (ReplicatedStorage:FindFirstChild("State") and ReplicatedStorage.State:FindFirstChild("Difficulty")) and ReplicatedStorage.State.Difficulty.Value or nil

    if level >= 176 then
        SetStatus("Level " .. level .. " → Frost path")
        local haveRocketeer = OwnsTower("Rocketeer")
        local haveGatling = OwnsTower("Gatling Gun")
        local haveTrapper = OwnsTower("Trapper")
        local haveHacker = OwnsTower("Hacker")
        if haveGatling and haveTrapper and haveHacker and haveRocketeer then
            if IsInLobby() or currentDifficulty == "Frost" then
                RunFrostStrategy()
            else
                print("[AutoProgression] In non-Frost match, teleporting to lobby to run Frost.")
                SetStatus("Not Frost match – teleporting to lobby")
                SmartTeleportToLobby()
            end
        else
            local result = AutoBuyTowers({
                {"Gatling Gun", 35000, "Coins"},
                {"Trapper", 3000, "Coins"},
                {"Hacker", 5500, "Gems"},
                {"Rocketeer", 2500, "Coins"},
            })
            if result == "OK" then
                RunFrostStrategy()
            elseif result == "Coins" then
                if currentDifficulty == "Frost" then
                    print("[AutoProgression] In Frost match but need Coins – teleporting to lobby.")
                    SetStatus("In Frost match, need Coins – teleporting to lobby")
                    SmartTeleportToLobby()
                else
                    print("[AutoProgression] Not enough Coins for Frost – farming Easy.")
                    SetStatus("Not enough Coins for Frost – farming Easy")
                    RunYeetEasy()
                end
            elseif result == "Gems" then
                if currentDifficulty == "Frost" then
                    print("[AutoProgression] In Frost match but need Gems – teleporting to lobby.")
                    SetStatus("In Frost match, need Gems – teleporting to lobby")
                    SmartTeleportToLobby()
                else
                    print("[AutoProgression] Not enough Gems for Frost – farming UNEVO.")
                    SetStatus("Not enough Gems for Frost – farming UNEVO")
                    RunHardcoreUnevo()
                end
            end
        end
    elseif level >= 120 then
        SetStatus("Level " .. level .. " → Hardcore EVO path")
        RunHardcoreEvo()
    elseif level >= 51 then
        SetStatus("Level " .. level .. " → Hardcore UNEVO path")
        RunHardcoreUnevo()
    else
        SetStatus("Level " .. level .. " → Farming Easy")
        RunYeetEasy()
    end
    AutoProgressionRunning = false
end

local function fetchCodesFromBeebom()
    local httpRequest = syn and syn.request or http and http.request or request
    if not httpRequest then
        warn("[CodeRedeemer] No HTTP support – skipping.")
        return {}
    end
    local response = httpRequest({
        Url = "https://beebom.com/tower-defense-simulator-tds-codes/",
        Method = "GET",
        Headers = {
            ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        }
    })
    if response.StatusCode ~= 200 then
        warn("[CodeRedeemer] Failed to fetch page. Status: " .. tostring(response.StatusCode))
        return {}
    end
    local html = response.Body or ""
    local codes = {}
    
    for code in html:gmatch("<strong>([A-Z0-9]+)</strong>") do
        local alreadyExists = false
        for _, existing in ipairs(codes) do
            if existing == code then
                alreadyExists = true
                break
            end
        end
        if not alreadyExists then
            table.insert(codes, code)
        end
    end
    return codes
end

local function redeemCodesFromBeebom()
    print("[CodeRedeemer] Fetching codes from Beebom...")
    SetStatus("Fetching codes from Beebom...")
    local codeList = fetchCodesFromBeebom()
    if #codeList == 0 then
        print("[CodeRedeemer] No codes found.")
        SetStatus("No codes found")
        return
    end
    print("[CodeRedeemer] Found codes: " .. table.concat(codeList, ", "))
    SetStatus("Redeeming " .. #codeList .. " codes...")
    
    for _, code in ipairs(codeList) do
        print("[CodeRedeemer] Redeeming: " .. code)
        SetStatus("Redeeming code: " .. code)
        pcall(function()
            RemoteFunc:InvokeServer("Codes", "Redeem", code)
        end)
        task.wait(0.5)
    end
    
    print("[CodeRedeemer] Done!")
    SetStatus("Code redemption complete")
end

