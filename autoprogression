local function MeetsRequirement(req)
    local towerName = req[1]
    if OwnsTower(towerName) then return true end

    local needCoins, needGems = 0, 0

    if #req == 2 then
        needCoins = tonumber(req[2]) or 0
    elseif #req == 3 then
        local cost = tonumber(req[2]) or 0
        local currency = req[3]
        if currency == "Gems" then needGems = cost else needCoins = cost end
    elseif #req == 5 then
        local cost1, cur1 = tonumber(req[2]) or 0, req[3]
        local cost2, cur2 = tonumber(req[4]) or 0, req[5]
        if cur1 == "Coins" then needCoins = needCoins + cost1
        elseif cur1 == "Gems" then needGems = needGems + cost1 end
        if cur2 == "Coins" then needCoins = needCoins + cost2
        elseif cur2 == "Gems" then needGems = needGems + cost2 end
    elseif type(req[2]) == "table" then
        needCoins = req[2].Coins or 0
        needGems  = req[2].Gems  or 0
    end

    return GetStat("Coins") >= needCoins and GetStat("Gems") >= needGems
end
