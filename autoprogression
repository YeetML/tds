local function APR_WaitForRewardsUI(timeout)
    local deadline = os.clock() + (timeout or 30)
    while os.clock() < deadline do
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            local root = pg:FindFirstChild("ReactGameNewRewards")
            local frame = root and root:FindFirstChild("Frame")
            local go = frame and frame:FindFirstChild("gameOver")
            local rs = go and go:FindFirstChild("RewardsScreen")
            if rs and rs:FindFirstChild("RewardsSection") then
                return true
            end
        end
        task.wait(0.5)
    end
    return false
end

local function APR_RequeueEasy()
    local remote = ReplicatedStorage:WaitForChild("RemoteFunction", 10)
    if not remote then return false end
    local ok, attempts = false, 0
    while not ok and attempts < 30 do
        attempts = attempts + 1
        local success, result = pcall(function()
            return remote:InvokeServer("Multiplayer", "v2:start", {
                difficulty = "Easy",
                mode       = "survival",
                count      = 1,
            })
        end)
        if success and result then
            ok = true
        else
            task.wait(0.5)
        end
    end
    return ok
end

local function APR_TeleportLobby()
    local tp = getgenv().SmartTeleportToLobby
    if type(tp) == "function" then
        pcall(tp)
        return
    end
    pcall(function()
        TeleportService:Teleport(3260590327, LocalPlayer)
    end)
end

local function APR_HandleGameOver()
    if APR_HandlingGameOver then return end
    APR_HandlingGameOver = true

    task.spawn(function()
        APR_WaitForRewardsUI(30)
        task.wait(0.5)

                SetStatus("Sending match results...")
        local sent, reason = APR_SendMatchWebhook()
        if sent then
            print("[AutoProgression] ✅ Webhook sent")
        else
            warn("[AutoProgression] ❌ Webhook skipped: " .. tostring(reason))
        end
        task.wait(0.5) 

        if APR_IsEasySurvival() then
            SetStatus("Easy – requeueing...")
            print("[AutoProgression] Easy match ended, requeueing directly...")
            APR_RequeueEasy()
        else
            SetStatus("Match ended – returning to lobby...")
            print("[AutoProgression] Match ended, teleporting to lobby...")
            APR_TeleportLobby()
        end

        task.wait(0.5)
        APR_HandlingGameOver = false
    end)
end

local function APR_StartMatchWatcher()
    task.spawn(function()
        local wasGameOver = false
        while true do
            local rep = APR_GetGameStateReplicator()
            if rep then
                local isGameOver = rep:GetAttribute("GameOver") == true
                if isGameOver and not wasGameOver then
                    APR_HandleGameOver()
                end
                wasGameOver = isGameOver
            else
                wasGameOver = false
            end
            task.wait(1)
        end
    end)
end

