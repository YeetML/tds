-- ===== NEW: cross-script guards so hardcoreevo/hardcoreunevo can't be double-loaded =====
-- These are read/written from within the loaded hardcoreevo/hardcoreunevo scripts too,
-- so a running match loop is visible here even though RunHardcoreEvo() itself returns fast.
getgenv().HcEvoActive = getgenv().HcEvoActive or false
getgenv().HcUnevoActive = getgenv().HcUnevoActive or false

-- NEW: AutoUpgradeSelected / AutoUpgradeAll are never persisted and always default to false on
-- every load, regardless of whatever they were last set to (manually, or by a previous session).
-- Force them off right here at boot, before anything else can read them.
getgenv().AutoUpgradeSelected = false
getgenv().AutoUpgradeAll = false
if Globals then
    Globals.AutoUpgradeSelected = false
    Globals.AutoUpgradeAll = false
end

-- Default settings (only Easy, Frost, HC Unevo, HC Evo)
_G.AutoProgSettings = _G.AutoProgSettings or {
    AutoProgressionEnabled = false,
    ForceEasy = false,
    ForceFrost = false,
    ForceHardcoreUnevo = false,
    ForceHardcoreEvo = false,
    __locked = false,
}

