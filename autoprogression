getgenv().RunHardcoreEvo = RunHardcoreEvo
getgenv().RunPizzaParty = RunPizzaParty
getgenv().RunBootCamp = RunBootCamp
getgenv().RunFallenStrategy = RunFallenStrategy

task.spawn(function()
    task.wait(1)
    redeemCodesFromBeebom()
end)

task.spawn(function()
    while task.wait(1) do 
        if IsInLobby() then
            pcall(ClaimAchievements)
        end
    end
end)

task.spawn(function()
    while true do
        ScrubForeignSettings()    

        if _G.AutoProgSettings.__locked then
            for key, value in pairs(_G.AutoProgSettings) do
                if key ~= "__locked" then
                    if Globals[key] ~= value then
                        Globals[key] = value
                        print("[AutoProg Lock] Forced " .. key .. " = " .. tostring(value))
                    end
                end
            end
        end
        task.wait(1)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        local lvl = GetStat("Level")
        if lvl >= 51 and IsInLobby() and not SkillBuyingRunning then
            task.spawn(RunSkillPurchases)
        end
    end
end)

getgenv().RunSkillPurchases   = RunSkillPurchases
getgenv().SkillBuyingRunning  = function() return SkillBuyingRunning end

APR_StartMatchWatcher()
