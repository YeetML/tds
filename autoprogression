            for _, m in ipairs(MODE_REGISTRY) do sd[m.key] = _G.AutoProgSettings[m.key] end
            sd.__theme = Apex.GetTheme().Name
            pcall(function() writefile(SETTINGS_FILE, HttpService:JSONEncode(sd)) end)
        end
