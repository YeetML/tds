local function APR_GetAllRewards()
    local results = {
        Coins = 0, Gems = 0, XP = 0, Wave = 0,
        Level = 0, Time = "00:00", Status = "UNKNOWN", Others = {}
    }

    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local UiRoot = PlayerGui and PlayerGui:FindFirstChild("ReactGameNewRewards")
    local MainFrame = UiRoot and UiRoot:FindFirstChild("Frame")
    local GameOver = MainFrame and MainFrame:FindFirstChild("gameOver")
    local RewardsScreen = GameOver and GameOver:FindFirstChild("RewardsScreen")

    -- Time completed
    local GameStats = RewardsScreen and RewardsScreen:FindFirstChild("gameStats")
    local StatsList = GameStats and GameStats:FindFirstChild("stats")
    if StatsList then
        for _, frame in ipairs(StatsList:GetChildren()) do
            local l1 = frame:FindFirstChild("textLabel")
            local l2 = frame:FindFirstChild("textLabel2")
            local refLabel = l2 and l2:FindFirstChild("refLabel")
            if l1 and refLabel and l1.Text:find("Time Completed:") then
                results.Time = refLabel.Text
                break
            end
        end
    end

    -- Win/Loss banner
    local TopBanner = RewardsScreen and RewardsScreen:FindFirstChild("RewardBanner")
    if TopBanner and TopBanner:FindFirstChild("textLabel") then
        local txt = TopBanner.textLabel.Text:upper()
        results.Status = txt:find("TRIUMPH") and "WIN"
                      or (txt:find("LOST") and "LOSS" or "UNKNOWN")
    end

    -- Level
    local lvlObj = LocalPlayer:FindFirstChild("Level")
    if lvlObj then results.Level = lvlObj.Value or 0 end

    -- Wave
    pcall(function()
        local label = PlayerGui.ReactGameTopGameDisplay.Frame.wave.container.value
        local waveNum = label.Text:match("^(%d+)")
        if waveNum then results.Wave = tonumber(waveNum) or 0 end
    end)

    -- Rewards section
    local SectionRewards = RewardsScreen and RewardsScreen:FindFirstChild("RewardsSection")
    if SectionRewards then
        for _, item in ipairs(SectionRewards:GetChildren()) do
            if tonumber(item.Name) then
                local IconId = "0"
                local img = item:FindFirstChildWhichIsA("ImageLabel", true)
                if img then IconId = img.Image:match("%d+") or "0" end

                for _, child in ipairs(item:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        local text = child.Text
                        local amt = tonumber(text:match("(%d+)")) or 0
                        if text:find("Coins") then
                            results.Coins = amt
                        elseif text:find("Gems") then
                            results.Gems = amt
                        elseif text:find("XP") then
                            results.XP = amt
                        elseif text:lower():find("x%d+") then
                            local displayName = APR_ItemNames[IconId] or ("Unknown Item (" .. IconId .. ")")
                            table.insert(results.Others, {
                                Amount = text:match("x%d+"),
                                Name   = displayName
                            })
                        end
                    end
                end
            end
        end
    end

    return results
end

local function APR_SendMatchWebhook()
    local MainGlobals = getgenv().Globals or _G.Globals or getgenv()
    if not MainGlobals then return false, "no Globals" end
    if not MainGlobals.SendWebhook then return false, "SendWebhook off" end
    if not MainGlobals.WebhookURL or MainGlobals.WebhookURL == "" then
        return false, "no WebhookURL"
    end

    local httpRequest = syn and syn.request
        or http and http.request
        or http_request
        or request
    if not httpRequest then return false, "no HTTP" end

    local match = APR_GetAllRewards()
    APR_SessionCoins = APR_SessionCoins + match.Coins
    APR_SessionGems  = APR_SessionGems  + match.Gems

    local BonusString = ""
    if #match.Others > 0 then
        for _, res in ipairs(match.Others) do
            BonusString = BonusString .. "🎁 **" .. res.Amount .. " " .. res.Name .. "**\n"
        end
    else
        BonusString = "_No bonus rewards found._"
    end

    local PostData = {
        username = "TDS AutoStrat",
        embeds = {{
            title = (match.Status == "WIN" and "🏆 TRIUMPH" or "💀 DEFEAT"),
            color = (match.Status == "WIN" and 0x2ecc71 or 0xe74c3c),
            description =
                "### 📋 Match Overview\n" ..
                "> **Status:** `" .. match.Status .. "`\n" ..
                "> **Time:** `" .. match.Time .. "`\n" ..
                "> **Current Level:** `" .. match.Level .. "`\n" ..
                "> **Wave:** `" .. match.Wave .. "`\n",
            fields = {
                {
                    name = "✨ Rewards",
                    value = "```ansi\n\27[2;33mCoins:\27[0m +" .. match.Coins ..
                            "\n\27[2;34mGems: \27[0m +" .. match.Gems ..
                            "\n\27[2;32mXP:   \27[0m +" .. match.XP .. "```",
                    inline = false
                },
                { name = "🎁 Bonus Items", value = BonusString, inline = true },
                { name = "📊 Session Totals",
                  value = "```py\n# Total Amount\nCoins: " .. APR_SessionCoins ..
                          "\nGems:  " .. APR_SessionGems .. "```",
                  inline = true }
            },
            footer = { text = "Logged for " .. LocalPlayer.Name .. " • TDS AutoStrat" },
            timestamp = DateTime.now():ToIsoDate()
        }}
    }

    local ok, err = pcall(function()
        httpRequest({
            Url = MainGlobals.WebhookURL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(PostData)
        })
    end)

    if ok then
        print("[AutoProgression] ✅ Webhook sent")
        return true
    else
        warn("[AutoProgression] Webhook failed: " .. tostring(err))
        return false
    end
end
getgenv().APR_SendMatchWebhook = APR_SendMatchWebhook

local function AutoBuyTowers(towerList)
    print("[AutoProgression] Checking towers to buy...")
    SetStatus("Checking towers to buy...")

    if not OwnsTower("Demoman") then
        local coins = GetStat("Coins")
        if coins >= 200 then
            print("[AutoProgression] Priority: Buying Demoman (200 Coins)")
            SetStatus("Priority: Buying Demoman")
            BuyTower("Demoman")
            task.wait(0.5)
        else
            print("[AutoProgression] Priority: Not enough Coins for Demoman (need 200, have " .. coins .. ")")
            SetStatus("Not enough Coins for Demoman")
        end
    else
        print("[AutoProgression] Already own Demoman")
    end

    local function parseTowerData(data)
        local name = data[1]
        local requiredCoins = 0
        local requiredGems = 0
        if #data == 2 then
            requiredCoins = data[2]
        elseif #data == 3 then
            local cost = data[2]
            local currency = data[3]
            if currency == "Gems" then requiredGems = cost else requiredCoins = cost end
        elseif #data == 5 then
            local cost1 = data[2]; local cur1 = data[3]
            local cost2 = data[4]; local cur2 = data[5]
            if cur1 == "Coins" then requiredCoins = cost1 elseif cur1 == "Gems" then requiredGems = cost1 end
            if cur2 == "Coins" then requiredCoins = cost2 elseif cur2 == "Gems" then requiredGems = cost2 end
        elseif type(data[2]) == "table" then
            local costTable = data[2]
            requiredCoins = costTable.Coins or 0
            requiredGems = costTable.Gems or 0
        else
            warn("[AutoProgression] Unknown format for tower: " .. name)
        end
        return name, requiredCoins, requiredGems
    end

    for _, towerData in ipairs(towerList) do
        local towerName, needCoins, needGems = parseTowerData(towerData)
        local hasCoins = GetStat("Coins") >= needCoins
        local hasGems  = GetStat("Gems")  >= needGems

        if not OwnsTower(towerName) then
            if not hasCoins then
                print("[AutoProgression] Not enough Coins for " .. towerName)
                SetStatus("Not enough Coins for " .. towerName)
                return "Coins"
            end
            if not hasGems then
                print("[AutoProgression] Not enough Gems for " .. towerName)
                SetStatus("Not enough Gems for " .. towerName)
                return "Gems"
            end

            local msg = ("[AutoProgression] Buying %s"):format(towerName)
            if needCoins > 0 and needGems > 0 then
                msg = msg .. (" (need %d Coins + %d Gems)"):format(needCoins, needGems)
            elseif needCoins > 0 then
                msg = msg .. (" (need %d Coins)"):format(needCoins)
            elseif needGems > 0 then
                msg = msg .. (" (need %d Gems)"):format(needGems)
            end
            print(msg)
            SetStatus(msg)
            BuyTower(towerName)
            task.wait(1)
        else
            print("[AutoProgression] Already own " .. towerName)
            SetStatus("Already own " .. towerName)
        end
    end

    return "OK"
end

