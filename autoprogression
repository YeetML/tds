-- ===== MAIN AUTO PROGRESSION LOGIC (with force overrides) =====
local function RunAutoProgression()
    if AutoProgressionRunning then return end
    AutoProgressionRunning = true
    task.wait(0.5)

    -- Gather base info for logging
    local level = GetStat("Level")
    local currentDifficulty = (ReplicatedStorage:FindFirstChild("State") and ReplicatedStorage.State:FindFirstChild("Difficulty")) and ReplicatedStorage.State.Difficulty.Value or nil
    local inLobby = IsInLobby()
    local forceEasy = _G.AutoProgSettings.ForceEasy or false
    local forceFrost = _G.AutoProgSettings.ForceFrost or false
    local forceHcUnevo = _G.AutoProgSettings.ForceHardcoreUnevo or false
    local forceHcEvo = _G.AutoProgSettings.ForceHardcoreEvo or false

    -- Prepare log entry (will be filled as we go)
    local logEntry = {
        timestamp = os.time(),
        level = level,
        currentDifficulty = currentDifficulty,
        inLobby = inLobby,
        forceEasy = forceEasy,
        forceFrost = forceFrost,
        forceHcUnevo = forceHcUnevo,
        forceHcEvo = forceHcEvo,
        haveRocketeer = nil,
        haveGatling = nil,
        haveTrapper = nil,
        haveHacker = nil,
        autoBuyResult = nil,
        decision = "unknown",
        details = "",
    }

    -- Helper to log before returning
    local function logAndReturn(decision, details)
        logEntry.decision = decision
        logEntry.details = details or ""
        LogDecision(logEntry)
        AutoProgressionRunning = false
    end

    -- Check force toggles
    if forceEasy then
        SetStatus("Force mode: Easy")
        logAndReturn("Force Easy", "User forced Easy mode")
        RunYeetEasy()
        return
    elseif forceFrost then
        SetStatus("Force mode: Frost")
        local haveRocketeer = OwnsTower("Rocketeer")
        local haveGatling = OwnsTower("Gatling Gun")
        local haveTrapper = OwnsTower("Trapper")
        local haveHacker = OwnsTower("Hacker")
        logEntry.haveRocketeer = haveRocketeer
        logEntry.haveGatling = haveGatling
        logEntry.haveTrapper = haveTrapper
        logEntry.haveHacker = haveHacker

        if haveGatling and haveTrapper and haveHacker and haveRocketeer then
            logAndReturn("Force Frost (all towers owned)", "All Frost towers owned")
            RunFrostStrategy()
        else
            local result = AutoBuyTowers({
                {"Gatling Gun", 35000, "Coins"},
                {"Trapper", 3000, "Coins"},
                {"Hacker", 5500, "Gems"},
                {"Rocketeer", 2500, "Coins"},
            })
            logEntry.autoBuyResult = result
            if result == "OK" then
                logAndReturn("Force Frost (bought missing towers)", "AutoBuy OK")
                RunFrostStrategy()
            elseif result == "Coins" then
                logAndReturn("Force Frost fallback -> Easy", "Need coins for Frost")
                RunYeetEasy()
            elseif result == "Gems" then
                logAndReturn("Force Frost fallback -> UNEVO", "Need gems for Frost")
                RunHardcoreUnevo()
            end
        end
        return
    elseif forceHcUnevo then
        SetStatus("Force mode: Hardcore UNEVO")
        logAndReturn("Force Hardcore UNEVO", "")
        RunHardcoreUnevo()
        return
    elseif forceHcEvo then
        SetStatus("Force mode: Hardcore EVO")
        logAndReturn("Force Hardcore EVO", "")
        RunHardcoreEvo()
        return
    end

    -- No force – use level‑based logic
    if level >= 176 then
        SetStatus("Level " .. level .. " → Frost path")
        local haveRocketeer = OwnsTower("Rocketeer")
        local haveGatling = OwnsTower("Gatling Gun")
        local haveTrapper = OwnsTower("Trapper")
        local haveHacker = OwnsTower("Hacker")
        logEntry.haveRocketeer = haveRocketeer
        logEntry.haveGatling = haveGatling
        logEntry.haveTrapper = haveTrapper
        logEntry.haveHacker = haveHacker

        if haveGatling and haveTrapper and haveHacker and haveRocketeer then
            -- All towers owned – decide whether to run Frost now or teleport to lobby
            if inLobby or currentDifficulty == "Frost" then
                logAndReturn("Frost (all towers owned)", "In lobby or Frost match")
                RunFrostStrategy()
            else
                logAndReturn("Teleport to lobby for Frost", "In non-Frost match, need lobby")
                SmartTeleportToLobby()
            end
        else
            -- Missing some towers – try to buy them
            local result = AutoBuyTowers({
                {"Gatling Gun", 35000, "Coins"},
                {"Trapper", 3000, "Coins"},
                {"Hacker", 5500, "Gems"},
                {"Rocketeer", 2500, "Coins"},
            })
            logEntry.autoBuyResult = result
            if result == "OK" then
                logAndReturn("Frost (bought missing towers)", "AutoBuy OK")
                RunFrostStrategy()
            elseif result == "Coins" then
                -- Teleport if we're in Easy or Frost match (we don't want to farm Easy while in a match)
                if currentDifficulty == "Frost" or currentDifficulty == "Easy" then
                    logAndReturn("Teleport to lobby for Frost (need coins)", "In Easy/Frost match, need coins")
                    SmartTeleportToLobby()
                else
                    logAndReturn("Fallback to Easy (need coins)", "Not enough coins for Frost")
                    RunYeetEasy()
                end
            elseif result == "Gems" then
                if currentDifficulty == "Frost" or currentDifficulty == "Easy" then
                    logAndReturn("Teleport to lobby for Frost (need gems)", "In Easy/Frost match, need gems")
                    SmartTeleportToLobby()
                else
                    logAndReturn("Fallback to UNEVO (need gems)", "Not enough gems for Frost")
                    RunHardcoreUnevo()
                end
            end
        end

    elseif level >= 120 then
        SetStatus("Level " .. level .. " → Hardcore EVO path")
        logAndReturn("Hardcore EVO", "Level >= 120")
        RunHardcoreEvo()
    elseif level >= 51 then
        SetStatus("Level " .. level .. " → Hardcore UNEVO path")
        logAndReturn("Hardcore UNEVO", "Level between 51 and 119")
        RunHardcoreUnevo()
    else
        SetStatus("Level " .. level .. " → Farming Easy")
        logAndReturn("Easy farm", "Level < 51")
        RunYeetEasy()
    end

    AutoProgressionRunning = false
end

-- ===== CODE REDEEMER (from Beebom) =====
local function fetchCodesFromBeebom()
    local httpRequest = syn and syn.request or http and http.request or request
    if not httpRequest then
        warn("[CodeRedeemer] No HTTP support – skipping.")
        return {}
    end

    local response = httpRequest({
        Url = "https://beebom.com/tower-defense-simulator-tds-codes/",
        Method = "GET",
        Headers = {
            ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        }
    })

    if response.StatusCode ~= 200 then
        warn("[CodeRedeemer] Failed to fetch page. Status: " .. tostring(response.StatusCode))
        return {}
    end

    local html = response.Body or ""
    local codes = {}
    
    for code in html:gmatch("<strong>([A-Z0-9]+)</strong>") do
        local alreadyExists = false
        for _, existing in ipairs(codes) do
            if existing == code then
                alreadyExists = true
                break
            end
        end
        if not alreadyExists then
            table.insert(codes, code)
        end
    end

    return codes
end

local function redeemCodesFromBeebom()
    print("[CodeRedeemer] Fetching codes from Beebom...")
    SetStatus("Fetching codes from Beebom...")
    local codeList = fetchCodesFromBeebom()
    if #codeList == 0 then
        print("[CodeRedeemer] No codes found.")
        SetStatus("No codes found")
        return
    end

    print("[CodeRedeemer] Found codes: " .. table.concat(codeList, ", "))
    SetStatus("Redeeming " .. #codeList .. " codes...")
    
    for _, code in ipairs(codeList) do
        print("[CodeRedeemer] Redeeming: " .. code)
        SetStatus("Redeeming code: " .. code)
        pcall(function()
            RemoteFunc:InvokeServer("Codes", "Redeem", code)
        end)
        task.wait(0.5)
    end
    
    print("[CodeRedeemer] Done!")
    SetStatus("Code redemption complete")
end

